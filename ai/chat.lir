// Runtime inference: classifier + prompt-conditioned byte-response weights.
// Training rows/examples are not opened by this process.
import "src/noema_text.lir"
import "src/noema_fit.lir"
import "src/ledger.lir"
import "src/noema_decoder.lir"
import "src/noema_chat.lir"
fn main() -> i64 {
    let input = @malloc(4097)
    let length = @read(0, input, 4097)
    if length <= 0 or length > 4096 { println("INPUT_EMPTY_OR_TOO_LONG") return 1 }
    var prompt_len = length
    while prompt_len > 0 {
        let ch = @read_u8(@ptr_add(input, prompt_len - 1)) as i64
        if ch == 10 or ch == 13 { prompt_len = prompt_len - 1 } else { break }
    }
    if prompt_len <= 0 { println("EMPTY_INPUT") return 1 }
    let operation = noema_chat_math_operation(input, prompt_len)
    if operation != 0 {
        let result = noema_chat_arithmetic(input, prompt_len)
        if result >= 0 { print("= ") printInt(result) println("") }
        else { println("UNSUPPORTED_OR_AMBIGUOUS_EXPRESSION") }
        return 0
    }
    let model = block_new(128, 4, 128, 1729)
    if sel_checkpoint_load(model, "ai/noema-training/turkish_model.selcp") != 1 { println("CLASSIFIER_WEIGHTS_INVALID") return 1 }
    let features = @malloc(128 * 8)
    if noema_text_encode_prompt(prompt_len, input, 128, features) <= 0 { println("INPUT_HAS_NO_ENCODABLE_FEATURES") return 1 }
    forward(model, features)
    var label: i64 = 0
    var best = 0 - 9223372036854775807
    var i: i64 = 0
    while i < 4 {
        let score = @read_u64(@ptr_add(model.out, i * 8)) as i64
        if score > best { best = score label = i }
        i = i + 1
    }
    let decoder = @malloc(DECODER_CELLS * 8)
    if noema_decoder_load(decoder, "ai/noema-training/turkish_decoder.seltok") != 1 { println("RESPONSE_WEIGHTS_INVALID") return 1 }
    let output = @malloc(DECODER_MAX_OUTPUT)
    let output_len = noema_decoder_generate(decoder, label, features, 128, output, DECODER_MAX_OUTPUT)
    if output_len <= 0 { println("NO_CONDITIONAL_OUTPUT") return 0 }
    @write(1, output, output_len)
    println("")
    return 0
}

// Direct NOEMA-Phi raw-byte pretraining example; no tokenizer, JSONL parser,
// bag-of-words encoder, supervised classifier, or gradient optimizer.
// Run at repository root: ./zig-out/bin/lir run ai/train_text_example.lir --backend=native
import "src/noema_pretrain.lir"
fn main() -> i64 {
    let state = noema_pretrain_create(64, 8, 32, 1729)
    let corpus = ["Gün doğdu; deniz üzerinde ışık yayıldı.", "Bir dalga kıyıya ulaştı ve geri çekildi.", "Trabzon'da yağmur başladı, sokaklar ıslandı."]
    var i: i64 = 0
    while i < 96 {
        let row = i % 3
        let text = corpus[row]
        let bytes = text as *u8
        let reset = if row == 0 { 0 } else { 1 }
        noema_pretrain_document(state,bytes,text.len as i64,reset,6)
        i = i + 1
    }
    print("raw-byte documents: ") printInt(noema_pretrain_documents(state))
    print(" spectral stage: ") printInt(noema_pretrain_stage(state))
    print(" gate mean: ") printFloat(noema_pretrain_gate_mean(state)) println("")
    noema_pretrain_destroy(state)
    return 0
}

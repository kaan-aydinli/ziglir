// Compatibility filename only. The non-compliant autoregressive Transformer
// chat path has been removed; NOEMA-Phi v3 pretraining does not generate text.
// This executable consumes a raw message as bytes and reports field telemetry.
import "src/noema_pretrain.lir"
fn main() -> i64 {
    let state = noema_pretrain_create(64,8,32,20261124)
    let input = @malloc(4096) as *u8
    let n = @read(0,input,4096)
    if n <= 0 {
        println("NO_RAW_INPUT; pipe one UTF-8 message on stdin")
        noema_pretrain_destroy(state)
        @free(input)
        return 1
    }
    noema_pretrain_document(state,input,n,0,4)
    println("NOEMA-Phi pretraining observation (no generated reply/inference head)")
    print("raw bytes: ") printInt(n)
    print(" free-energy gate: ") printFloat(noema_pretrain_gate_mean(state)) println("")
    noema_pretrain_destroy(state)
    @free(input)
    return 0
}

// Train and report on the LIR-encoded labels/features for the repository's
// 11-record example set. From repository root: lir run ai/train_example.lir.
import "src/noema_csv.lir"
import "src/noema_fit.lir"
fn print_inline(value: i64) {
    let buf = @malloc(32)
    var n = value
    var len: i64 = 0
    if n == 0 { @write_u8(buf, 48 as u8) len = 1 }
    else {
        if n < 0 { @write_u8(buf, 45 as u8) len = 1 n = 0 - n }
        let start = len
        while n > 0 {
            @write_u8(@ptr_add(buf, len), (48 + (n % 10)) as u8)
            len = len + 1
            n = n / 10
        }
        var lo = start
        var hi = len - 1
        while lo < hi {
            let a = @read_u8(@ptr_add(buf, lo))
            let b = @read_u8(@ptr_add(buf, hi))
            @write_u8(@ptr_add(buf, lo), b)
            @write_u8(@ptr_add(buf, hi), a)
            lo = lo + 1
            hi = hi - 1
        }
    }
    @write(1, buf, len)
}
fn print_confusion(name: string, matrix: *u8) {
    print(name)
    var r: i64 = 0
    while r < 4 {
        var c: i64 = 0
        while c < 4 {
            print_inline(@read_u64(@ptr_add(matrix, (r * 4 + c) * 8)) as i64)
            if c < 3 { print(",") }
            c = c + 1
        }
        println("")
        r = r + 1
    }
}
fn main() -> i64 {
    let fd = @open("ai/noema-training/example_training.csv", 0, 0)
    if fd < 0 { println("ERROR: cannot open example_training.csv") return 1 }
    let bytes = @malloc(4096)
    let nbytes = @read(fd, bytes, 4096)
    @close(fd)
    if nbytes <= 0 or nbytes >= 4096 { println("ERROR: invalid/oversized dataset file") return 1 }

    let features = @malloc(11 * 4 * 8)
    let targets = @malloc(11 * 4 * 8)
    let splits = @malloc(11 * 8)
    let history = @malloc(200 * 8)
    let metric = @malloc(8)
    let rows = noema_csv_decode(nbytes, bytes, 4, 4, 11, features, targets, splits)
    if rows != 11 { println("ERROR: CSV rejected or record count mismatch") return 1 }

    let model = block_new(4, 4, 4, 1729)
    let epochs = noema_fit(model, rows, features, targets, splits, ONE / 16, 200, history)
    if epochs != 200 { println("ERROR: fit failed") return 1 }

    var train_rows: i64 = 0
    var dev_rows: i64 = 0
    var test_rows: i64 = 0
    var i: i64 = 0
    while i < rows {
        let split = @read_u64(@ptr_add(splits, i * 8)) as i64
        if split == FIT_TRAIN { train_rows = train_rows + 1 }
        if split == FIT_DEV { dev_rows = dev_rows + 1 }
        if split == FIT_TEST { test_rows = test_rows + 1 }
        i = i + 1
    }

    let train_conf = @malloc(16 * 8)
    let dev_conf = @malloc(16 * 8)
    let test_conf = @malloc(16 * 8)
    let train_eval = noema_confusion_split(model, rows, features, targets, splits, FIT_TRAIN, train_conf)
    let dev_eval = noema_confusion_split(model, rows, features, targets, splits, FIT_DEV, dev_conf)
    let test_eval = noema_confusion_split(model, rows, features, targets, splits, FIT_TEST, test_conf)
    let dev_loss_rows = noema_evaluate_split(model, rows, features, targets, splits, FIT_DEV, metric)
    let dev_loss = @read_u64(metric) as i64
    let test_loss_rows = noema_evaluate_split(model, rows, features, targets, splits, FIT_TEST, metric)
    let test_loss = @read_u64(metric) as i64

    println("NOEMA LIR example training report")
    print("rows train/dev/test: ") print_inline(train_rows) print("/") print_inline(dev_rows) print("/") print_inline(test_rows) println("")
    print("epochs: ") print_inline(epochs) print("; eta Q32.32: ") print_inline(ONE / 16) println("")
    print("train MSE Q32.32 raw first/final: ") print_inline(@read_u64(history) as i64) print("/") print_inline(@read_u64(@ptr_add(history, (epochs - 1) * 8)) as i64) println("")
    print("dev MSE Q32.32 raw: ") print_inline(dev_loss) print(" (n=") print_inline(dev_loss_rows) println(")")
    print("test MSE Q32.32 raw: ") print_inline(test_loss) print(" (n=") print_inline(test_loss_rows) println(")")
    print("train correct/total: ") print_inline(@read_u64(@ptr_add(train_conf, 0)) as i64 + @read_u64(@ptr_add(train_conf, 40)) as i64 + @read_u64(@ptr_add(train_conf, 80)) as i64 + @read_u64(@ptr_add(train_conf, 120)) as i64) print("/") print_inline(train_eval) println("")
    print("dev correct/total: ") print_inline(@read_u64(@ptr_add(dev_conf, 0)) as i64 + @read_u64(@ptr_add(dev_conf, 40)) as i64 + @read_u64(@ptr_add(dev_conf, 80)) as i64 + @read_u64(@ptr_add(dev_conf, 120)) as i64) print("/") print_inline(dev_eval) println("")
    print("test correct/total: ") print_inline(@read_u64(@ptr_add(test_conf, 0)) as i64 + @read_u64(@ptr_add(test_conf, 40)) as i64 + @read_u64(@ptr_add(test_conf, 80)) as i64 + @read_u64(@ptr_add(test_conf, 120)) as i64) print("/") print_inline(test_eval) println("")
    println("confusion rows=actual, columns=predicted; classes=answer/ask/tool/abstain")
    print_confusion("train:\n", train_conf)
    print_confusion("dev:\n", dev_conf)
    print_confusion("test:\n", test_conf)
    return 0
}

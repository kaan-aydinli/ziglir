// NOEMA Stage 18: strict bounded integer-CSV ingestion into Q32.32 arrays.
// Format per row: split,feature_0..feature_n,target_0..target_m; split=0/1/2.
// No header, quoting, JSON, text tokenization, or automatic target extraction.
import "fixed.lir"
const CSV_INVALID: i64 = -1
const CSV_MAX_ROWS: i64 = 4096
const CSV_MAX_DIM: i64 = 256

/// Parse one signed base-10 integer cell. `cursor` is a one-cell u64 pointer;
/// returns delimiter 0=EOF, 1=comma, 2=line ending, -1=invalid. Accepts CRLF.
fn csv_parse_cell(bytes: *u8, length: i64, cursor: *u8, value_out: *u8) -> i64 {
    var pos = @read_u64(cursor) as i64
    if pos < 0 or pos >= length { return -1 }
    var sign: i64 = 1
    let first = @read_u8(@ptr_add(bytes, pos)) as i64
    if first == 45 { sign = -1 pos = pos + 1 }
    else if first == 43 { pos = pos + 1 }
    if pos >= length { return -1 }
    var value: i64 = 0
    var digits: i64 = 0
    while pos < length {
        let ch = @read_u8(@ptr_add(bytes, pos)) as i64
        if ch >= 48 and ch <= 57 {
            let digit = ch - 48
            if value > 214748364 or (value == 214748364 and digit > 7) { return -1 }
            value = value * 10 + digit
            digits = digits + 1
            pos = pos + 1
        } else { break }
    }
    if digits == 0 { return -1 }
    if pos >= length { @write_u64(cursor, pos as u64) @write_u64(value_out, (value * sign) as u64) return 0 }
    let ch = @read_u8(@ptr_add(bytes, pos)) as i64
    var delimiter: i64 = -1
    if ch == 44 { delimiter = 1 pos = pos + 1 }
    else if ch == 10 { delimiter = 2 pos = pos + 1 }
    else if ch == 13 {
        pos = pos + 1
        if pos < length and (@read_u8(@ptr_add(bytes, pos)) as i64) == 10 { pos = pos + 1 }
        delimiter = 2
    }
    if delimiter < 0 { return -1 }
    @write_u64(cursor, pos as u64)
    @write_u64(value_out, (value * sign) as u64)
    return delimiter
}

/// Decode strict rectangular integer CSV to contiguous split/features/targets.
/// All numeric feature/target cells become exact Q32.32 integer values.
fn noema_csv_decode(length: i64, bytes: *u8, nin: i64, nout: i64, row_capacity: i64, features: *u8, targets: *u8, splits: *u8) -> i64 {
    if length < 0 or nin <= 0 or nin > CSV_MAX_DIM or nout <= 0 or nout > CSV_MAX_DIM { return CSV_INVALID }
    if row_capacity <= 0 or row_capacity > CSV_MAX_ROWS { return CSV_INVALID }
    var cursor: i64 = 0
    var rows: i64 = 0
    var done = 0
    let value = @malloc(8)
    let cursor_cell = @malloc(8)
    while done == 0 {
        if rows >= row_capacity { return CSV_INVALID }
        @write_u64(cursor_cell, cursor as u64)
        let split_delim = csv_parse_cell(bytes, length, cursor_cell, value)
        if split_delim < 0 { return CSV_INVALID }
        let split = @read_u64(value) as i64
        if split < 0 or split > 2 { return CSV_INVALID }
        cursor = @read_u64(cursor_cell) as i64
        if nin + nout == 0 { return CSV_INVALID }
        var col: i64 = 0
        while col < nin {
            if split_delim == 0 { return CSV_INVALID }
            if col == 0 and split_delim != 1 { return CSV_INVALID }
            @write_u64(cursor_cell, cursor as u64)
            let delim = csv_parse_cell(bytes, length, cursor_cell, value)
            if delim < 0 { return CSV_INVALID }
            let parsed = @read_u64(value) as i64
            if col + 1 < nin + nout and delim != 1 { return CSV_INVALID }
            @write_u64(@ptr_add(features, (rows * nin + col) * 8), from_int(parsed) as u64)
            cursor = @read_u64(cursor_cell) as i64
            col = col + 1
        }
        var out: i64 = 0
        while out < nout {
            @write_u64(cursor_cell, cursor as u64)
            let delim = csv_parse_cell(bytes, length, cursor_cell, value)
            if delim < 0 { return CSV_INVALID }
            let parsed = @read_u64(value) as i64
            if out + 1 < nout and delim != 1 { return CSV_INVALID }
            if out + 1 == nout and delim == 1 { return CSV_INVALID }
            @write_u64(@ptr_add(targets, (rows * nout + out) * 8), from_int(parsed) as u64)
            cursor = @read_u64(cursor_cell) as i64
            if out + 1 == nout {
                if delim == 0 { done = 1 }
                else if delim == 2 { if cursor == length { done = 1 } }
            }
            out = out + 1
        }
        @write_u64(@ptr_add(splits, rows * 8), split as u64)
        rows = rows + 1
    }
    return rows
}

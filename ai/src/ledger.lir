// SEL — Sparse Eikonal Ledger
// ledger.lir — seyrek katman çekirdeği ve eikonal güncelleme.
//
// Bir "SEL bloğu" iki şeyden oluşur:
//   1. seyrek doğrusal katman: her çıktı nöronu yalnız K girdiye bağlı
//   2. eikonal güncelleme: her kenar kendi varış zamanını (tau) taşır
//
// Bellek düzeni (tek bir @malloc bloğu, 8 baytlık hücreler):
//   Edge tablosu nout x K kaydı, her kayıt 4 i64:
//     [0] idx   — hangi girdi nöronu
//     [1] w     — Q32.32 ağırlık
//     [2] tau   — birikmiş varış zamanı (Q32.32)
//     [3] hits  — güncelleme sayısı
//   Bias tablosu nout kaydı:
//     [0] b
//
// Bu düzen bilinçli: bir nöronun tüm kenarları bellekte bitişik, yani
// ileri geçiş tek bir önbellek satırı akışıyla yürüyor.

import "fixed.lir"

const EDGE_STRIDE: i64 = 4 // kayıt başına i64 hücre
// tau üst sınırı: 1e6 (Q32.32). Döngüden çıkarıldı — önceden her kenar
// için `from_int(1000000)` çağrılıyordu.
const TAU_LIM: i64 = 4294967296000000

struct SelBlock {
    edges: *u8      // nout x K x 4 i64
    bias: *u8       // nout i64
    out: *u8        // nout i64  (ileri geçiş çıktısı)
    nin: i64
    nout: i64
    k: i64
}

/// Blok oluştur. `seed` deterministik ağırlık üretimi için.
/// Ağırlıklar ±0.5 aralığında, ±2^-8 çözünürlükte başlar.
fn block_new(nin: i64, nout: i64, k: i64, seed: i64) -> SelBlock {
    let n_edge_cells = nout * k * EDGE_STRIDE
    let blk = SelBlock {
        edges: @malloc(n_edge_cells * 8)
        bias: @malloc(nout * 8)
        out: @malloc(nout * 8)
        nin: nin
        nout: nout
        k: k
    }
    var o: i64 = 0
    while o < nout {
        var j: i64 = 0
        while j < k {
            let base = (o * k + j) * EDGE_STRIDE
            // Girdi indeksi: nin küçük olduğunda (o*31) % nin her nöronu
            // aynı indekse düşürür; bu yüzden nöron başına farklı bir
            // "kanal" seçiyoruz: idx = (o + j*5 + seed) % nin, ve nin < k
            // olduğunda kenarlar farklı j'lerde farklı girdilere bakar.
            // (Ölçüldü: eski formülle XOR'da tüm kenarlar aynı 2 girdiye
            //  çöküyor, gizli katman çeşitlilik üretmiyordu.)
            let raw = (o + j * 5 + seed * 3) % nin
            let idx = if raw < 0 { 0 - raw } else { raw }
            // Ağırlık: (h*2 - 255) / 512 , yani ~[-0.498, 0.498]
            // Çarpanlar nin'den bağımsız: nöron başına farklı ağırlık.
            let h = (o * 131 + j * 71 + seed * 37) % 256
            let w = div(from_int(h * 2 - 255), from_int(512))
            @write_u64(@ptr_add(blk.edges, (base + 0) * 8), idx as u64)
            @write_u64(@ptr_add(blk.edges, (base + 1) * 8), w as u64)
            @write_u64(@ptr_add(blk.edges, (base + 2) * 8), 0 as u64)
            @write_u64(@ptr_add(blk.edges, (base + 3) * 8), 0 as u64)
            j = j + 1
        }
        @write_u64(@ptr_add(blk.bias, o * 8), 0 as u64)
        o = o + 1
    }
    return blk
}

/// Kenar alanlarına erişim (okunur).
fn e_idx(b: SelBlock, o: i64, j: i64) -> i64 {
    return @read_u64(@ptr_add(b.edges, ((o * b.k + j) * EDGE_STRIDE + 0) * 8)) as i64
}
fn e_w(b: SelBlock, o: i64, j: i64) -> i64 {
    return @read_u64(@ptr_add(b.edges, ((o * b.k + j) * EDGE_STRIDE + 1) * 8)) as i64
}
fn e_tau(b: SelBlock, o: i64, j: i64) -> i64 {
    return @read_u64(@ptr_add(b.edges, ((o * b.k + j) * EDGE_STRIDE + 2) * 8)) as i64
}
fn e_set_w(b: SelBlock, o: i64, j: i64, w: i64) {
    @write_u64(@ptr_add(b.edges, ((o * b.k + j) * EDGE_STRIDE + 1) * 8), w as u64)
}
fn e_set_tau(b: SelBlock, o: i64, j: i64, t: i64) {
    @write_u64(@ptr_add(b.edges, ((o * b.k + j) * EDGE_STRIDE + 2) * 8), t as u64)
}
fn e_hits(b: SelBlock, o: i64, j: i64) -> i64 {
    return @read_u64(@ptr_add(b.edges, ((o * b.k + j) * EDGE_STRIDE + 3) * 8)) as i64
}
fn e_bump_hits(b: SelBlock, o: i64, j: i64) {
    let off = ((o * b.k + j) * EDGE_STRIDE + 3) * 8
    let h = @read_u64(@ptr_add(b.edges, off)) as i64
    @write_u64(@ptr_add(b.edges, off), (h + 1) as u64)
}

/// Sızdıran ReLU: negatifte küçük bir pay bırakır, böylece nöron ölmez.
/// (Saf ReLU, hedefi sıfır olan nöronları kalıcı olarak kapatır; XOR'da
/// tüm gizli katman böyle ölüyordu — ölçüldü.)
fn lrelu(x: i64) -> i64 {
    // Sıfıra yakın her girdi için küçük ama SIFIR OLMAYAN bir taban:
    // böylece x = [0,0] olan örnekte de gizli katman ayırt edici bir
    // vektör üretir. (Saf ReLU'da bu örnek tümüyle sıfır vektör
    // üretiyordu ve çıktı katmanı onu diğerlerinden ayıramıyordu.)
    //
    // Hız notu: `div` yerine `>> 4` kullanılıyor. Q32.32'de 2^-4 ile
    // çarpmak tam olarak 4 bit sağa kaydırmaktır; `div` 3 ns, `>>` 0.3 ns.
    // (Ölçüldü: önceki sürüm 41 ns/çağrıydı, bu sürüm ~1 ns.)
    if x < 0 {
        return (x >> 4) + 16777216
    }
    return x + 16777216
}

/// İleri geçiş: out[o] = lrelu(bias[o] + sum_j w_oj * x[idx_oj])
///
/// ## Neden düz işaretçi sürümü
///
/// `SelBlock` alanlarına erişmek (b.nout, b.k, b.edges) her erişimde
/// yapısal bir yükleme demek; ölçümde bu, gövdeyi 2.5x yavaşlatıyordu
/// (1093 ns -> 445 ns, 24 kenarlık katmanda). Bu yüzden sıcak döngü
/// alanları yerel değişkene alınır ve erişim `@ptr_add` ile yapılır.
fn forward(b: SelBlock, x: *u8) {
    let edges = b.edges
    let bias = b.bias
    let out = b.out
    let nout = b.nout
    let k = b.k
    var o: i64 = 0
    while o < nout {
        var acc: i64 = @read_u64(@ptr_add(bias, o * 8)) as i64
        var j: i64 = 0
        let obase = o * k * EDGE_STRIDE * 8
        while j < k {
            let ebase = obase + j * EDGE_STRIDE * 8
            let i = @read_u64(@ptr_add(edges, ebase)) as i64
            let w = @read_u64(@ptr_add(edges, ebase + 8)) as i64
            let xv = @read_u64(@ptr_add(x, i * 8)) as i64
            // forward'da satır içi dönüşüm DENENDİ ve REDDEDİLDİ (bkz. 151ea0d):
            // izole ölçümde 1.17-1.19x kazandırıyor, ama `learn` ile aynı
            // döngüde kullanıldığında `b_learn`'i 0.36x'e düşürüyordu.
            // Temiz derleyiciyle 3 kez yeniden üretildi; sebep bulunamadı.
            // `learn` içindeki aynı dönüşüm ise kazanıyor, bu yüzden
            // forward orijinal biçimde bırakıldı.
            acc = sat_add(acc, mul(w, xv))
            j = j + 1
        }
        @write_u64(@ptr_add(out, o * 8), lrelu(acc) as u64)
        o = o + 1
    }
}

/// Özellik karışımı: gizli katman çıktısına ikinci dereceden terimler ekler.
/// Bu, ağın XOR gibi çarpımsal ilişkileri temsil etmesini sağlar; tek başına
/// doğrusal bir katman bunu yapamaz.
/// out2[i] = out[i] + out[i]·out[(i+1) mod n]
fn mix_quadratic(src: *u8, dst: *u8, n: i64) {
    var i: i64 = 0
    while i < n {
        let a = @read_u64(@ptr_add(src, i * 8)) as i64
        let j = if i + 1 < n { i + 1 } else { 0 }
        let b = @read_u64(@ptr_add(src, j * 8)) as i64
        @write_u64(@ptr_add(dst, i * 8), sat_add(a, mul(a, b)) as u64)
        i = i + 1
    }
}

/// Eikonal güncelleme.
///
/// ## Kural
///
/// Her çıktı nöronu, kendi hatası `d = hedef − tahmin` için bir "mesafe"
/// taşır. Eikonal denklem |∇T| = 1/F, ayrıklaştırıldığında şunu söyler:
/// bir kenarın ağırlığı, mesafeyi **kendi girdisi yönünde** azaltacak
/// biçimde kaymalıdır. Kenarın katkısı `w·x` olduğundan, `d` hatasını
/// kapatmak için gereken değişim:
///
///     Δw = η · d · x / (|x|² + 1)
///
/// Payda, girdi vektörünün uzunluğudur — bu, normalize edilmiş LMS
/// (NLMS) kuralıdır ve **her örnekte garantili yakınsar** (η < 2 için).
/// Eikonal yorumu: `d/|x|`, hata yüzeyine olan dik mesafedir; `x/|x|`
/// o mesafenin yönüdür.
///
/// Bu nedenle kural, "tüm ağırlıkları aynı yöne it" hatasını yapmaz:
/// her kenar yalnız kendi girdisinin işareti ve büyüklüğü kadar oynar.
/// Ölçüldü: eski işaret-tabanlı kural XOR'da 2/4'te salınıyordu; bu
/// kural aynı problemde yakınsıyor (ai/tests/03_xor.lir).
///
/// `tau` alanı, kenarın birikmiş |d| toplamını tutar (sönümlemeli);
/// bu, hangi kenarların "yorgun" olduğunu gösterir ve `hits` ile birlikte
/// hata ayıklamada kullanılır.
fn learn(b: SelBlock, x: *u8, target: *u8, eta: i64) -> i64 {
    let edges = b.edges
    let bias = b.bias
    let out = b.out
    let nout = b.nout
    let k = b.k
    var total_e: i64 = 0
    var o: i64 = 0
    while o < nout {
        let yhat = @read_u64(@ptr_add(out, o * 8)) as i64
        let tv = @read_u64(@ptr_add(target, o * 8)) as i64
        let d = tv - yhat
        let e = mul_sat(d, d)
        total_e = sat_add(total_e, e)
        if d != 0 {
            let obase = o * k * EDGE_STRIDE * 8
            // |x|² + 1 : normalize edici. Tek turda hem norm hem kenar
            // indeksleri hesaplanır (ikinci turda yeniden okumak yerine
            // doğrudan kullanılır — bu, sıcak döngüde 2x erişim tasarrufu).
            var acc_x: i64 = ONE
            var j: i64 = 0
            while j < k {
                let i = @read_u64(@ptr_add(edges, obase + j * EDGE_STRIDE * 8)) as i64
                let xv = @read_u64(@ptr_add(x, i * 8)) as i64
                // Satır içi: `mul`+`sat_add` çağrı yükü kaldırıldı.
                // Çarpımda dallanma KORUNUYOR (büyük değer -> mul_sat),
                // toplamada `sat_add` gereksiz: K=8, |terim| < 2^46.
                //
                // Doğrulandı (256 nöron, K=8, -O2, 20000 adım, min-of-15
                // dönüşümlü, TEMİZ derleyici, aynı probe):
                //   eski 1112.0 ms -> yeni 744.8 ms = **1.49x**, 12/15 tur.
                let xs = xv >> 16
                if xs >= HALF or xs <= 0 - HALF {
                    acc_x = acc_x + mul_sat(xv, xv)
                } else {
                    acc_x = acc_x + xs * xs
                }
                j = j + 1
            }
            // 1/(|x|²+1) — yalnız bir kez bölünüyor.
            let inv = div(ONE, acc_x)
            // eta·d·inv tek bir sabit olarak dışarı alınır.
            let g = mul(mul(eta, d), inv)
            let tau_inc = energy_scale(e)
            var j2: i64 = 0
            while j2 < k {
                let ebase = obase + j2 * EDGE_STRIDE * 8
                let i2 = @read_u64(@ptr_add(edges, ebase)) as i64
                let xv2 = @read_u64(@ptr_add(x, i2 * 8)) as i64
                let delta = mul(g, xv2)
                let w = @read_u64(@ptr_add(edges, ebase + 8)) as i64
                // Aynı hile: `sat_add` + `clamp_i` yerine sıralı clamp.
                // Sonuç birebir aynı (MINV <= sonuc <= MAXV) ama çağrı yok.
                var wn = w + delta
                if wn > MAXV {
                    wn = MAXV
                }
                if wn < MINV {
                    wn = MINV
                }
                @write_u64(@ptr_add(edges, ebase + 8), wn as u64)
                let t = @read_u64(@ptr_add(edges, ebase + 16)) as i64
                let tn = t + tau_inc
                @write_u64(@ptr_add(edges, ebase + 16), (if tn > TAU_LIM { TAU_LIM } else { tn }) as u64)
                let h = @read_u64(@ptr_add(edges, ebase + 24)) as i64
                @write_u64(@ptr_add(edges, ebase + 24), (h + 1) as u64)
                j2 = j2 + 1
            }
            let bnow = @read_u64(@ptr_add(bias, o * 8)) as i64
            @write_u64(@ptr_add(bias, o * 8), clamp_i(sat_add(bnow, g), MINV, MAXV) as u64)
        }
        o = o + 1
    }
    return total_e
}

// NOEMA Stage 17: deterministic typed-array fit/evaluation loop.
const FIT_INVALID: i64 = -1
const FIT_MAX_ROWS: i64 = 100000
const FIT_MAX_EPOCHS: i64 = 10000
const FIT_TRAIN: i64 = 0
const FIT_DEV: i64 = 1
const FIT_TEST: i64 = 2

/// Train one epoch over contiguous Q32.32 rows; non-train rows are never updated.
fn noema_train_epoch(b: SelBlock, row_count: i64, features: *u8, targets: *u8, splits: *u8, eta: i64, mean_energy_out: *u8) -> i64 {
    if row_count < 0 or row_count > FIT_MAX_ROWS or b.nin <= 0 or b.nout <= 0 or b.k <= 0 or eta <= 0 { return FIT_INVALID }
    var trained: i64 = 0
    var total: i64 = 0
    var row: i64 = 0
    while row < row_count {
        let split = @read_u64(@ptr_add(splits, row * 8)) as i64
        if split < FIT_TRAIN or split > FIT_TEST { return FIT_INVALID }
        if split == FIT_TRAIN {
            let x = @ptr_add(features, row * b.nin * 8)
            let target = @ptr_add(targets, row * b.nout * 8)
            forward(b, x)
            total = sat_add(total, learn(b, x, target, eta))
            trained = trained + 1
        }
        row = row + 1
    }
    if trained == 0 { return FIT_INVALID }
    @write_u64(mean_energy_out, div(total, from_int(trained * b.nout)) as u64)
    return trained
}

/// Evaluate a selected split without weight updates; empty evaluation is invalid.
fn noema_evaluate_split(b: SelBlock, row_count: i64, features: *u8, targets: *u8, splits: *u8, wanted_split: i64, mean_energy_out: *u8) -> i64 {
    if row_count < 0 or row_count > FIT_MAX_ROWS or b.nin <= 0 or b.nout <= 0 { return FIT_INVALID }
    if wanted_split < FIT_TRAIN or wanted_split > FIT_TEST { return FIT_INVALID }
    var evaluated: i64 = 0
    var total: i64 = 0
    var row: i64 = 0
    while row < row_count {
        let split = @read_u64(@ptr_add(splits, row * 8)) as i64
        if split < FIT_TRAIN or split > FIT_TEST { return FIT_INVALID }
        if split == wanted_split {
            let x = @ptr_add(features, row * b.nin * 8)
            let target = @ptr_add(targets, row * b.nout * 8)
            forward(b, x)
            var o: i64 = 0
            while o < b.nout {
                let error = (@read_u64(@ptr_add(b.out, o * 8)) as i64) - (@read_u64(@ptr_add(target, o * 8)) as i64)
                total = sat_add(total, mul_sat(error, error))
                o = o + 1
            }
            evaluated = evaluated + 1
        }
        row = row + 1
    }
    if evaluated == 0 { return FIT_INVALID }
    @write_u64(mean_energy_out, div(total, from_int(evaluated * b.nout)) as u64)
    return evaluated
}

/// Evaluate classification decisions by argmax(target) vs argmax(prediction).
/// Writes row-major confusion matrix [actual * classes + predicted].
fn noema_confusion_split(b: SelBlock, row_count: i64, features: *u8, targets: *u8, splits: *u8, wanted_split: i64, confusion: *u8) -> i64 {
    if row_count < 0 or row_count > FIT_MAX_ROWS or b.nin <= 0 or b.nout <= 1 or b.nout > 64 { return FIT_INVALID }
    if wanted_split < FIT_TRAIN or wanted_split > FIT_TEST { return FIT_INVALID }
    var a: i64 = 0
    while a < b.nout { var p: i64 = 0 while p < b.nout { @write_u64(@ptr_add(confusion, (a * b.nout + p) * 8), 0 as u64) p = p + 1 } a = a + 1 }
    var evaluated: i64 = 0
    var row: i64 = 0
    while row < row_count {
        let split = @read_u64(@ptr_add(splits, row * 8)) as i64
        if split < FIT_TRAIN or split > FIT_TEST { return FIT_INVALID }
        if split == wanted_split {
            let x = @ptr_add(features, row * b.nin * 8)
            let target = @ptr_add(targets, row * b.nout * 8)
            forward(b, x)
            var actual: i64 = 0
            var predicted: i64 = 0
            var best_actual = 0 - 9223372036854775807
            var best_prediction = 0 - 9223372036854775807
            var c: i64 = 0
            while c < b.nout {
                let expected = @read_u64(@ptr_add(target, c * 8)) as i64
                let output = @read_u64(@ptr_add(b.out, c * 8)) as i64
                if expected > best_actual { best_actual = expected actual = c }
                if output > best_prediction { best_prediction = output predicted = c }
                c = c + 1
            }
            let cell = (actual * b.nout + predicted) * 8
            let old_count = @read_u64(@ptr_add(confusion, cell)) as i64
            @write_u64(@ptr_add(confusion, cell), (old_count + 1) as u64)
            evaluated = evaluated + 1
        }
        row = row + 1
    }
    if evaluated == 0 { return FIT_INVALID }
    return evaluated
}

/// Fixed-epoch deterministic fit; history stores mean training energy per epoch.
fn noema_fit(b: SelBlock, row_count: i64, features: *u8, targets: *u8, splits: *u8, eta: i64, epochs: i64, history: *u8) -> i64 {
    if epochs <= 0 or epochs > FIT_MAX_EPOCHS { return FIT_INVALID }
    var epoch: i64 = 0
    while epoch < epochs {
        let trained = noema_train_epoch(b, row_count, features, targets, splits, eta, @ptr_add(history, epoch * 8))
        if trained == FIT_INVALID { return FIT_INVALID }
        epoch = epoch + 1
    }
    return epochs
}

/// Train with dev-only early stopping and restore the best observed parameters.
/// `patience` counts consecutive non-improving epochs; `min_delta` is Q32.32.
/// Test rows are never consulted. Returns epochs executed, or FIT_INVALID.
fn noema_fit_early_stop(b: SelBlock, row_count: i64, features: *u8, targets: *u8, splits: *u8, config: *u8, history: *u8) -> i64 {
    let eta = @read_u64(config) as i64
    let max_epochs = @read_u64(@ptr_add(config, 8)) as i64
    let patience = @read_u64(@ptr_add(config, 16)) as i64
    let min_delta = @read_u64(@ptr_add(config, 24)) as i64
    if max_epochs <= 0 or max_epochs > FIT_MAX_EPOCHS or patience <= 0 or min_delta < 0 or eta <= 0 or b.nout <= 0 or b.k <= 0 { return FIT_INVALID }
    let dev_metric = @malloc(8)
    let edge_bytes = b.nout * b.k * EDGE_STRIDE * 8
    let bias_bytes = b.nout * 8
    let best_edges = @malloc(edge_bytes)
    let best_bias = @malloc(bias_bytes)
    var best_loss: i64 = 9223372036854775807
    var stale: i64 = 0
    var epoch: i64 = 0
    var have_best: i64 = 0
    while epoch < max_epochs {
        if noema_train_epoch(b, row_count, features, targets, splits, eta, @ptr_add(history, epoch * 8)) == FIT_INVALID { return FIT_INVALID }
        if noema_evaluate_split(b, row_count, features, targets, splits, FIT_DEV, dev_metric) == FIT_INVALID { return FIT_INVALID }
        let loss = @read_u64(dev_metric) as i64
        if have_best == 0 or (loss < best_loss and best_loss - loss > min_delta) {
            best_loss = loss
            @memcpy(best_edges, b.edges, edge_bytes)
            @memcpy(best_bias, b.bias, bias_bytes)
            have_best = 1
            stale = 0
        } else {
            stale = stale + 1
        }
        epoch = epoch + 1
        if stale >= patience { break }
    }
    if have_best == 0 { return FIT_INVALID }
    @memcpy(b.edges, best_edges, edge_bytes)
    @memcpy(b.bias, best_bias, bias_bytes)
    return epoch
}

/// Ortalama enerji (enerji / nout), Q32.32.
fn mean_energy(b: SelBlock, e: i64) -> i64 {
    if b.nout == 0 {
        return e
    }
    return div(e, from_int(b.nout))
}

// Portable SELQ32V2 classifier artifact; checksum detects accidental corruption only.
const SELQ_MAX_NIN: i64 = 4096
const SELQ_MAX_NOUT: i64 = 64
const SELQ_MAX_K: i64 = 4096
fn selq_write_all(fd: i64, data: *u8, length: i64) -> i64 {
    var pos: i64 = 0
    while pos < length { let n = @write(fd, @ptr_add(data, pos), length - pos) if n <= 0 { return 0 } pos = pos + n }
    return 1
}
fn selq_read_all(fd: i64, data: *u8, length: i64) -> i64 {
    var pos: i64 = 0
    while pos < length { let n = @read(fd, @ptr_add(data, pos), length - pos) if n <= 0 { return 0 } pos = pos + n }
    return 1
}
fn selq_write_u64le(fd: i64, value: i64) -> i64 {
    let bytes = @malloc(8)
    var i: i64 = 0
    while i < 8 { @write_u8(@ptr_add(bytes, i), (value >> (i * 8)) as u8) i = i + 1 }
    return selq_write_all(fd, bytes, 8)
}
fn selq_read_u64le(fd: i64, output: *u8) -> i64 {
    let bytes = @malloc(8)
    if selq_read_all(fd, bytes, 8) != 1 { return 0 }
    var value: u64 = 0
    var i: i64 = 0
    while i < 8 { value = value + ((@read_u8(@ptr_add(bytes, i)) as u64) << (i * 8)) i = i + 1 }
    @write_u64(output, value)
    return 1
}
fn selq_checksum(bytes: *u8, length: i64) -> i64 {
    var hash: i64 = 2166136261
    var i: i64 = 0
    while i < length { hash = (hash * 16777619 + (@read_u8(@ptr_add(bytes, i)) as i64)) % 2147483647 i = i + 1 }
    return hash
}
fn selq_encode_cells(source: *u8, payload: *u8, cells: i64) {
    var i: i64 = 0
    while i < cells { let value = @read_u64(@ptr_add(source, i * 8)) var b: i64 = 0 while b < 8 { @write_u8(@ptr_add(payload, i * 8 + b), (value >> (b * 8)) as u8) b = b + 1 } i = i + 1 }
}
fn selq_decode_cells(payload: *u8, target: *u8, cells: i64) {
    var i: i64 = 0
    while i < cells { var value: u64 = 0 var b: i64 = 0 while b < 8 { value = value + ((@read_u8(@ptr_add(payload, i * 8 + b)) as u64) << (b * 8)) b = b + 1 } @write_u64(@ptr_add(target, i * 8), value) i = i + 1 }
}
fn sel_checkpoint_save(b: SelBlock, path: string, training_rows: i64, epochs: i64, seed: i64) -> i64 {
    if b.nin <= 0 or b.nin > SELQ_MAX_NIN or b.nout <= 0 or b.nout > SELQ_MAX_NOUT or b.k <= 0 or b.k > SELQ_MAX_K or training_rows <= 0 or epochs <= 0 or seed <= 0 { return 0 }
    let edge_cells = b.nout * b.k * EDGE_STRIDE
    let cells = edge_cells + b.nout
    let payload = @malloc(cells * 8)
    selq_encode_cells(b.edges, payload, edge_cells)
    selq_encode_cells(b.bias, @ptr_add(payload, edge_cells * 8), b.nout)
    let checksum = selq_checksum(payload, cells * 8)
    let fd = @open(path, 577, 420)
    if fd < 0 { return 0 }
    let magic = "SELQ32V2"
    if selq_write_all(fd, magic.ptr as *u8, 8) != 1 { @close(fd) return 0 }
    if selq_write_u64le(fd, 2) != 1 or selq_write_u64le(fd, 4294967296) != 1 or selq_write_u64le(fd, b.nin) != 1 or selq_write_u64le(fd, b.nout) != 1 or selq_write_u64le(fd, b.k) != 1 or selq_write_u64le(fd, 1) != 1 or selq_write_u64le(fd, 1) != 1 or selq_write_u64le(fd, training_rows) != 1 or selq_write_u64le(fd, epochs) != 1 or selq_write_u64le(fd, seed) != 1 or selq_write_u64le(fd, checksum) != 1 { @close(fd) return 0 }
    if selq_write_all(fd, payload, cells * 8) != 1 { @close(fd) return 0 }
    return if @close(fd) == 0 { 1 } else { 0 }
}
fn sel_checkpoint_load(b: SelBlock, path: string) -> i64 {
    if b.nin <= 0 or b.nin > SELQ_MAX_NIN or b.nout <= 0 or b.nout > SELQ_MAX_NOUT or b.k <= 0 or b.k > SELQ_MAX_K { return 0 }
    let fd = @open(path, 0, 0)
    if fd < 0 { return 0 }
    let magic = "SELQ32V2"
    let found = @malloc(8)
    if selq_read_all(fd, found, 8) != 1 { @close(fd) return 0 }
    var i: i64 = 0
    while i < 8 { if @read_u8(@ptr_add(found, i)) != @read_u8(@ptr_add(magic.ptr, i)) { @close(fd) return 0 } i = i + 1 }
    let meta = @malloc(88)
    i = 0
    while i < 11 { if selq_read_u64le(fd, @ptr_add(meta, i * 8)) != 1 { @close(fd) return 0 } i = i + 1 }
    if (@read_u64(meta) as i64) != 2 or (@read_u64(@ptr_add(meta, 8)) as i64) != 4294967296 or (@read_u64(@ptr_add(meta, 16)) as i64) != b.nin or (@read_u64(@ptr_add(meta, 24)) as i64) != b.nout or (@read_u64(@ptr_add(meta, 32)) as i64) != b.k or (@read_u64(@ptr_add(meta, 40)) as i64) != 1 or (@read_u64(@ptr_add(meta, 48)) as i64) != 1 or (@read_u64(@ptr_add(meta, 56)) as i64) <= 0 or (@read_u64(@ptr_add(meta, 64)) as i64) <= 0 or (@read_u64(@ptr_add(meta, 72)) as i64) <= 0 { @close(fd) return 0 }
    let edge_cells = b.nout * b.k * EDGE_STRIDE
    let cells = edge_cells + b.nout
    let payload = @malloc(cells * 8)
    if selq_read_all(fd, payload, cells * 8) != 1 { @close(fd) return 0 }
    let trailing = @malloc(1)
    if @read(fd, trailing, 1) != 0 { @close(fd) return 0 }
    if @close(fd) != 0 { return 0 }
    if selq_checksum(payload, cells * 8) != (@read_u64(@ptr_add(meta, 80)) as i64) { return 0 }
    selq_decode_cells(payload, b.edges, edge_cells)
    selq_decode_cells(@ptr_add(payload, edge_cells * 8), b.bias, b.nout)
    return 1
}

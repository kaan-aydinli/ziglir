// NOEMA Stage 9: bounded deterministic exact-rule inference kernel.
// Facts and rule terms are positive integer IDs. Each rule has one antecedent
// and one consequent. This is a small forward-chaining core, not natural-language
// reasoning, a proof assistant, or a complete NOEMA inference runtime.
const REASON_INVALID: i64 = -1
const REASON_MAX_FACTS: i64 = 256
const REASON_MAX_RULES: i64 = 1024

/// Compute monotone closure using ordered single-premise rules. Returns the
/// number of unique facts, or REASON_INVALID for malformed input/capacity.
/// Input/output buffers are caller-owned u64 arrays sized to the declared caps.
fn reasoning_closure(initial_count: i64, initial_facts: *u8, rule_count: i64, antecedents: *u8, consequents: *u8, capacity: i64, output_facts: *u8) -> i64 {
    if initial_count < 0 or initial_count > REASON_MAX_FACTS { return REASON_INVALID }
    if rule_count < 0 or rule_count > REASON_MAX_RULES { return REASON_INVALID }
    if capacity < initial_count or capacity > REASON_MAX_FACTS { return REASON_INVALID }
    var count: i64 = 0
    var i: i64 = 0
    while i < initial_count {
        let fact = @read_u64(@ptr_add(initial_facts, i * 8)) as i64
        if fact <= 0 { return REASON_INVALID }
        var j: i64 = 0
        while j < count {
            if (@read_u64(@ptr_add(output_facts, j * 8)) as i64) == fact { return REASON_INVALID }
            j = j + 1
        }
        @write_u64(@ptr_add(output_facts, count * 8), fact as u64)
        count = count + 1
        i = i + 1
    }
    i = 0
    while i < rule_count {
        if (@read_u64(@ptr_add(antecedents, i * 8)) as i64) <= 0 { return REASON_INVALID }
        if (@read_u64(@ptr_add(consequents, i * 8)) as i64) <= 0 { return REASON_INVALID }
        i = i + 1
    }
    var changed = 1
    while changed == 1 {
        changed = 0
        var r: i64 = 0
        while r < rule_count {
            let antecedent = @read_u64(@ptr_add(antecedents, r * 8)) as i64
            let consequent = @read_u64(@ptr_add(consequents, r * 8)) as i64
            var has_antecedent = 0
            var has_consequent = 0
            var f: i64 = 0
            while f < count {
                let value = @read_u64(@ptr_add(output_facts, f * 8)) as i64
                if value == antecedent { has_antecedent = 1 }
                if value == consequent { has_consequent = 1 }
                f = f + 1
            }
            if has_antecedent == 1 and has_consequent == 0 {
                if count >= capacity { return REASON_INVALID }
                @write_u64(@ptr_add(output_facts, count * 8), consequent as u64)
                count = count + 1
                changed = 1
            }
            r = r + 1
        }
    }
    return count
}

/// Exact membership query over the resulting closure.
fn reasoning_fact_present(fact_count: i64, facts: *u8, query: i64) -> i64 {
    if fact_count < 0 or fact_count > REASON_MAX_FACTS or query <= 0 { return 0 }
    var i: i64 = 0
    while i < fact_count {
        if (@read_u64(@ptr_add(facts, i * 8)) as i64) == query { return 1 }
        i = i + 1
    }
    return 0
}

// NOEMA Stage 1: pure TTA obligation-transition contract.
// This is a small, auditable LIR core primitive. It does not claim to
// implement persistence, permissions, or a complete NOEMA runtime.

const OBLIGATION_OPEN: i64 = 0
const OBLIGATION_CANDIDATE: i64 = 1
const OBLIGATION_CLOSED: i64 = 2
const OBLIGATION_UNRESOLVED: i64 = 3
const OBLIGATION_REJECTED: i64 = 4
const OBLIGATION_INVALIDATED: i64 = 5

/// Pure guard for one obligation state transition.
/// Closing requires evidence, a passing independent verifier, and matching scope.
/// The caller appends a transition event only after this returns 1.
fn obligation_transition_allowed(current: i64, next: i64, evidence_present: i64, verifier_passed: i64, producer_independent: i64, scope_matches: i64) -> i64 {
    if current < OBLIGATION_OPEN or current > OBLIGATION_INVALIDATED { return 0 }
    if next < OBLIGATION_OPEN or next > OBLIGATION_INVALIDATED { return 0 }
    if current == next { return 0 }

    if current == OBLIGATION_OPEN {
        if next == OBLIGATION_CANDIDATE or next == OBLIGATION_UNRESOLVED { return 1 }
        return 0
    }
    if current == OBLIGATION_CANDIDATE {
        if next == OBLIGATION_REJECTED and verifier_passed == 0 { return 1 }
        if next == OBLIGATION_OPEN or next == OBLIGATION_UNRESOLVED { return 1 }
        if next != OBLIGATION_CLOSED { return 0 }
        return evidence_can_close(evidence_present, verifier_passed, producer_independent, scope_matches)
    }
    if current == OBLIGATION_UNRESOLVED {
        if next == OBLIGATION_OPEN or next == OBLIGATION_CANDIDATE { return 1 }
        return 0
    }
    if current == OBLIGATION_CLOSED and next == OBLIGATION_INVALIDATED { return 1 }
    if current == OBLIGATION_INVALIDATED and next == OBLIGATION_OPEN { return 1 }
    return 0
}

fn evidence_can_close(evidence_present: i64, verifier_passed: i64, producer_independent: i64, scope_matches: i64) -> i64 {
    if evidence_present != 1 { return 0 }
    if verifier_passed != 1 { return 0 }
    if producer_independent != 1 { return 0 }
    if scope_matches != 1 { return 0 }
    return 1
}

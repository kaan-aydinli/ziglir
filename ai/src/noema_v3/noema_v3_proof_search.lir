// NOEMA v3 Phase 8:
//   1) Trainable Neural Epistemic Regime Proposal Head (`nv3_regime_head_*` — zero keyword lookup;
//      pure raw-UTF-8 byte-phase projection + closed-form forward/backward + finite-diff verification).
//   2) Pure-LIR Byte-Stream Symbolic Claim Extractor & Verifier (`nv3_ps_verify_segment`)
//      bridging Rational/BigInt, Dimensional SI, Propositional DPLL Entailment, and ISO-8601 Temporal
//      kernels directly into pointer-addressed `Nv3KhgGraph`.
//   3) Step-Budgeted Multi-Candidate Proof-Guided Backtracking Search (`nv3_proof_guided_search_candidates`)
//      that prunes any branch with a `REFUTED` claim (even when its neural NLL is lower), records
//      all verified & refuted spans in `KHG` without copying bytes, and abstains honestly
//      (`NOEMA_V3_OUTPUT_WEIGHT_GENERATION_ABSTAIN`) when all branches fail or step budget expires.

import "noema_v3_verify_logic.lir"
import "noema_v3_kernels.lir"
import "noema_v3_soa.lir"

const NV3_REGIME_DIM: i64 = 16
const NV3_REGIME_CLASSES: i64 = 5
const NV3_REGIME_PROSE: i64 = 0
const NV3_REGIME_RATIONAL: i64 = 1
const NV3_REGIME_SI: i64 = 2
const NV3_REGIME_LOGIC: i64 = 3
const NV3_REGIME_TEMPORAL: i64 = 4

// ---------------- 1) Trainable Neural Epistemic Regime Proposal Head ----------------
// Extracts a 16-D continuous byte-structure & transition-moment vector from raw UTF-8 bytes `buf[0..len)`
// with ZERO natural-language keyword dictionaries.
fn nv3_regime_extract_byte_features(buf: *u8, len: i64, out_x: *f64) {
    nv3_zero(out_x, NV3_REGIME_DIM)
    if len <= 0 { return }
    let inv_n = 1.0 / (len as f64)
    var i: i64 = 0
    while i < len {
        let b = (@read_u8(@ptr_add(buf, i)) as i64) & 255
        let bf = (b as f64) / 255.0
        out_x[i % 4] = out_x[i % 4] + bf * inv_n
        if i + 1 < len {
            let b2 = (@read_u8(@ptr_add(buf, i + 1)) as i64) & 255
            let df = ((b2 - b) as f64) / 255.0
            out_x[4 + (i % 4)] = out_x[4 + (i % 4)] + (df * df) * inv_n
        }
        if b >= 48 and b <= 57 { out_x[8] = out_x[8] + inv_n }
        if b == 43 or b == 42 or b == 47 or b == 61 { out_x[9] = out_x[9] + inv_n }
        if b == 45 { out_x[10] = out_x[10] + inv_n }
        if b == 60 or b == 62 { out_x[11] = out_x[11] + inv_n }
        if b == 124 or b == 33 or b == 38 { out_x[12] = out_x[12] + inv_n }
        if b >= 65 and b <= 90 { out_x[13] = out_x[13] + inv_n }
        if b >= 97 and b <= 122 { out_x[14] = out_x[14] + inv_n }
        if b >= 128 { out_x[15] = out_x[15] + inv_n }
        i = i + 1
    }
}

fn nv3_regime_head_init(w_reg: *f64, b_reg: *f64, seed: i64) {
    var st = if seed != 0 { seed } else { 1337 }
    var i: i64 = 0
    while i < (NV3_REGIME_DIM * NV3_REGIME_CLASSES) {
        st = (st * 6364136223846793005) + 1442695040888963407
        let u = (((st >> 33) & 65535) as f64) / 65535.0 - 0.5
        w_reg[i] = u * 0.2
        i = i + 1
    }
    nv3_zero(b_reg, NV3_REGIME_CLASSES)
}

// Forward + optional analytical backward for `logits = x @ w_reg + b_reg` (`w_reg: [16, 5]`).
// `grad_pack`: if non-null (`*f64`), `[0..79]` = `dw_reg` (accumulated), `[80..84]` = `db_reg` (accumulated).
fn nv3_regime_head_fwd_bwd(
    x: *f64,
    w_reg: *f64,
    b_reg: *f64,
    target_cls: i64,
    do_bwd: i64,
    grad_pack: *f64,
    out_probs: *f64
) -> f64 {
    let logits = @malloc(NV3_REGIME_CLASSES * 8) as *f64
    nv3_linear_forward(x, w_reg, b_reg, logits, NV3_REGIME_DIM, NV3_REGIME_CLASSES)

    var maxv = logits[0]
    var c: i64 = 1
    while c < NV3_REGIME_CLASSES {
        if logits[c] > maxv { maxv = logits[c] }
        c = c + 1
    }
    var z: f64 = 0.0
    c = 0
    while c < NV3_REGIME_CLASSES {
        let e = nv3_exp(logits[c] - maxv)
        out_probs[c] = e
        z = z + e
        c = c + 1
    }
    c = 0
    while c < NV3_REGIME_CLASSES {
        out_probs[c] = out_probs[c] / z
        c = c + 1
    }

    var loss: f64 = 0.0
    if target_cls >= 0 and target_cls < NV3_REGIME_CLASSES {
        loss = (maxv + nv3_log(z)) - logits[target_cls]
        if do_bwd != 0 and (grad_pack as i64) != 0 {
            let dw = grad_pack
            let db = @ptr_add(grad_pack as *u8, NV3_REGIME_DIM * NV3_REGIME_CLASSES * 8) as *f64
            let dlogits = @malloc(NV3_REGIME_CLASSES * 8) as *f64
            let dx = @malloc(NV3_REGIME_DIM * 8) as *f64
            c = 0
            while c < NV3_REGIME_CLASSES {
                dlogits[c] = out_probs[c] - (if c == target_cls { 1.0 } else { 0.0 })
                c = c + 1
            }
            nv3_linear_backward(dlogits, x, w_reg, Nv3LinearGrad { dx: dx, dw: dw, db: db }, NV3_REGIME_DIM, NV3_REGIME_CLASSES)
            @free(dlogits as *u8)
            @free(dx as *u8)
        }
    }
    @free(logits as *u8)
    return loss
}

fn nv3_regime_head_predict_text(text: string, w_reg: *f64, b_reg: *f64, out_probs: *f64) -> i64 {
    let x = @malloc(NV3_REGIME_DIM * 8) as *f64
    nv3_regime_extract_byte_features(text as *u8, @string_len(text), x)
    let _l = nv3_regime_head_fwd_bwd(x, w_reg, b_reg, -1, 0, 0 as *f64, out_probs)
    @free(x as *u8)
    var best_c: i64 = 0
    var best_p = out_probs[0]
    var c: i64 = 1
    while c < NV3_REGIME_CLASSES {
        if out_probs[c] > best_p {
            best_p = out_probs[c]
            best_c = c
        }
        c = c + 1
    }
    return best_c
}

// ---------------- 2) Pure-LIR Byte-Stream Formal Claim Parsers ----------------

fn nv3_ps_trim_bounds(buf: *u8, a_in: i64, b_in: i64, out_ab: *i64) {
    var a = a_in
    var b = b_in
    while a < b {
        let ch = (@read_u8(@ptr_add(buf, a)) as i64) & 255
        if ch != 32 and ch != 9 and ch != 10 and ch != 13 { break }
        a = a + 1
    }
    while b > a {
        let ch = (@read_u8(@ptr_add(buf, b - 1)) as i64) & 255
        if ch != 32 and ch != 9 and ch != 10 and ch != 13 and ch != 46 { break }
        b = b - 1
    }
    out_ab[0] = a
    out_ab[1] = b
}

fn nv3_ps_find_sub2(buf: *u8, a: i64, b: i64, c0: i64, c1: i64) -> i64 {
    var i = a
    while (i + 1) < b {
        let x0 = (@read_u8(@ptr_add(buf, i)) as i64) & 255
        let x1 = (@read_u8(@ptr_add(buf, i + 1)) as i64) & 255
        if x0 == c0 and x1 == c1 { return i }
        i = i + 1
    }
    return -1
}

fn nv3_ps_find_byte_outside_arrow(buf: *u8, a: i64, b: i64, target: i64) -> i64 {
    var i = a
    while i < b {
        let x = (@read_u8(@ptr_add(buf, i)) as i64) & 255
        if x == target {
            if target == 61 and (i + 1) < b and (((@read_u8(@ptr_add(buf, i + 1)) as i64) & 255) == 62) {
                i = i + 2
            } else {
                return i
            }
        } else {
            i = i + 1
        }
    }
    return -1
}

fn nv3_ps_parse_rational_token(buf: *u8, a_in: i64, b_in: i64, out_pq: *i64) -> i64 {
    let ab = @malloc(16) as *i64
    nv3_ps_trim_bounds(buf, a_in, b_in, ab)
    var pos = ab[0]
    let hi = ab[1]
    @free(ab as *u8)
    if pos >= hi { return 0 }

    var sign: i64 = 1
    let first = (@read_u8(@ptr_add(buf, pos)) as i64) & 255
    if first == 45 { sign = -1 pos = pos + 1 }
    else if first == 43 { pos = pos + 1 }

    var num: i64 = 0
    var ndig: i64 = 0
    while pos < hi {
        let ch = (@read_u8(@ptr_add(buf, pos)) as i64) & 255
        if ch < 48 or ch > 57 { break }
        num = num * 10 + (ch - 48)
        ndig = ndig + 1
        pos = pos + 1
    }
    if ndig == 0 { return 0 }
    if pos == hi {
        out_pq[0] = sign * num
        out_pq[1] = 1
        return 1
    }
    if (((@read_u8(@ptr_add(buf, pos)) as i64) & 255) != 47) { return 0 }
    pos = pos + 1
    var den: i64 = 0
    var ddig: i64 = 0
    while pos < hi {
        let ch = (@read_u8(@ptr_add(buf, pos)) as i64) & 255
        if ch < 48 or ch > 57 { return 0 }
        den = den * 10 + (ch - 48)
        ddig = ddig + 1
        pos = pos + 1
    }
    if ddig == 0 { return 0 }
    out_pq[0] = sign * num
    out_pq[1] = den
    return 1
}

fn nv3_ps_parse_si_term(buf: *u8, a_in: i64, b_in: i64, out_pqu: *i64) -> i64 {
    let ab = @malloc(16) as *i64
    nv3_ps_trim_bounds(buf, a_in, b_in, ab)
    var pos = ab[0]
    let hi = ab[1]
    @free(ab as *u8)
    if pos >= hi { return 0 }

    var sign: i64 = 1
    let c0 = (@read_u8(@ptr_add(buf, pos)) as i64) & 255
    if c0 == 45 { sign = -1 pos = pos + 1 }
    var val: i64 = 0
    var nd: i64 = 0
    while pos < hi {
        let ch = (@read_u8(@ptr_add(buf, pos)) as i64) & 255
        if ch < 48 or ch > 57 { break }
        val = val * 10 + (ch - 48)
        nd = nd + 1
        pos = pos + 1
    }
    if nd == 0 { return 0 }
    while pos < hi and (((@read_u8(@ptr_add(buf, pos)) as i64) & 255) == 32) { pos = pos + 1 }
    let ulen = hi - pos
    if ulen <= 0 or ulen > 2 { return 0 }
    let u0 = (@read_u8(@ptr_add(buf, pos)) as i64) & 255
    let u1 = if ulen == 2 { (@read_u8(@ptr_add(buf, pos + 1)) as i64) & 255 } else { 0 }

    if ulen == 1 and u0 == 109 { out_pqu[0] = sign * val out_pqu[1] = 1 out_pqu[2] = 1 return 1 }          // m
    if ulen == 2 and u0 == 107 and u1 == 109 { out_pqu[0] = sign * val * 1000 out_pqu[1] = 1 out_pqu[2] = 1 return 1 } // km
    if ulen == 2 and u0 == 99 and u1 == 109 { out_pqu[0] = sign * val out_pqu[1] = 100 out_pqu[2] = 1 return 1 }       // cm
    if ulen == 1 and u0 == 115 { out_pqu[0] = sign * val out_pqu[1] = 1 out_pqu[2] = 2 return 1 }          // s
    if ulen == 2 and u0 == 109 and u1 == 115 { out_pqu[0] = sign * val out_pqu[1] = 1000 out_pqu[2] = 2 return 1 }     // ms
    if ulen == 1 and u0 == 104 { out_pqu[0] = sign * val * 3600 out_pqu[1] = 1 out_pqu[2] = 2 return 1 }   // h
    if ulen == 2 and u0 == 107 and u1 == 103 { out_pqu[0] = sign * val out_pqu[1] = 1 out_pqu[2] = 3 return 1 }        // kg
    if ulen == 1 and u0 == 103 { out_pqu[0] = sign * val out_pqu[1] = 1000 out_pqu[2] = 3 return 1 }       // g
    if ulen == 1 and u0 == 78 { out_pqu[0] = sign * val out_pqu[1] = 1 out_pqu[2] = 4 return 1 }           // N
    if ulen == 1 and u0 == 74 { out_pqu[0] = sign * val out_pqu[1] = 1 out_pqu[2] = 5 return 1 }           // J
    return 0
}

fn nv3_ps_unit_id_str(uid: i64) -> string {
    if uid == 1 { return "m" }
    if uid == 2 { return "s" }
    if uid == 3 { return "kg" }
    if uid == 4 { return "N" }
    if uid == 5 { return "J" }
    return "?"
}

// Pure stateless segment verifier across all 4 deterministic kernels.
// Writes `[0]=recognized(0/1), [1]=verdict, [2]=steps_used, [3]=kernel_id, [4]=trim_a, [5]=trim_b` into `out_ev`.
fn nv3_ps_verify_segment(
    buf: *u8,
    seg_a: i64,
    seg_b: i64,
    rem_budget: i64,
    out_ev: *i64
) {
    out_ev[0] = 0 out_ev[1] = NV3_VERDICT_ABSTAIN out_ev[2] = 0 out_ev[3] = 0 out_ev[4] = seg_a out_ev[5] = seg_b
    let ab = @malloc(16) as *i64
    nv3_ps_trim_bounds(buf, seg_a, seg_b, ab)
    let a = ab[0]
    let b = ab[1]
    @free(ab as *u8)
    out_ev[4] = a
    out_ev[5] = b
    if (b - a) < 3 { return }

    // (A) Propositional DPLL Entailment: `<clause1>, <clause2> |- <goal_var>`
    let turn_pos = nv3_ps_find_sub2(buf, a, b, 124, 45)
    if turn_pos > a {
        if rem_budget <= 0 {
            out_ev[0] = 1 out_ev[1] = NV3_VERDICT_BUDGET_EXCEEDED out_ev[2] = 0 out_ev[3] = NV3_KERNEL_CONSTRAINT_LOGIC
            return
        }
        let clauses = @malloc(30 * 4 * 8) as *i64
        var n_cl: i64 = 0
        var c_start = a
        var p = a
        var parse_ok: i64 = 1
        while p <= turn_pos {
            let is_end = if p == turn_pos { 1 } else { if (((@read_u8(@ptr_add(buf, p)) as i64) & 255) == 44) { 1 } else { 0 } }
            if is_end == 1 {
                let cab = @malloc(16) as *i64
                nv3_ps_trim_bounds(buf, c_start, p, cab)
                if cab[1] > cab[0] {
                    let s_cl = @string_new(@ptr_add(buf, cab[0]), cab[1] - cab[0])
                    if n_cl >= 28 or nv3_logic_parse_clause(s_cl, @ptr_add(clauses as *u8, n_cl * 32) as *i64) != 1 {
                        parse_ok = 0
                    } else {
                        n_cl = n_cl + 1
                    }
                }
                @free(cab as *u8)
                c_start = p + 1
            }
            p = p + 1
        }
        let gab = @malloc(16) as *i64
        nv3_ps_trim_bounds(buf, turn_pos + 2, b, gab)
        var goal_lit: i64 = 0
        if gab[1] > gab[0] {
            let glits = @malloc(32) as *i64
            let gs = @string_new(@ptr_add(buf, gab[0]), gab[1] - gab[0])
            if nv3_logic_parse_clause(gs, glits) == 1 and glits[1] == 0 {
                goal_lit = glits[0]
            }
            @free(glits as *u8)
        }
        @free(gab as *u8)

        if parse_ok == 1 and n_cl > 0 and goal_lit != 0 {
            let r_base = nv3_logic_solve(clauses, n_cl, 0 as *i64, rem_budget)
            var tot_st = r_base.steps
            var verd = NV3_VERDICT_CONTRADICTION
            if r_base.verdict == NV3_VERDICT_BUDGET_EXCEEDED {
                verd = NV3_VERDICT_BUDGET_EXCEEDED
            } else if r_base.verdict == NV3_VERDICT_VERIFIED {
                let neg_row = @ptr_add(clauses as *u8, n_cl * 32) as *i64
                neg_row[0] = 0 - goal_lit neg_row[1] = 0 neg_row[2] = 0 neg_row[3] = 0
                let rem2 = if rem_budget > tot_st { rem_budget - tot_st } else { 0 }
                let r_ref = nv3_logic_solve(clauses, n_cl + 1, 0 as *i64, rem2)
                tot_st = tot_st + r_ref.steps
                if r_ref.verdict == NV3_VERDICT_BUDGET_EXCEEDED {
                    verd = NV3_VERDICT_BUDGET_EXCEEDED
                } else if r_ref.verdict == NV3_VERDICT_CONTRADICTION {
                    verd = NV3_VERDICT_VERIFIED
                } else {
                    verd = NV3_VERDICT_CONTRADICTION
                }
            }
            @free(clauses as *u8)
            out_ev[0] = 1 out_ev[1] = verd out_ev[2] = tot_st out_ev[3] = NV3_KERNEL_CONSTRAINT_LOGIC
            return
        }
        @free(clauses as *u8)
    }

    // (B) Temporal ISO-8601 Ordering: `YYYY-MM-DD < YYYY-MM-DD`
    let lt_pos = nv3_ps_find_byte_outside_arrow(buf, a, b, 60)
    if lt_pos > a {
        let lab = @malloc(16) as *i64
        let rab = @malloc(16) as *i64
        nv3_ps_trim_bounds(buf, a, lt_pos, lab)
        nv3_ps_trim_bounds(buf, lt_pos + 1, b, rab)
        if (lab[1] - lab[0]) == 10 and (rab[1] - rab[0]) == 10 {
            if rem_budget < 2 {
                @free(lab as *u8) @free(rab as *u8)
                out_ev[0] = 1 out_ev[1] = NV3_VERDICT_BUDGET_EXCEEDED out_ev[2] = 2 out_ev[3] = NV3_KERNEL_TEMPORAL
                return
            }
            let d1 = nv3_parse_iso_date(@string_new(@ptr_add(buf, lab[0]), 10))
            let d2 = nv3_parse_iso_date(@string_new(@ptr_add(buf, rab[0]), 10))
            @free(lab as *u8) @free(rab as *u8)
            let verd_t = if d1 > 0 and d2 > 0 and d1 < d2 { NV3_VERDICT_VERIFIED } else { NV3_VERDICT_CONTRADICTION }
            out_ev[0] = 1 out_ev[1] = verd_t out_ev[2] = 2 out_ev[3] = NV3_KERNEL_TEMPORAL
            return
        }
        @free(lab as *u8) @free(rab as *u8)
    }

    // (C & D) Equations with `=`: Dimensional SI (`2 km = 2000 m`) or Rational (`1/3 + 1/6 = 1/2`)
    let eq_pos = nv3_ps_find_byte_outside_arrow(buf, a, b, 61)
    if eq_pos > a {
        if rem_budget <= 0 {
            out_ev[0] = 1 out_ev[1] = NV3_VERDICT_BUDGET_EXCEEDED out_ev[2] = 0 out_ev[3] = NV3_KERNEL_BIGINT_RATIONAL
            return
        }
        var op_pos: i64 = -1
        var op_code: i64 = 0
        var k = a + 1
        while k < eq_pos {
            let ch = (@read_u8(@ptr_add(buf, k)) as i64) & 255
            if ch == 43 { op_pos = k op_code = NV3_OP_ADD break }
            if ch == 42 { op_pos = k op_code = NV3_OP_MUL break }
            if ch == 45 {
                let prev = (@read_u8(@ptr_add(buf, k - 1)) as i64) & 255
                if prev == 32 or (prev >= 48 and prev <= 57) { op_pos = k op_code = NV3_OP_SUB break }
            }
            k = k + 1
        }

        let t1 = @malloc(24) as *i64
        let t2 = @malloc(24) as *i64
        let trhs = @malloc(24) as *i64
        let rhs_si_ok = nv3_ps_parse_si_term(buf, eq_pos + 1, b, trhs)
        if rhs_si_ok == 1 {
            if op_pos < 0 {
                if nv3_ps_parse_si_term(buf, a, eq_pos, t1) == 1 {
                    let qa = nv3_si_make(t1[0], t1[1], nv3_ps_unit_id_str(t1[2]), rem_budget)
                    let qb = nv3_si_make(trhs[0], trhs[1], nv3_ps_unit_id_str(trhs[2]), rem_budget)
                    let diff_q = nv3_si_eval_op(NV3_OP_SUB, qa, qb, rem_budget)
                    let st_si = diff_q.steps
                    let verd_si = if diff_q.verdict == NV3_VERDICT_BUDGET_EXCEEDED {
                        NV3_VERDICT_BUDGET_EXCEEDED
                    } else if diff_q.verdict == NV3_VERDICT_VERIFIED and diff_q.p == 0 {
                        NV3_VERDICT_VERIFIED
                    } else {
                        NV3_VERDICT_CONTRADICTION
                    }
                    nv3_si_free(qa) nv3_si_free(qb) nv3_si_free(diff_q)
                    @free(t1 as *u8) @free(t2 as *u8) @free(trhs as *u8)
                    out_ev[0] = 1 out_ev[1] = verd_si out_ev[2] = st_si out_ev[3] = NV3_KERNEL_SI_UNIT
                    return
                }
            } else {
                if nv3_ps_parse_si_term(buf, a, op_pos, t1) == 1 and nv3_ps_parse_si_term(buf, op_pos + 1, eq_pos, t2) == 1 {
                    let qa = nv3_si_make(t1[0], t1[1], nv3_ps_unit_id_str(t1[2]), rem_budget)
                    let qb = nv3_si_make(t2[0], t2[1], nv3_ps_unit_id_str(t2[2]), rem_budget)
                    let qsum = nv3_si_eval_op(op_code, qa, qb, rem_budget)
                    let qrhs = nv3_si_make(trhs[0], trhs[1], nv3_ps_unit_id_str(trhs[2]), rem_budget)
                    let qdiff = nv3_si_eval_op(NV3_OP_SUB, qsum, qrhs, rem_budget)
                    let st_si2 = qdiff.steps
                    let verd_si2 = if qdiff.verdict == NV3_VERDICT_BUDGET_EXCEEDED {
                        NV3_VERDICT_BUDGET_EXCEEDED
                    } else if qdiff.verdict == NV3_VERDICT_VERIFIED and qdiff.p == 0 {
                        NV3_VERDICT_VERIFIED
                    } else {
                        NV3_VERDICT_CONTRADICTION
                    }
                    nv3_si_free(qa) nv3_si_free(qb) nv3_si_free(qsum) nv3_si_free(qrhs) nv3_si_free(qdiff)
                    @free(t1 as *u8) @free(t2 as *u8) @free(trhs as *u8)
                    out_ev[0] = 1 out_ev[1] = verd_si2 out_ev[2] = st_si2 out_ev[3] = NV3_KERNEL_SI_UNIT
                    return
                }
            }
        }
        @free(t1 as *u8) @free(t2 as *u8) @free(trhs as *u8)

        let r1 = @malloc(16) as *i64
        let r2 = @malloc(16) as *i64
        let rrhs = @malloc(16) as *i64
        if nv3_ps_parse_rational_token(buf, eq_pos + 1, b, rrhs) == 1 {
            let sbox = @malloc(8) as *i64
            sbox[0] = 0
            let rhs_norm = nv3_rational_make(rrhs[0], rrhs[1], sbox, rem_budget)
            if op_pos < 0 {
                if nv3_ps_parse_rational_token(buf, a, eq_pos, r1) == 1 {
                    let lhs_norm = nv3_rational_make(r1[0], r1[1], sbox, rem_budget)
                    let st_r = sbox[0]
                    var verd_r = NV3_VERDICT_CONTRADICTION
                    if lhs_norm.verdict == NV3_VERDICT_BUDGET_EXCEEDED or rhs_norm.verdict == NV3_VERDICT_BUDGET_EXCEEDED {
                        verd_r = NV3_VERDICT_BUDGET_EXCEEDED
                    } else if lhs_norm.verdict == NV3_VERDICT_VERIFIED and rhs_norm.verdict == NV3_VERDICT_VERIFIED and lhs_norm.p == rhs_norm.p and lhs_norm.q == rhs_norm.q {
                        verd_r = NV3_VERDICT_VERIFIED
                    }
                    @free(sbox as *u8) @free(r1 as *u8) @free(r2 as *u8) @free(rrhs as *u8)
                    out_ev[0] = 1 out_ev[1] = verd_r out_ev[2] = st_r out_ev[3] = NV3_KERNEL_BIGINT_RATIONAL
                    return
                }
            } else {
                if nv3_ps_parse_rational_token(buf, a, op_pos, r1) == 1 and nv3_ps_parse_rational_token(buf, op_pos + 1, eq_pos, r2) == 1 {
                    let lhs_ev = nv3_rational_eval(op_code, r1[0], r1[1], r2[0], r2[1], rem_budget)
                    let st_r2 = sbox[0] + lhs_ev.steps
                    var verd_r2 = NV3_VERDICT_CONTRADICTION
                    if lhs_ev.verdict == NV3_VERDICT_BUDGET_EXCEEDED or rhs_norm.verdict == NV3_VERDICT_BUDGET_EXCEEDED {
                        verd_r2 = NV3_VERDICT_BUDGET_EXCEEDED
                    } else if lhs_ev.verdict == NV3_VERDICT_VERIFIED and rhs_norm.verdict == NV3_VERDICT_VERIFIED and lhs_ev.p == rhs_norm.p and lhs_ev.q == rhs_norm.q {
                        verd_r2 = NV3_VERDICT_VERIFIED
                    }
                    @free(sbox as *u8) @free(r1 as *u8) @free(r2 as *u8) @free(rrhs as *u8)
                    out_ev[0] = 1 out_ev[1] = verd_r2 out_ev[2] = st_r2 out_ev[3] = NV3_KERNEL_BIGINT_RATIONAL
                    return
                }
            }
            @free(sbox as *u8)
        }
        @free(r1 as *u8) @free(r2 as *u8) @free(rrhs as *u8)
    }
}

// ---------------- 3) Step-Budgeted K-Candidate Backtracking Proof-Guided Search ----------------
// `out_telemetry` (8 `i64`s):
//   [0] = selected_idx (-1 if abstained)
//   [1] = output_mode (`NOEMA_V3_OUTPUT_WEIGHT_GENERATION` or `NOEMA_V3_OUTPUT_WEIGHT_GENERATION_ABSTAIN`)
//   [2] = pruned_refuted_branches
//   [3] = verified_claims_in_selected
//   [4] = khg_total_verified_nodes
//   [5] = khg_total_refuted_nodes
//   [6] = total_steps_used
//   [7] = budget_exhausted_branches
fn nv3_proof_guided_search_candidates(
    cand_ptrs: *i64,
    cand_lens: *i64,
    cand_nlls: *f64,
    num_cands: i64,
    budget_cfg: *i64,
    out_telemetry: *i64
) -> i64 {
    let total_budget = budget_cfg[0]
    let req_verified = budget_cfg[1]

    let g = nv3_khg_create(64, 64, 16)
    let ev = @malloc(48) as *i64
    let emb = @malloc(16 * 8) as *f64

    var best_idx: i64 = -1
    var best_ver: i64 = -1
    var best_nll: f64 = 1000000000.0
    var pruned_refuted: i64 = 0
    var budget_exhausted: i64 = 0
    var used_steps: i64 = 0

    var k: i64 = 0
    while k < num_cands {
        let cptr = cand_ptrs[k] as *u8
        let clen = cand_lens[k]

        var cand_ver: i64 = 0
        var cand_ref: i64 = 0
        var cand_bud: i64 = 0
        var seg_start: i64 = 0
        var pos: i64 = 0
        while pos <= clen {
            let is_sep = if pos == clen { 1 } else {
                let ch = (@read_u8(@ptr_add(cptr, pos)) as i64) & 255
                if ch == 59 or ch == 10 { 1 } else { 0 }
            }
            if is_sep == 1 {
                if pos > seg_start {
                    let rem = total_budget - used_steps
                    nv3_ps_verify_segment(cptr, seg_start, pos, rem, ev)
                    if ev[0] == 1 {
                        used_steps = used_steps + ev[2]
                        let ta = ev[4]
                        let tb = ev[5]
                        let slen = tb - ta
                        nv3_regime_extract_byte_features(@ptr_add(cptr, ta), slen, emb)
                        let chash = nv3_fnv1a64(@ptr_add(cptr, ta), slen)
                        // Pointer-addressed KHG node: enters as OBSERVED + UNTRUSTED_SOURCE,
                        // promoted/refuted EXCLUSIVELY via `nv3_khg_apply_kernel_verdict`!
                        let nid = nv3_khg_add_node(g, Nv3KhgNodeSpec {
                            state: NV3_KHG_STATE_OBSERVED,
                            prov: NOEMA_V3_PROV_UNTRUSTED_SOURCE,
                            doc_id: k,
                            span_off: ta,
                            span_len: slen,
                            claim_hash: chash,
                            confidence: 0.5
                        }, emb)
                        if nid >= 0 {
                            let rbud = if rem > 0 { rem } else { 1 }
                            let _ap = nv3_khg_apply_kernel_verdict(g, nid, ev[3], ev[1], ev[2], rbud)
                        }
                        if ev[1] == NV3_VERDICT_VERIFIED {
                            cand_ver = cand_ver + 1
                        } else if ev[1] == NV3_VERDICT_BUDGET_EXCEEDED {
                            cand_bud = cand_bud + 1
                        } else {
                            cand_ref = cand_ref + 1
                        }
                    }
                }
                seg_start = pos + 1
            }
            pos = pos + 1
        }

        if cand_ref > 0 {
            pruned_refuted = pruned_refuted + 1
        } else if cand_bud > 0 {
            budget_exhausted = budget_exhausted + 1
        } else {
            if req_verified == 0 or cand_ver > 0 {
                let nll = cand_nlls[k]
                if cand_ver > best_ver or (cand_ver == best_ver and nll < best_nll) {
                    best_idx = k
                    best_ver = cand_ver
                    best_nll = nll
                }
            }
        }
        k = k + 1
    }

    var khg_ver: i64 = 0
    var khg_ref: i64 = 0
    var ni: i64 = 0
    let total_nodes = g.counts[0]
    while ni < total_nodes {
        if g.node_state[ni] == NV3_KHG_STATE_VERIFIED { khg_ver = khg_ver + 1 }
        if g.node_state[ni] == NV3_KHG_STATE_REFUTED { khg_ref = khg_ref + 1 }
        ni = ni + 1
    }

    nv3_khg_free(g)
    @free(ev as *u8)
    @free(emb as *u8)

    out_telemetry[0] = best_idx
    out_telemetry[1] = if best_idx >= 0 { NOEMA_V3_OUTPUT_WEIGHT_GENERATION } else { NOEMA_V3_OUTPUT_WEIGHT_GENERATION_ABSTAIN }
    out_telemetry[2] = pruned_refuted
    out_telemetry[3] = if best_idx >= 0 { best_ver } else { 0 }
    out_telemetry[4] = khg_ver
    out_telemetry[5] = khg_ref
    out_telemetry[6] = used_steps
    out_telemetry[7] = budget_exhausted
    return best_idx
}

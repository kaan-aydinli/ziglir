// SEL — Sparse Eikonal Ledger
// fixed.lir — Q32.32 sabit nokta aritmetiği, tamamen i64 (i128 yok).
//
// Sözleşme:
//   ONE  = 2^32, yani 1.0
//   işlemler taşmada DOYGUNLAŞIR (sarmaz), böylece eğitim sessizce bozulmaz.
//
// Bu dosyanın tasarım kuralı: her fonksiyonun GEÇERLİ GİRİŞ ARALIĞI yorumda
// yazar. Çağıran, aralığın dışına çıkmayacağını garanti eder; çıkmayacağını
// garanti edemiyorsa `_sat` sürümünü kullanır.

const ONE: i64 = 4294967296 // 2^32
const HALF: i64 = 2147483648 // 2^31
// Q32.32'de float'ın "infinity"si: tamsayı kısmı 2^31 - 1
const MAXV: i64 = 9223372032559808512 // (2^31 - 1) << 32
const MINV: i64 = 0 - 9223372032559808512 // -(2^31 - 1) << 32

/// Doygun toplama.
/// Kural: |sonuç| <= 2^62. Taşma işaret değişimiyle yakalanır.
fn sat_add(a: i64, b: i64) -> i64 {
    let s = a + b
    if (a >= 0) == (b >= 0) {
        if (a >= 0) != (s >= 0) {
            if a >= 0 {
                return MAXV
            }
            return MINV
        }
    }
    if s > MAXV {
        return MAXV
    }
    if s < MINV {
        return MINV
    }
    return s
}

fn sat_neg(a: i64) -> i64 {
    if a == MINV {
        return MAXV
    }
    return 0 - a
}

/// Q32.32 çarpım — TEK VE DOĞRU YOL.
///
/// Neden `(a*b)>>32` DEĞİL: iki Q32.32 sayının ham çarpımı 2^64'e kadar
/// çıkabilir ve `i64` taşar. LIR'de taşma sessizce yanlış değer üretir
/// (ölçüldü: 1.5*2.0 -> 0), bu yüzden ham çarpım hiç kullanılmaz.
///
/// Doğru yöntem: çarpmadan ÖNCE iki tarafı da 2^16 sağa kaydır.
///   result = (a >> 16) * (b >> 16)
/// Neden ek shift YOK: Q32.32'de a = A·2^32, b = B·2^32. Çarpım A·B·2^64
/// olmalı, Q32.32 sonucu ise A·B·2^32. (a>>16) = A·2^16 olduğundan
/// (a>>16)·(b>>16) = A·B·2^32 — tam olarak istenen Q32.32 değer.
/// `>>32` eklemek sonucu 2^-32 ile çarpıp sıfıra yuvarlardı (ölçüldü).
///
/// GEÇERLİ ARALIK: |a| < 2^47 ve |b| < 2^47 (Q32.32'de tamsayı kısmı < 2^15,
/// yani ±32768). SEL'in tüm ağırlık/aktivasyonları ±2^31'de doygunlaştığı
/// için bu aralık her zaman sağlanır.
fn mul(a: i64, b: i64) -> i64 {
    // İki tarafı da 16 bit sağa kaydır: 48+48 = 96 bit -> hâlâ fazla.
    // 32 bit kaydırırsak kesir kaybı çok olur. 16 bit kaydırma + işaret
    // korumalı çarpım, 2^31 sınırındaki değerler için 2^62'ye sığar.
    let as16 = a >> 16
    let bs16 = b >> 16
    // |as16| < 2^31 sağlanıyorsa çarpım 2^62'ye sığar.
    if fabs(as16) >= HALF or fabs(bs16) >= HALF {
        return mul_sat(a, b)
    }
    return as16 * bs16
}

/// Doygunlaştıran çarpım: genel büyüklüklerde de doğru sonuç verir.
///
/// Yöntem: sonucun taşıp taşmayacağı önceden kestirilir.
/// Q32.32'de a = A·2^16·2^16 ve b = B·2^16·2^16.
/// (a>>16)·(b>>16) = A·B·2^32 tam olarak Q32.32 sonucudur; taşma yalnızca
/// bu ara çarpım 2^63'ü aştığında olur. |A| < 2^31 ve |B| < 2^31 olduğunda
/// ara çarpım 2^62'yi aşmaz. Daha büyük operandlarda sonuç doygunlaşır.
fn mul_sat(a: i64, b: i64) -> i64 {
    if a == 0 or b == 0 {
        return 0
    }
    let as16 = a >> 16
    let bs16 = b >> 16
    if fabs(as16) >= HALF or fabs(bs16) >= HALF {
        // |a| veya |b| >= 2^47: gerçek sonuç kesinlikle MAXV'yi aşıyor.
        if (a >= 0) == (b >= 0) {
            return MAXV
        }
        return MINV
    }
    return as16 * bs16
}

/// Kesirli bölme a/b, tamamen i64 ve taşmasız.
///
/// Yöntem: `a << 32` yapmak 2^64'ü aşabilir (ölçüldü: div(1.0, 64.0) -> 0).
/// Bunun yerine a/b'nin TAM ve KESİR kısımlarını ayrı ayrı kuruyoruz:
///   whole = a / b          (işaretli tamsayı bölmesi)
///   rem   = a - whole * b   (|rem| < |b|)
///   frac  = (rem << 16) / b << 16   (iki turda, ara değer < 2^62)
///
/// Kural: b == 0 -> işarete göre doygunlaşma (±MAXV).
fn div(a: i64, b: i64) -> i64 {
    if b == 0 {
        if a >= 0 {
            return MAXV
        }
        return MINV
    }
    let whole = a / b
    let rem = a - whole * b
    if rem == 0 {
        return whole * ONE
    }
    // 1. tur: rem'i 2^16 ölçekle (|rem| < 2^47 varsayımıyla taşmaz)
    let r1 = (rem << 16) / b
    // 2. tur: kalanı tekrar ölçekle
    let rem2 = (rem << 16) - r1 * b
    let r2 = (rem2 << 16) / b
    let frac = (r1 << 16) + r2
    return whole * ONE + frac
}

/// i64 -> Q32.32
fn from_int(x: i64) -> i64 {
    return x * ONE
}

/// Q32.32 -> i64, sıfıra doğru kırpar.
fn to_int(x: i64) -> i64 {
    if x >= 0 {
        return x / ONE
    }
    return 0 - ((0 - x) / ONE)
}

fn fabs(x: i64) -> i64 {
    if x < 0 {
        // MINV == -(2^31-1)<<32 olduğundan 0-x taşmaz.
        return 0 - x
    }
    return x
}

fn min_i(a: i64, b: i64) -> i64 {
    if a < b {
        return a
    }
    return b
}

fn max_i(a: i64, b: i64) -> i64 {
    if a > b {
        return a
    }
    return b
}

fn clamp_i(a: i64, lo: i64, hi: i64) -> i64 {
    if a < lo {
        return lo
    }
    if a > hi {
        return hi
    }
    return a
}

/// Tamsayı karekök — ikili basamak (bit-shift) yöntemi.
///
/// Ölçek: sonuç = isqrt(x >> 16) << 24, yani `floor(sqrt(x >> 16)) << 24`.
///
/// Önceki sürüm Newton iterasyonuydu: tur başına bir **tamsayı bölmesi**
/// (`y / g`), tipik olarak ~32 tur. Bu sürüm yalnızca kaydırma, toplama ve
/// çıkarma yapıyor. Aynı taban (floor) sonucu veriyor — 5999 farklı büyüklük
/// için birebir karşılaştırıldı (`ai/tests/11_isqrt.lir`), 0 fark.
///
/// Ölçüldü (bu makine, 2 çekirdek, `-O2`, 9 tur medyanı):
///
///   izole, 400k çağrı   Newton 96 ns/çağrı, bit-shift 32 ns/çağrı = **3.04x**
///
/// ## Uçtan uca etki: ölçülemedi
///
/// `b_train` (3 katman, 5000 adım) üzerinde 15 eşleştirilmiş tur:
/// medyan oranı **0.91x**, yeni sürüm 6/15 turda hızlı, en iyi tur oranı
/// 1.07x. Yani `learn` içindeki diğer işler (kenar okuma/yazma, `mul`,
/// `div`) kazancı örtüyor ve makinenin gürültüsü (~%40 turdan tura
/// oynama) farkı ayırt etmeye izin vermiyor.
///
/// Bu yüzden bu değişiklik **izole kazanç** olarak kaydedildi, uçtan uca
/// hızlanma iddiası olarak değil.
fn sqrt(x: i64) -> i64 {
    if x <= 0 {
        return 0
    }
    let y = x >> 16
    if y <= 0 {
        return 0
    }
    // En yüksek "çift bit" konumunu bul: 4^k <= y olan en büyük k.
    //
    // TAŞMA KORUMASI: `bit << 2` 2^63'ü aşınca negatife döner ve
    // `(bit << 2) <= y` her zaman doğru kalır → SONSUZ DÖNGÜ (ölçüldü:
    // y = 2^62'de kilitlenme, `learn` içinde segfault). Bu yüzden üst sınır
    // `bit < (1 << 62)` ile kapatılıyor.
    // En yüksek "çift bit" konumunu SAYARAK bul.
    //
    // `while (bit << 2) <= y { bit = bit << 2 }` biçimi iki nedenle terk
    // edildi:
    //   1) `bit << 2` 2^63'ü aşınca negatife döner → sonsuz döngü
    //      (ölçüldü: y = 2^62'de kilitlenme).
    //   2) Üst sınırı `and` ile eklemek `-O2` kod üretimini bozuyor:
    //      `learn` ile birlikte derlenince segfault (ölçüldü; `-O0`/`-O1`
    //      doğru sonuç veriyordu). İç içe `if` de aynı şekilde bozuk.
    //
    // Sayaç tabanlı bu biçim ikisini de çözüyor: `bit` hiçbir zaman
    // 2^62'yi aşmaz ve döngü koşulu tek bir karşılaştırma.
    var sh: i64 = 0
    var tmp: i64 = y
    while tmp > 3 {
        tmp = tmp >> 2
        sh = sh + 1
    }
    var bit: i64 = 1
    var z: i64 = 0
    while z < sh {
        bit = bit << 2
        z = z + 1
    }
    // Klasik ikili karekök: her adımda bir biti sonuca eklemeyi dene.
    var res: i64 = 0
    var n: i64 = y
    while bit != 0 {
        if n >= res + bit {
            n = n - (res + bit)
            res = (res >> 1) + bit
        } else {
            res = res >> 1
        }
        bit = bit >> 2
    }
    return res << 24
}

/// |E|^(1/2) — eikonal güncellemesinin ölçek faktörü.
fn energy_scale(e: i64) -> i64 {
    return sqrt(fabs(e))
}

/// Doğrusal interpolasyon: t=0 -> a, t=ONE -> b.
fn lerp(a: i64, b: i64, t: i64) -> i64 {
    let d = b - a
    return a + mul(d, t)
}

/// Doygun mutlak fark (enerji hesabı için).
fn abs_diff(a: i64, b: i64) -> i64 {
    let d = a - b
    if d < 0 {
        return 0 - d
    }
    return d
}

/// ReLU benzeri eşik: negatifi sıfıra kırpar.
fn relu(x: i64) -> i64 {
    if x < 0 {
        return 0
    }
    return x
}

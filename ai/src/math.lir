// SEL — Sparse Eikonal Ledger
// math.lir — tamsayı/Q32.32 matematik araçları.
//
// Bu dosya "matematik yapabilen" bir modelin ihtiyaç duyduğu ilkelleri
// sağlar: gcd, modüler ters, asal kontrolü, matris çarpımı, kesirli
// kuvvet yaklaşımı. Hepsi tamsayı; hiçbiri float'a çıkmıyor.

import "fixed.lir"

/// En büyük ortak bölen (Öklid).
fn gcd(a: i64, b: i64) -> i64 {
    var x = if a < 0 { 0 - a } else { a }
    var y = if b < 0 { 0 - b } else { b }
    while y != 0 {
        let t = x % y
        x = y
        y = t
    }
    return x
}

fn lcm(a: i64, b: i64) -> i64 {
    if a == 0 or b == 0 {
        return 0
    }
    let g = gcd(a, b)
    return (a / g) * b
}

/// Modüler üs: (base^exp) mod m. Taşmayı her adımda mod ile engeller.
fn mod_pow(base: i64, exp: i64, m: i64) -> i64 {
    if m == 1 {
        return 0
    }
    var result: i64 = 1
    var b = base % m
    var e = exp
    while e > 0 {
        if e % 2 == 1 {
            result = (result * b) % m
        }
        b = (b * b) % m
        e = e / 2
    }
    return result
}

/// Modüler ters (genişletilmiş Öklid). m asal değilse de çalışır;
/// a ile m aralarında asal değilse 0 döner.
fn mod_inv(a: i64, m: i64) -> i64 {
    var old_r = a
    var r = m
    var old_s: i64 = 1
    var s: i64 = 0
    while r != 0 {
        let q = old_r / r
        let tr = old_r - q * r
        old_r = r
        r = tr
        let ts = old_s - q * s
        old_s = s
        s = ts
    }
    if old_r != 1 {
        return 0
    }
    var res = old_s % m
    if res < 0 {
        res = res + m
    }
    return res
}

/// Deneme bölmeli asallık testi (küçük sayılar için; O(sqrt(n))).
fn is_prime(n: i64) -> i64 {
    if n < 2 { return 0 }
    if n < 4 { return 1 }
    if n % 2 == 0 { return 0 }
    var d: i64 = 3
    while d * d <= n {
        if n % d == 0 { return 0 }
        d = d + 2
    }
    return 1
}

/// Q32.32 taban ve üs ile kuvvet, tamsayı üs.
fn fpow(base: i64, exp: i64) -> i64 {
    var result = ONE
    var b = base
    var e = exp
    while e > 0 {
        if e % 2 == 1 {
            result = mul_sat(result, b)
        }
        b = mul_sat(b, b)
        e = e / 2
    }
    return result
}

/// Tek adımlı Q32.32 matris çarpımı, n×n (satır-majör, düz bellek).
/// c = a · b.  Tümü Q32.32.
fn matmul(a: *u8, b: *u8, c: *u8, n: i64) {
    var r: i64 = 0
    while r < n {
        var col: i64 = 0
        while col < n {
            var acc: i64 = 0
            var kk: i64 = 0
            while kk < n {
                let av = @read_u64(@ptr_add(a, (r * n + kk) * 8)) as i64
                let bv = @read_u64(@ptr_add(b, (kk * n + col) * 8)) as i64
                acc = sat_add(acc, mul(av, bv))
                kk = kk + 1
            }
            @write_u64(@ptr_add(c, (r * n + col) * 8), acc as u64)
            col = col + 1
        }
        r = r + 1
    }
}

/// Q32.32 mutlak değer toplamı (L1 norm) — enerji hesabında kullanılır.
fn l1_norm(v: *u8, n: i64) -> i64 {
    var s: i64 = 0
    var i: i64 = 0
    while i < n {
        s = sat_add(s, fabs(@read_u64(@ptr_add(v, i * 8)) as i64))
        i = i + 1
    }
    return s
}

/// Q32.32 ortalama — bölme tek bir yerde.
fn mean(v: *u8, n: i64) -> i64 {
    if n <= 0 {
        return 0
    }
    return div(l1_norm(v, n), from_int(n))
}

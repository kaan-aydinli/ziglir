// NOEMA custom local sequence model, entirely implemented in LIR.
// A compact causal-attention encoder with trainable byte-output projection.
// The current trainer updates the output projection; the attention/embedding
// trunk is deterministic initialization and explicitly not full backprop yet.
import "noema_tensor.lir"
const NOEMA_LM_VOCAB: i64 = 256
const NOEMA_LM_MAX_WIDTH: i64 = 128
const NOEMA_LM_MAX_CONTEXT: i64 = 256

struct NoemaLM {
    token_embedding: *f64
    position_embedding: *f64
    wq: *f64
    wk: *f64
    wv: *f64
    wo: *f64
    w1: *f64
    w2: *f64
    lm_head: *f64
    lm_bias: *f64
    width: i64
    context: i64
}

fn noema_lm_init_matrix(p: *f64, count: i64, seed: i64, divisor: f64) {
    var values = p
    var i: i64 = 0
    while i < count {
        let h = ((i * 1103515245 + seed * 12345 + 1013904223) % 2001) - 1000
        values[i] = h as f64 / divisor
        i = i + 1
    }
}
fn noema_lm_new(width: i64, context: i64, seed: i64) -> NoemaLM {
    if width < 4 or width > NOEMA_LM_MAX_WIDTH or context < 2 or context > NOEMA_LM_MAX_CONTEXT { exit(2) }
    let token = @malloc(NOEMA_LM_VOCAB * width * 8) as *f64
    let position = @malloc(context * width * 8) as *f64
    let wq = @malloc(width * width * 8) as *f64
    let wk = @malloc(width * width * 8) as *f64
    let wv = @malloc(width * width * 8) as *f64
    let wo = @malloc(width * width * 8) as *f64
    let w1 = @malloc(width * width * 8) as *f64
    let w2 = @malloc(width * width * 8) as *f64
    let lm = @malloc(width * NOEMA_LM_VOCAB * 8) as *f64
    let bias = @malloc(NOEMA_LM_VOCAB * 8) as *f64
    noema_lm_init_matrix(token, NOEMA_LM_VOCAB * width, seed, 1800.0)
    noema_lm_init_matrix(position, context * width, seed + 1, 4000.0)
    noema_lm_init_matrix(wq, width * width, seed + 2, 1000.0)
    noema_lm_init_matrix(wk, width * width, seed + 3, 1000.0)
    noema_lm_init_matrix(wv, width * width, seed + 4, 1000.0)
    noema_lm_init_matrix(wo, width * width, seed + 5, 1000.0)
    noema_lm_init_matrix(w1, width * width, seed + 6, 1000.0)
    noema_lm_init_matrix(w2, width * width, seed + 7, 1000.0)
    noema_lm_init_matrix(lm, width * NOEMA_LM_VOCAB, seed + 8, 8000.0)
    // The output bias must be initialised too: @malloc returns uninitialised
    // memory, and a NaN/garbage bias makes every logit NaN, which then turns
    // into a trap (silent SIGILL) instead of a diagnosable wrong answer.
    noema_lm_init_matrix(bias, NOEMA_LM_VOCAB, seed + 9, 8000.0)
    return NoemaLM { token_embedding: token, position_embedding: position, wq: wq, wk: wk, wv: wv, wo: wo, w1: w1, w2: w2, lm_head: lm, lm_bias: bias, width: width, context: context }
}
fn noema_lm_free(m: NoemaLM) {
    @free(m.token_embedding as *u8) @free(m.position_embedding as *u8)
    @free(m.wq as *u8) @free(m.wk as *u8) @free(m.wv as *u8) @free(m.wo as *u8)
    @free(m.w1 as *u8) @free(m.w2 as *u8) @free(m.lm_head as *u8) @free(m.lm_bias as *u8)
}
fn noema_lm_forward(m: NoemaLM, tokens: *u8, length: i64, hidden_out: *f64, logits_out: *f64) -> i64 {
    if length <= 0 or length > m.context { return 0 }
    let d = m.width
    var x = noema_tensor_new(length, d)
    var q = noema_tensor_new(length, d)
    var k = noema_tensor_new(length, d)
    var v = noema_tensor_new(length, d)
    var att = noema_tensor_new(length, d)
    var proj = noema_tensor_new(length, d)
    var residual = noema_tensor_new(length, d)
    var pre = noema_tensor_new(length, d)
    var act = noema_tensor_new(length, d)
    var mlp = noema_tensor_new(length, d)
    var hidden = noema_tensor_new(length, d)
    var logits = noema_tensor_new(length, NOEMA_LM_VOCAB)
    var x_data = x.data
    var i: i64 = 0
    while i < length {
        let token = @read_u8(@ptr_add(tokens, i)) as i64
        var j: i64 = 0
        while j < d {
            x_data[i * d + j] = m.token_embedding[token * d + j] + m.position_embedding[i * d + j]
            j = j + 1
        }
        i = i + 1
    }
    let qweights = NoemaTensor { data: m.wq, rows: d, cols: d }
    let kweights = NoemaTensor { data: m.wk, rows: d, cols: d }
    let vweights = NoemaTensor { data: m.wv, rows: d, cols: d }
    let oweights = NoemaTensor { data: m.wo, rows: d, cols: d }
    let fweights = NoemaTensor { data: m.w1, rows: d, cols: d }
    let gweights = NoemaTensor { data: m.w2, rows: d, cols: d }
    if noema_tensor_matmul(q, x, qweights) != 1 or noema_tensor_matmul(k, x, kweights) != 1 or noema_tensor_matmul(v, x, vweights) != 1 { return 0 }
    let workspace = @malloc(length * 8) as *f64
    if noema_causal_attention(q, k, v, att, workspace) != 1 { @free(workspace as *u8) return 0 }
    @free(workspace as *u8)
    if noema_tensor_matmul(proj, att, oweights) != 1 or noema_tensor_add(residual, x, proj) != 1 { return 0 }
    if noema_tensor_matmul(pre, residual, fweights) != 1 { return 0 }
    var pre_data = pre.data
    var act_data = act.data
    var j: i64 = 0
    while j < length * d {
        // Smooth bounded nonlinearity: tanh(x) via exp(-2|x|), stable at tails.
        let z = pre_data[j]
        let e = noema_exp(0.0 - 2.0 * @fabs(z))
        let t = (1.0 - e) / (1.0 + e)
        act_data[j] = if z < 0.0 { 0.0 - t } else { t }
        j = j + 1
    }
    if noema_tensor_matmul(mlp, act, gweights) != 1 or noema_tensor_add(hidden, residual, mlp) != 1 { return 0 }
    let head = NoemaTensor { data: m.lm_head, rows: d, cols: NOEMA_LM_VOCAB }
    if noema_tensor_matmul(logits, hidden, head) != 1 { return 0 }
    var logit_data = logits.data
    i = 0
    while i < length { j = 0 while j < NOEMA_LM_VOCAB { logit_data[i * NOEMA_LM_VOCAB + j] = logit_data[i * NOEMA_LM_VOCAB + j] + m.lm_bias[j] j = j + 1 } i = i + 1 }
    @memcpy(hidden_out as *u8, hidden.data as *u8, length * d * 8)
    @memcpy(logits_out as *u8, logits.data as *u8, length * NOEMA_LM_VOCAB * 8)
    noema_tensor_free(x) noema_tensor_free(q) noema_tensor_free(k) noema_tensor_free(v)
    noema_tensor_free(att) noema_tensor_free(proj) noema_tensor_free(residual) noema_tensor_free(pre)
    noema_tensor_free(act) noema_tensor_free(mlp) noema_tensor_free(hidden) noema_tensor_free(logits)
    return 1
}
fn noema_lm_train_example(m: NoemaLM, tokens: *u8, length: i64, assistant_targets: *u8, learning_rate: f64) -> f64 {
    if length < 2 or length > m.context or learning_rate <= 0.0 or learning_rate > 0.1 { return -1.0 }
    let rows = length - 1
    let hidden = @malloc(rows * m.width * 8) as *f64
    let logits = @malloc(rows * NOEMA_LM_VOCAB * 8) as *f64
    if noema_lm_forward(m, tokens, rows, hidden, logits) != 1 { @free(hidden as *u8) @free(logits as *u8) return -1.0 }
    var hdata = hidden
    var ldata = logits
    var active: i64 = 0
    var loss: f64 = 0.0
    var t: i64 = 0
    while t < rows {
        if (@read_u8(@ptr_add(assistant_targets, t)) as i64) == 1 {
            let target = @read_u8(@ptr_add(tokens, t + 1)) as i64
            loss = loss + noema_cross_entropy(@ptr_add(ldata as *u8, t * NOEMA_LM_VOCAB * 8) as *f64, NOEMA_LM_VOCAB, target)
            active = active + 1
        }
        t = t + 1
    }
    if active == 0 { @free(hidden as *u8) @free(logits as *u8) return -1.0 }
    let prob_tensor = NoemaTensor { data: logits, rows: rows, cols: NOEMA_LM_VOCAB }
    if noema_tensor_softmax_rows(prob_tensor) != 1 { @free(hidden as *u8) @free(logits as *u8) return -1.0 }
    var lm = m.lm_head
    var bias = m.lm_bias
    t = 0
    while t < rows {
        if (@read_u8(@ptr_add(assistant_targets, t)) as i64) == 1 {
            let target = @read_u8(@ptr_add(tokens, t + 1)) as i64
            var token: i64 = 0
            while token < NOEMA_LM_VOCAB {
                let p = ldata[t * NOEMA_LM_VOCAB + token]
                let gradient = p - (if token == target { 1.0 } else { 0.0 })
                var d: i64 = 0
                while d < m.width {
                    let ix = d * NOEMA_LM_VOCAB + token
                    lm[ix] = lm[ix] - learning_rate * gradient * hdata[t * m.width + d] / active as f64
                    d = d + 1
                }
                bias[token] = bias[token] - learning_rate * gradient / active as f64
                token = token + 1
            }
        }
        t = t + 1
    }
    @free(hidden as *u8) @free(logits as *u8)
    return loss / active as f64
}
fn noema_lm_next_byte(m: NoemaLM, tokens: *u8, length: i64) -> i64 {
    if length <= 0 or length > m.context { return -1 }
    let hidden = @malloc(length * m.width * 8) as *f64
    let logits = @malloc(length * NOEMA_LM_VOCAB * 8) as *f64
    if noema_lm_forward(m, tokens, length, hidden, logits) != 1 { @free(hidden as *u8) @free(logits as *u8) return -1 }
    var data = logits
    let base = (length - 1) * NOEMA_LM_VOCAB
    var best = data[base]
    var token: i64 = 0
    var i: i64 = 1
    while i < NOEMA_LM_VOCAB { if data[base + i] > best { best = data[base + i] token = i } i = i + 1 }
    @free(hidden as *u8) @free(logits as *u8)
    return token
}
fn noema_lm_generate(m: NoemaLM, prompt: *u8, prompt_len: i64, output: *u8, capacity: i64) -> i64 {
    if prompt_len <= 0 or prompt_len > m.context or capacity <= 0 { return -1 }
    let tokens = @malloc(m.context) as *u8
    @memcpy(tokens, prompt, prompt_len)
    var length = prompt_len
    var generated: i64 = 0
    var out = output
    while generated < capacity and length < m.context {
        let token = noema_lm_next_byte(m, tokens, length)
        if token < 0 { @free(tokens) return -1 }
        @write_u8(@ptr_add(out, generated), token as u8)
        @write_u8(@ptr_add(tokens, length), token as u8)
        length = length + 1
        generated = generated + 1
    }
    @free(tokens)
    return generated
}

fn noema_lm_checksum_region(hash: i64, ptr: *u8, length: i64) -> i64 {
    var h = hash
    var i: i64 = 0
    while i < length { h = (h * 31 + (@read_u8(@ptr_add(ptr, i)) as i64)) % 2147483647 i = i + 1 }
    return h
}
fn noema_lm_checksum(m: NoemaLM) -> i64 {
    var h: i64 = 216613626
    h = noema_lm_checksum_region(h, m.token_embedding as *u8, NOEMA_LM_VOCAB * m.width * 8)
    h = noema_lm_checksum_region(h, m.position_embedding as *u8, m.context * m.width * 8)
    h = noema_lm_checksum_region(h, m.wq as *u8, m.width * m.width * 8)
    h = noema_lm_checksum_region(h, m.wk as *u8, m.width * m.width * 8)
    h = noema_lm_checksum_region(h, m.wv as *u8, m.width * m.width * 8)
    h = noema_lm_checksum_region(h, m.wo as *u8, m.width * m.width * 8)
    h = noema_lm_checksum_region(h, m.w1 as *u8, m.width * m.width * 8)
    h = noema_lm_checksum_region(h, m.w2 as *u8, m.width * m.width * 8)
    h = noema_lm_checksum_region(h, m.lm_head as *u8, m.width * NOEMA_LM_VOCAB * 8)
    return noema_lm_checksum_region(h, m.lm_bias as *u8, NOEMA_LM_VOCAB * 8)
}
fn noema_lm_write_all(fd: i64, ptr: *u8, length: i64) -> i64 {
    var pos: i64 = 0
    while pos < length { let n = @write(fd, @ptr_add(ptr, pos), length - pos) if n <= 0 { return 0 } pos = pos + n }
    return 1
}
fn noema_lm_read_all(fd: i64, ptr: *u8, length: i64) -> i64 {
    var pos: i64 = 0
    while pos < length { let n = @read(fd, @ptr_add(ptr, pos), length - pos) if n <= 0 { return 0 } pos = pos + n }
    return 1
}
fn noema_lm_save(m: NoemaLM, path: string) -> i64 {
    let fd = @open(path, 577, 420)
    if fd < 0 { return 0 }
    let magic = "NOEMALM01"
    let header = @malloc(32)
    @write_u64(header, 1 as u64) @write_u64(@ptr_add(header, 8), m.width as u64)
    @write_u64(@ptr_add(header, 16), m.context as u64) @write_u64(@ptr_add(header, 24), noema_lm_checksum(m) as u64)
    var ok = noema_lm_write_all(fd, magic.ptr as *u8, 9)
    if ok == 1 { ok = noema_lm_write_all(fd, header, 32) }
    if ok == 1 { ok = noema_lm_write_all(fd, m.token_embedding as *u8, NOEMA_LM_VOCAB * m.width * 8) }
    if ok == 1 { ok = noema_lm_write_all(fd, m.position_embedding as *u8, m.context * m.width * 8) }
    if ok == 1 { ok = noema_lm_write_all(fd, m.wq as *u8, m.width * m.width * 8) }
    if ok == 1 { ok = noema_lm_write_all(fd, m.wk as *u8, m.width * m.width * 8) }
    if ok == 1 { ok = noema_lm_write_all(fd, m.wv as *u8, m.width * m.width * 8) }
    if ok == 1 { ok = noema_lm_write_all(fd, m.wo as *u8, m.width * m.width * 8) }
    if ok == 1 { ok = noema_lm_write_all(fd, m.w1 as *u8, m.width * m.width * 8) }
    if ok == 1 { ok = noema_lm_write_all(fd, m.w2 as *u8, m.width * m.width * 8) }
    if ok == 1 { ok = noema_lm_write_all(fd, m.lm_head as *u8, m.width * NOEMA_LM_VOCAB * 8) }
    if ok == 1 { ok = noema_lm_write_all(fd, m.lm_bias as *u8, NOEMA_LM_VOCAB * 8) }
    @free(header)
    if @close(fd) != 0 { return 0 }
    return ok
}
fn noema_lm_load(m: NoemaLM, path: string) -> i64 {
    let fd = @open(path, 0, 0)
    if fd < 0 { return 0 }
    let magic = @malloc(9)
    let header = @malloc(32)
    let expected = "NOEMALM01"
    var ok = noema_lm_read_all(fd, magic, 9)
    if ok == 1 { ok = noema_lm_read_all(fd, header, 32) }
    var i: i64 = 0
    while i < 9 and ok == 1 { if @read_u8(@ptr_add(magic, i)) != @read_u8(@ptr_add(expected.ptr as *u8, i)) { ok = 0 } i = i + 1 }
    if (@read_u64(header) as i64) != 1 or (@read_u64(@ptr_add(header, 8)) as i64) != m.width or (@read_u64(@ptr_add(header, 16)) as i64) != m.context { ok = 0 }
    let temp = noema_lm_new(m.width, m.context, 0)
    if ok == 1 { ok = noema_lm_read_all(fd, temp.token_embedding as *u8, NOEMA_LM_VOCAB * m.width * 8) }
    if ok == 1 { ok = noema_lm_read_all(fd, temp.position_embedding as *u8, m.context * m.width * 8) }
    if ok == 1 { ok = noema_lm_read_all(fd, temp.wq as *u8, m.width * m.width * 8) }
    if ok == 1 { ok = noema_lm_read_all(fd, temp.wk as *u8, m.width * m.width * 8) }
    if ok == 1 { ok = noema_lm_read_all(fd, temp.wv as *u8, m.width * m.width * 8) }
    if ok == 1 { ok = noema_lm_read_all(fd, temp.wo as *u8, m.width * m.width * 8) }
    if ok == 1 { ok = noema_lm_read_all(fd, temp.w1 as *u8, m.width * m.width * 8) }
    if ok == 1 { ok = noema_lm_read_all(fd, temp.w2 as *u8, m.width * m.width * 8) }
    if ok == 1 { ok = noema_lm_read_all(fd, temp.lm_head as *u8, m.width * NOEMA_LM_VOCAB * 8) }
    if ok == 1 { ok = noema_lm_read_all(fd, temp.lm_bias as *u8, NOEMA_LM_VOCAB * 8) }
    let trailing = @malloc(1)
    if @read(fd, trailing, 1) != 0 { ok = 0 }
    if @close(fd) != 0 { ok = 0 }
    if ok == 1 and noema_lm_checksum(temp) != (@read_u64(@ptr_add(header, 24)) as i64) { ok = 0 }
    if ok == 1 {
        @memcpy(m.token_embedding as *u8, temp.token_embedding as *u8, NOEMA_LM_VOCAB * m.width * 8)
        @memcpy(m.position_embedding as *u8, temp.position_embedding as *u8, m.context * m.width * 8)
        @memcpy(m.wq as *u8, temp.wq as *u8, m.width * m.width * 8)
        @memcpy(m.wk as *u8, temp.wk as *u8, m.width * m.width * 8)
        @memcpy(m.wv as *u8, temp.wv as *u8, m.width * m.width * 8)
        @memcpy(m.wo as *u8, temp.wo as *u8, m.width * m.width * 8)
        @memcpy(m.w1 as *u8, temp.w1 as *u8, m.width * m.width * 8)
        @memcpy(m.w2 as *u8, temp.w2 as *u8, m.width * m.width * 8)
        @memcpy(m.lm_head as *u8, temp.lm_head as *u8, m.width * NOEMA_LM_VOCAB * 8)
        @memcpy(m.lm_bias as *u8, temp.lm_bias as *u8, NOEMA_LM_VOCAB * 8)
    }
    @free(trailing) @free(header) @free(magic) noema_lm_free(temp)
    return ok
}

fn noema_lm_train_chat_pair(m: NoemaLM, user: string, assistant: string, learning_rate: f64) -> f64 {
    if user.len <= 0 or assistant.len <= 0 { return -1.0 }
    let prefix = "User: "
    let middle = "\nAssistant: "
    let suffix = "\n"
    let total = (prefix.len as i64) + (user.len as i64) + (middle.len as i64) + (assistant.len as i64) + (suffix.len as i64)
    if total < 2 or total > m.context { return -1.0 }
    let sequence = @malloc(total)
    let mask = @malloc(total - 1)
    var pos: i64 = 0
    @memcpy(@ptr_add(sequence, pos), prefix.ptr, prefix.len as i64) pos = pos + prefix.len as i64
    @memcpy(@ptr_add(sequence, pos), user.ptr, user.len as i64) pos = pos + user.len as i64
    @memcpy(@ptr_add(sequence, pos), middle.ptr, middle.len as i64) pos = pos + middle.len as i64
    let target_start = pos
    @memcpy(@ptr_add(sequence, pos), assistant.ptr, assistant.len as i64) pos = pos + assistant.len as i64
    let target_end = pos
    @memcpy(@ptr_add(sequence, pos), suffix.ptr, suffix.len as i64) pos = pos + suffix.len as i64
    var i = target_start - 1
    while i < target_end { @write_u8(@ptr_add(mask, i), 1) i = i + 1 }
    let loss = noema_lm_train_example(m, sequence, total, mask, learning_rate)
    @free(sequence) @free(mask)
    return loss
}

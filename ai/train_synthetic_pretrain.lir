// Adapt macro-step budget per .nbin record from curriculum, recent learning
// gate, plateau/early-exit telemetry, and record size; retain all exemplars.
// Input/metadata are generated by ai/noema-training/build_synthetic_pretrain.mjs.
// Record count is read from generated metadata; no fixed training-record cap.
import "src/noema_pretrain.lir"
fn main() -> i64 {
    let meta_fd=@open("/tmp/noema_pretrain_dataset_meta.bin",0,0)
    if meta_fd<0 { println("SYNTHETIC_METADATA_MISSING") return 1 }
    let meta=@malloc(16) as *u8
    if np_read_exact(meta_fd,meta,16)!=16 { @close(meta_fd) @free(meta) println("SYNTHETIC_METADATA_INVALID") return 1 }
    @close(meta_fd)
    let total=@read_u64(meta) as i64
    let record_bytes=@read_u64(@ptr_add(meta,8)) as i64
    @free(meta)
    if total<=0 or record_bytes<=0 { println("SYNTHETIC_METADATA_INVALID") return 1 }
    let input_path="/tmp/noema_pretrain_dataset.nbin"
    let output_path="/tmp/noema_pretrain_dataset.nps"
    let fd=@open(input_path,0,0)
    if fd<0 { println("SYNTHETIC_NBIN_MISSING") return 1 }
    let state=noema_pretrain_create_with_memory(64,8,128,20261124,total)
    let records=noema_pretrain_nbin_train_auto(state,fd,total,record_bytes,4)
    @close(fd)
    if records!=total {
        print("SYNTHETIC_TRAIN_FAILED records=") printInt(records) println("")
        noema_pretrain_destroy(state)
        return 1
    }
    if noema_pretrain_save(state,output_path)!=1 {
        noema_pretrain_destroy(state)
        println("SYNTHETIC_CHECKPOINT_SAVE_FAILED")
        return 1
    }
    print("trained_records=") printInt(records) println("")
    print("training_payload_bytes=") printInt(noema_pretrain_training_bytes(state)) println("")
    print("stored_exemplars=") printInt(noema_pretrain_memory_count(state)) println("")
    print("memory_capacity=") printInt(noema_pretrain_memory_capacity(state)) println("")
    print("do_perturbations=") printInt(noema_pretrain_do_count(state)) println("")
    print("spectral_stage=") printInt(noema_pretrain_stage(state)) println("")
    print("auto_macro_records=") printInt(noema_pretrain_auto_records(state)) println("")
    print("auto_macro_last=") printInt(noema_pretrain_auto_macros_last(state)) println("")
    print("auto_macro_mean=") printFloat(noema_pretrain_auto_macros_mean(state)) println("")
    noema_pretrain_destroy(state)
    return 0
}

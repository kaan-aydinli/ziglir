// NOEMA Stage 6: CAG reuse, memory scope, evidence and deletion guards.
import "../src/noema_memory.lir"

fn main() -> i64 {
    var checks: i64 = 0
    var passed: i64 = 0
    checks = checks + 1
    if cag_fingerprint_matches(1, 1, 1, 1, 1, 1, 1, 1) == MEMORY_ALLOW { passed = passed + 1 }
    checks = checks + 1
    if cag_fingerprint_matches(1, 1, 1, 0, 1, 1, 1, 1) == MEMORY_DENY { passed = passed + 1 }
    checks = checks + 1
    if cag_fingerprint_matches(1, 1, 1, 1, 1, 1, 1, 0) == MEMORY_DENY { passed = passed + 1 }
    checks = checks + 1
    if cag_request_usable(1, 1, 1, 1, 1) == MEMORY_ALLOW { passed = passed + 1 }
    checks = checks + 1
    if cag_request_usable(1, 0, 1, 1, 1) == MEMORY_DENY { passed = passed + 1 }
    checks = checks + 1
    if memory_item_scope_valid(1, 4, 4, 9, 9, 1, 1, 1) == MEMORY_ALLOW { passed = passed + 1 }
    checks = checks + 1
    if memory_item_scope_valid(1, 4, 5, 9, 9, 1, 1, 1) == MEMORY_DENY { passed = passed + 1 }
    checks = checks + 1
    if memory_item_scope_valid(1, 4, 4, 9, 10, 1, 1, 1) == MEMORY_DENY { passed = passed + 1 }
    checks = checks + 1
    if memory_claim_usable(1, 1, 1, 1) == MEMORY_ALLOW { passed = passed + 1 }
    checks = checks + 1
    if memory_claim_usable(1, 0, 1, 1) == MEMORY_DENY { passed = passed + 1 }
    checks = checks + 1
    if memory_deletion_complete(2, 2, 3, 3, 1, 1) == MEMORY_ALLOW { passed = passed + 1 }
    checks = checks + 1
    if memory_deletion_complete(2, 1, 3, 3, 1, 1) == MEMORY_DENY { passed = passed + 1 }
    checks = checks + 1
    if memory_deletion_complete(2, 2, 3, 2, 1, 1) == MEMORY_DENY { passed = passed + 1 }
    checks = checks + 1
    if memory_deletion_complete(2, 2, 3, 3, 1, 0) == MEMORY_DENY { passed = passed + 1 }
    printInt(passed)
    print("/")
    printInt(checks)
    println("")
    return 0
}

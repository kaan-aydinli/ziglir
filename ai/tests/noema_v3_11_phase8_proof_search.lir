// NOEMA v3 Phase 8 Differential Test:
//   - Trainable zero-keyword neural epistemic regime head (finite-diff + 5-regime learning)
//   - Pure-LIR byte-stream claim extraction across Rational, SI, DPLL Logic, and ISO-8601 Temporal
//   - Multi-candidate K-branch proof-guided backtracking search (pruning lower-NLL refuted traps)
//   - Honest WEIGHT_GENERATION_ABSTAIN when all candidates fail or step budget expires

import "../src/noema_v3/noema_v3_proof_search.lir"

fn check_single_seg(txt: string, exp_verdict: i64) -> i64 {
    let ev = @malloc(48) as *i64
    nv3_ps_verify_segment(txt as *u8, 0, @string_len(txt), 500, ev)
    let ok = if ev[0] == 1 and ev[1] == exp_verdict { 1 } else { 0 }
    @free(ev as *u8)
    return ok
}

fn main() -> i64 {
    // 1) Trainable Neural Epistemic Regime Head: finite-diff + 5-class training without keywords
    let w_reg = @malloc(80 * 8) as *f64
    let b_reg = @malloc(5 * 8) as *f64
    let g_pack = @malloc(85 * 8) as *f64
    let probs = @malloc(5 * 8) as *f64
    let x_tmp = @malloc(16 * 8) as *f64
    nv3_regime_head_init(w_reg, b_reg, 42)

    let sample_r = "1/3 + 1/6 = 1/2"
    nv3_regime_extract_byte_features(sample_r as *u8, @string_len(sample_r), x_tmp)
    nv3_zero(g_pack, 85)
    let _l0 = nv3_regime_head_fwd_bwd(x_tmp, w_reg, b_reg, NV3_REGIME_RATIONAL, 1, g_pack, probs)

    let eps = 0.00001
    var max_fd_err: f64 = 0.0
    var pi: i64 = 0
    while pi < 80 {
        let orig = w_reg[pi]
        w_reg[pi] = orig + eps
        let lp = nv3_regime_head_fwd_bwd(x_tmp, w_reg, b_reg, NV3_REGIME_RATIONAL, 0, 0 as *f64, probs)
        w_reg[pi] = orig - eps
        let lm = nv3_regime_head_fwd_bwd(x_tmp, w_reg, b_reg, NV3_REGIME_RATIONAL, 0, 0 as *f64, probs)
        w_reg[pi] = orig
        let num_g = (lp - lm) / (2.0 * eps)
        let err = nv3_abs(g_pack[pi] - num_g)
        if err > max_fd_err { max_fd_err = err }
        pi = pi + 7
    }

    // Train regime head on 5 structural archetypes (zero keyword tables — pure gradient descent)
    let s0 = "Trabzon kiyi iklimi ve dogal cografya uzerine duzyazi metni."
    let s1 = "17/24 + 5/24 = 11/12"
    let s2 = "2 km + 500 m = 2500 m"
    let s3 = "A=>B, B=>C, A |- C"
    let s4 = "2024-02-29 < 2024-03-01"

    var init_loss_sum: f64 = 0.0
    var final_loss_sum: f64 = 0.0
    var ep: i64 = 0
    while ep < 80 {
        nv3_zero(g_pack, 85)
        var lsum: f64 = 0.0
        nv3_regime_extract_byte_features(s0 as *u8, @string_len(s0), x_tmp)
        lsum = lsum + nv3_regime_head_fwd_bwd(x_tmp, w_reg, b_reg, 0, 1, g_pack, probs)
        nv3_regime_extract_byte_features(s1 as *u8, @string_len(s1), x_tmp)
        lsum = lsum + nv3_regime_head_fwd_bwd(x_tmp, w_reg, b_reg, 1, 1, g_pack, probs)
        nv3_regime_extract_byte_features(s2 as *u8, @string_len(s2), x_tmp)
        lsum = lsum + nv3_regime_head_fwd_bwd(x_tmp, w_reg, b_reg, 2, 1, g_pack, probs)
        nv3_regime_extract_byte_features(s3 as *u8, @string_len(s3), x_tmp)
        lsum = lsum + nv3_regime_head_fwd_bwd(x_tmp, w_reg, b_reg, 3, 1, g_pack, probs)
        nv3_regime_extract_byte_features(s4 as *u8, @string_len(s4), x_tmp)
        lsum = lsum + nv3_regime_head_fwd_bwd(x_tmp, w_reg, b_reg, 4, 1, g_pack, probs)

        if ep == 0 { init_loss_sum = lsum }
        final_loss_sum = lsum
        var wi: i64 = 0
        while wi < 80 { w_reg[wi] = w_reg[wi] - 0.8 * g_pack[wi] wi = wi + 1 }
        var bi: i64 = 0
        while bi < 5 { b_reg[bi] = b_reg[bi] - 0.8 * g_pack[80 + bi] bi = bi + 1 }
        ep = ep + 1
    }

    let c0 = nv3_regime_head_predict_text(s0, w_reg, b_reg, probs)
    let c1 = nv3_regime_head_predict_text(s1, w_reg, b_reg, probs)
    let c3 = nv3_regime_head_predict_text(s3, w_reg, b_reg, probs)
    let c4 = nv3_regime_head_predict_text(s4, w_reg, b_reg, probs)
    let reg_ok = if max_fd_err < 0.000001 and final_loss_sum < (init_loss_sum * 0.45) and c0 == 0 and c1 == 1 and c3 == 3 and c4 == 4 { 1 } else { 0 }

    // 2) All 4 Symbolic Claim Extractors + Kernels (Verified vs Refuted)
    var k4_ok: i64 = 1
    if check_single_seg("1/3 + 1/6 = 1/2", NV3_VERDICT_VERIFIED) != 1 { k4_ok = 0 }
    if check_single_seg("1/3 + 1/6 = 2/3", NV3_VERDICT_CONTRADICTION) != 1 { k4_ok = 0 }
    if check_single_seg("2 km + 500 m = 2500 m", NV3_VERDICT_VERIFIED) != 1 { k4_ok = 0 }
    if check_single_seg("5 kg = 5 m", NV3_VERDICT_CONTRADICTION) != 1 { k4_ok = 0 }
    if check_single_seg("A=>B, B=>C, A |- C", NV3_VERDICT_VERIFIED) != 1 { k4_ok = 0 }
    if check_single_seg("A=>B, B |- A", NV3_VERDICT_CONTRADICTION) != 1 { k4_ok = 0 }
    if check_single_seg("2024-02-29 < 2024-03-01", NV3_VERDICT_VERIFIED) != 1 { k4_ok = 0 }
    if check_single_seg("2025-02-29 < 2025-03-01", NV3_VERDICT_CONTRADICTION) != 1 { k4_ok = 0 }

    // 3) K=3 Proof-Guided Backtracking Search: Prunes lower-NLL refuted fluency traps
    let cand0 = "1/3 + 1/6 = 2/3; 2 km = 2000 m"
    let cand1 = "A=>B, B |- A"
    let cand2 = "1/3 + 1/6 = 1/2; 2 km + 500 m = 2500 m; A=>B, B=>C, A |- C"
    let cptrs = @malloc(24) as *i64
    let clens = @malloc(24) as *i64
    let cnlls = @malloc(24) as *f64
    cptrs[0] = cand0 as *u8 as i64 clens[0] = @string_len(cand0) cnlls[0] = 0.05
    cptrs[1] = cand1 as *u8 as i64 clens[1] = @string_len(cand1) cnlls[1] = 0.10
    cptrs[2] = cand2 as *u8 as i64 clens[2] = @string_len(cand2) cnlls[2] = 0.85

    let bcfg = @malloc(16) as *i64
    bcfg[0] = 2000 bcfg[1] = 1
    let tel = @malloc(64) as *i64
    let sel = nv3_proof_guided_search_candidates(cptrs, clens, cnlls, 3, bcfg, tel)
    let bt_ok = if sel == 2 and tel[1] == NOEMA_V3_OUTPUT_WEIGHT_GENERATION and tel[2] == 2 and tel[3] == 3 and tel[4] == 4 and tel[5] == 2 { 1 } else { 0 }

    // 4) All candidates refuted -> Honest WEIGHT_GENERATION_ABSTAIN
    let sel_abs = nv3_proof_guided_search_candidates(cptrs, clens, cnlls, 2, bcfg, tel)
    let abs_ok = if sel_abs == -1 and tel[1] == NOEMA_V3_OUTPUT_WEIGHT_GENERATION_ABSTAIN and tel[2] == 2 { 1 } else { 0 }

    // 5) Step-budget exhaustion guard -> Honest WEIGHT_GENERATION_ABSTAIN
    let cand_heavy = "A=>B, B=>C, C=>D, A |- D"
    cptrs[0] = cand_heavy as *u8 as i64 clens[0] = @string_len(cand_heavy) cnlls[0] = 0.20
    bcfg[0] = 1 bcfg[1] = 1
    let sel_bud = nv3_proof_guided_search_candidates(cptrs, clens, cnlls, 1, bcfg, tel)
    let bud_ok = if sel_bud == -1 and tel[1] == NOEMA_V3_OUTPUT_WEIGHT_GENERATION_ABSTAIN and tel[7] == 1 { 1 } else { 0 }

    @println("P8_REGIME_HEAD_FD_AND_TRAIN=" + @int_to_string(reg_ok))
    @println("P8_FOUR_KERNEL_EXTRACTION=" + @int_to_string(k4_ok))
    @println("P8_BACKTRACK_PRUNES_LOWER_NLL_REFUTED=" + @int_to_string(bt_ok))
    @println("P8_ALL_REFUTED_ABSTAINS=" + @int_to_string(abs_ok))
    @println("P8_BUDGET_GUARD=" + @int_to_string(bud_ok))

    @free(w_reg as *u8) @free(b_reg as *u8) @free(g_pack as *u8)
    @free(probs as *u8) @free(x_tmp as *u8)
    @free(cptrs as *u8) @free(clens as *u8) @free(cnlls as *u8)
    @free(bcfg as *u8) @free(tel as *u8)

    if reg_ok == 1 and k4_ok == 1 and bt_ok == 1 and abs_ok == 1 and bud_ok == 1 {
        @println("ALL_PASS")
        return 0
    }
    return 1
}

// NOEMA Stage 5: capability graph integrity and scoped routing.
import "../src/noema_capability.lir"

fn main() -> i64 {
    var checks: i64 = 0
    var passed: i64 = 0
    let ids = @malloc(3 * 8)
    let nodes = @malloc(3 * 4 * 8)
    let edges = @malloc(9 * 8)
    var i: i64 = 0
    while i < 3 {
        @write_u64(@ptr_add(ids, i * 8), (i + 1) as u64)
        let node_base = i * 4 * 8
        @write_u64(@ptr_add(nodes, node_base), 7 as u64)
        @write_u64(@ptr_add(nodes, node_base + 8), 1 as u64)
        @write_u64(@ptr_add(nodes, node_base + 16), 1 as u64)
        @write_u64(@ptr_add(nodes, node_base + 24), CAP_PROMOTED as u64)
        i = i + 1
    }
    i = 0
    while i < 9 { @write_u64(@ptr_add(edges, i * 8), 0 as u64) i = i + 1 }
    // 0 and 1 are prerequisites of node 2.
    @write_u64(@ptr_add(edges, 2 * 8), 1 as u64)
    @write_u64(@ptr_add(edges, 1 * 3 * 8 + 2 * 8), 1 as u64)
    @write_u64(@ptr_add(nodes, 2 * 4 * 8 + 16), 2 as u64)

    checks = checks + 1
    if capability_graph_valid(3, ids, edges) == 1 { passed = passed + 1 }
    checks = checks + 1
    if capability_route(3, 7, 1, 2, nodes, edges) == 0 { passed = passed + 1 }
    checks = checks + 1
    if capability_route(3, 7, 1, 1, nodes, edges) == 0 { passed = passed + 1 }
    checks = checks + 1
    if capability_route(3, 8, 1, 3, nodes, edges) == CAP_ROUTE_UNSUPPORTED { passed = passed + 1 }
    checks = checks + 1
    if capability_route(3, 7, 2, 3, nodes, edges) == CAP_ROUTE_UNSUPPORTED { passed = passed + 1 }
    checks = checks + 1
    if capability_route(3, 7, 1, 4, nodes, edges) == CAP_GRAPH_INVALID { passed = passed + 1 }

    // If node 0 is degraded, node 2 is blocked by that prerequisite; node 1 wins.
    @write_u64(@ptr_add(nodes, 24), CAP_DEGRADED as u64)
    checks = checks + 1
    if capability_route(3, 7, 1, 3, nodes, edges) == 1 { passed = passed + 1 }
    @write_u64(@ptr_add(nodes, 24), CAP_PROMOTED as u64)

    // Duplicate ID invalidates the registry.
    @write_u64(@ptr_add(ids, 8), 1 as u64)
    checks = checks + 1
    if capability_graph_valid(3, ids, edges) == 0 { passed = passed + 1 }
    @write_u64(@ptr_add(ids, 8), 2 as u64)

    // A cycle invalidates the graph.
    @write_u64(@ptr_add(edges, 6 * 8), 1 as u64)
    checks = checks + 1
    if capability_graph_valid(3, ids, edges) == 0 { passed = passed + 1 }
    @write_u64(@ptr_add(edges, 6 * 8), 0 as u64)

    // Invalid edge and diagonal are rejected.
    @write_u64(edges, 2 as u64)
    checks = checks + 1
    if capability_graph_valid(3, ids, edges) == 0 { passed = passed + 1 }
    @write_u64(edges, 0 as u64)
    @write_u64(edges, 1 as u64)
    checks = checks + 1
    if capability_graph_valid(3, ids, edges) == 0 { passed = passed + 1 }

    printInt(passed)
    print("/")
    printInt(checks)
    println("")
    return 0
}

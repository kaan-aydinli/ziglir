// Woodbury/Randers and pointwise free-energy invariants for the NOEMA-Φ kernel.
import "../src/noema_phi_geometry.lir"
fn near_phi(a: f64, b: f64, eps: f64) -> i64 { return if @fabs(a - b) <= eps { 1 } else { 0 } }
fn main() -> i64 {
    var checks: i64 = 0
    var passed: i64 = 0
    let u = @malloc(6 * 8) as *f64
    let v = @malloc(3 * 8) as *f64
    let inv = @malloc(3 * 8) as *f64
    let scratch = @malloc(32 * 8) as *f64
    u[0] = 1.0 u[1] = 0.0 u[2] = 1.0
    u[3] = 0.0 u[4] = 1.0 u[5] = 1.0
    v[0] = 1.0 v[1] = 2.0 v[2] = -1.0
    checks = checks + 1
    if noema_phi_inverse_apply(0.0, 3, 2, u, v, inv, scratch) == 1 and near_phi(inv[0], 1.125, 1.0e-12) == 1 and near_phi(inv[1], 1.625, 1.0e-12) == 1 and near_phi(inv[2], -1.25, 1.0e-12) == 1 { passed = passed + 1 }

    // Verify the returned vector satisfies the direct dense metric equation.
    checks = checks + 1
    if near_phi(2.0 * inv[0] + inv[2], v[0], 1.0e-12) == 1 and near_phi(2.0 * inv[1] + inv[2], v[1], 1.0e-12) == 1 and near_phi(inv[0] + inv[1] + 3.0 * inv[2], v[2], 1.0e-12) == 1 { passed = passed + 1 }

    let raw_b = @malloc(3 * 8) as *f64
    let b = @malloc(3 * 8) as *f64
    let dual = @malloc(8) as *f64
    raw_b[0] = 10.0 raw_b[1] = -3.0 raw_b[2] = 1.0
    checks = checks + 1
    if noema_phi_project_drift(0.0, 3, 2, u, raw_b, b, dual, scratch) == 1 and dual[0] <= 0.850000000001 { passed = passed + 1 }

    let direction = @malloc(3 * 8) as *f64
    let reverse_b = @malloc(3 * 8) as *f64
    direction[0] = 1.0 direction[1] = 0.0 direction[2] = 0.0
    let forward = noema_phi_randers_norm(0.0, 3, 2, u, raw_b, direction, b, scratch)
    direction[0] = -1.0
    let backward = noema_phi_randers_norm(0.0, 3, 2, u, raw_b, direction, reverse_b, scratch)
    checks = checks + 1
    if forward > backward and backward > 0.0 { passed = passed + 1 }

    checks = checks + 1
    if noema_phi_abstention_gate(0.35, 0.35, 0.55, 0.55, 0.08, 0.08) > 0.749999 and noema_phi_abstention_gate(1.0, 0.0, 0.0, 1.0, 0.08, 0.08) < 0.001 { passed = passed + 1 }

    let state = @malloc(6 * 8) as *f64
    let params = @malloc(11 * 8) as *f64
    let validity = @malloc(3 * 8) as *f64
    let energy = @malloc(7 * 8) as *f64
    state[0] = 1.0 state[1] = 0.0 state[2] = 0.0 state[3] = 0.0 state[4] = 0.0 state[5] = 0.0
    params[0] = 1.0 params[1] = 0.25 params[2] = 1.0 params[3] = 0.4
    params[4] = 2.0 params[5] = 2.0 params[6] = 1.2 params[7] = 10000.0
    params[8] = 0.0 params[9] = 0.75 params[10] = 1.5
    validity[0] = 1.0 validity[1] = 0.0 validity[2] = 1.0
    checks = checks + 1
    if noema_phi_local_energy(state, params, 1, validity, energy) == 1 and near_phi(energy[1], 0.0, 1.0e-12) == 1 and near_phi(energy[2], 0.0, 1.0e-12) == 1 and near_phi(energy[3], 0.0, 1.0e-12) == 1 { passed = passed + 1 }

    state[0] = 1.0 state[1] = 1.0 params[8] = 1.0
    checks = checks + 1
    if noema_phi_local_energy(state, params, 1, validity, energy) == 1 and near_phi(energy[0], 0.6277777777777778, 1.0e-12) == 1 and near_phi(energy[1], 1.0, 1.0e-12) == 1 and near_phi(energy[2], 0.2666666666666667, 1.0e-12) == 1 and near_phi(energy[3], 10000.0, 1.0e-12) == 1 and near_phi(energy[4], 1.125, 1.0e-12) == 1 { passed = passed + 1 }

    // Reject non-unit verification vectors rather than silently misweighting them.
    validity[0] = 2.0
    checks = checks + 1
    if noema_phi_local_energy(state, params, 1, validity, energy) == 0 { passed = passed + 1 }
    let weights = @malloc(5 * 8) as *f64
    let base = @malloc(10 * 8) as *f64
    let deltas = @malloc(50 * 8) as *f64
    let mixed = @malloc(10 * 8) as *f64
    weights[0] = 1.0 weights[1] = 0.0 weights[2] = 0.0 weights[3] = 0.0 weights[4] = 0.0
    base[0] = 0.2
    var mi: i64 = 1
    while mi < 10 { base[mi] = 0.0 mi = mi + 1 }
    mi = 0
    while mi < 50 { deltas[mi] = 0.0 mi = mi + 1 }
    deltas[0] = 0.1
    checks = checks + 1
    if noema_phi_mix_geometry(weights, base, deltas, 3, 2, mixed) == 1 and near_phi(mixed[0], 0.3, 1.0e-12) == 1 { passed = passed + 1 }
    weights[0] = 1.1 weights[1] = -0.1
    checks = checks + 1
    if noema_phi_mix_geometry(weights, base, deltas, 3, 2, mixed) == 0 { passed = passed + 1 }

    checks = checks + 1
    if noema_phi_inverse_apply(2.6, 3, 2, u, v, inv, scratch) == 0 { passed = passed + 1 }

    let field = @malloc(4 * 8) as *f64
    let one_u = @malloc(8) as *f64
    let one_b = @malloc(8) as *f64
    let grad_re = @malloc(8) as *f64
    let grad_im = @malloc(8) as *f64
    let kin_scratch = @malloc(16 * 8) as *f64
    field[0] = 0.0 field[1] = 1.0 field[2] = 1.0 field[3] = 0.0
    one_u[0] = 0.0 one_b[0] = 0.5 grad_re[0] = 0.0 grad_im[0] = 0.5
    let forward_kin = noema_phi_kinetic_density(field, 1, 1, one_u, one_b, grad_re, grad_im, kin_scratch)
    grad_im[0] = -0.5
    let reverse_kin = noema_phi_kinetic_density(field, 1, 1, one_u, one_b, grad_re, grad_im, kin_scratch)
    checks = checks + 1
    if near_phi(forward_kin, 0.0, 1.0e-12) == 1 and near_phi(reverse_kin, 0.5, 1.0e-12) == 1 { passed = passed + 1 }

    checks = checks + 1
    if near_phi(noema_phi_bridge_energy(0.0, 1.0, 1.0, 0.0, 1.5707963267948966, 0.5), 0.0, 1.0e-12) == 1 and noema_phi_bridge_energy(0.0, 1.0, 1.0, 0.0, 0.0, 0.5) > 0.9 { passed = passed + 1 }

    let sigmas = @malloc(2 * 8) as *f64
    let geom_values = @malloc(4 * 8) as *f64
    let yamabe_params = @malloc(4 * 8) as *f64
    sigmas[0] = 1.0
    sigmas[1] = -1.0
    geom_values[0] = 0.5 geom_values[1] = 1.0 geom_values[2] = 1.0 geom_values[3] = 2.0
    yamabe_params[0] = 0.01 yamabe_params[1] = 0.001 yamabe_params[2] = 0.005 yamabe_params[3] = 0.005
    let yamabe_value = noema_phi_yamabe_energy(2, sigmas, yamabe_params, geom_values, 1, 1, yamabe_params)
    checks = checks + 1
    if near_phi(yamabe_value, 0.01668, 1.0e-12) == 1 { passed = passed + 1 }

    let charges = @malloc(2 * 8) as *f64
    let keywords = @malloc(4 * 8) as *f64
    let context = @malloc(6 * 8) as *f64
    charges[0] = 1.0 charges[1] = -1.0
    keywords[0] = 1.0 keywords[1] = 0.0 keywords[2] = -1.0 keywords[3] = 0.0
    context[0] = 1.0 context[1] = 0.0 context[2] = 1.0 context[3] = 1.0 context[4] = 0.000000000001 context[5] = 0.5
    checks = checks + 1
    let global_value = noema_phi_global_energy_terms(charges, 2, 2.0, keywords, 2, 0.8, context)
    if near_phi(global_value, 2.626713204860013, 1.0e-12) == 1 { passed = passed + 1 }

    printInt(passed) print("/") printInt(checks) println("")
    @free(sigmas as *u8) @free(geom_values as *u8) @free(yamabe_params as *u8)
    @free(charges as *u8) @free(keywords as *u8) @free(context as *u8)
    @free(field as *u8) @free(one_u as *u8) @free(one_b as *u8)
    @free(grad_re as *u8) @free(grad_im as *u8) @free(kin_scratch as *u8)
    @free(weights as *u8) @free(base as *u8) @free(deltas as *u8) @free(mixed as *u8)
    @free(u as *u8) @free(v as *u8) @free(inv as *u8) @free(scratch as *u8)
    @free(raw_b as *u8) @free(b as *u8) @free(dual as *u8) @free(direction as *u8)
    @free(reverse_b as *u8) @free(state as *u8) @free(params as *u8)
    @free(validity as *u8) @free(energy as *u8)
    return if passed == checks { 0 } else { 1 }
}

// Architectural replacement for the former Transformer LM test.
// Verifies the raw-byte NOEMA-Phi pretraining path without token/logit APIs.
import "../src/noema_pretrain.lir"
fn main() -> i64 {
    var checks: i64 = 0
    var passed: i64 = 0
    let state = noema_pretrain_create(64,8,16,91)
    let bytes = @malloc(16) as *u8
    var i: i64 = 0
    while i < 16 { @write_u8(@ptr_add(bytes,i),(i*7+19) as u8) i=i+1 }
    checks = checks+1
    if noema_pretrain_documents(state) == 0 { passed=passed+1 }
    checks = checks+1
    if noema_pretrain_active_cavities() == 4 { passed=passed+1 }
    checks = checks+1
    if noema_pretrain_batch_streams() == 8 { passed=passed+1 }
    noema_pretrain_document(state,bytes,16,0,2)
    checks = checks+1
    if noema_pretrain_documents(state) == 1 { passed=passed+1 }
    noema_pretrain_document(state,bytes,16,1,2)
    checks = checks+1
    if noema_pretrain_documents(state) == 2 { passed=passed+1 }
    i = 0
    while i < 6 { noema_pretrain_document(state,bytes,16,1,1) i=i+1 }
    checks = checks+1
    if noema_pretrain_do_count(state) == 1 { passed=passed+1 }
    checks = checks+1
    if noema_pretrain_documents(state) == 8 { passed=passed+1 }
    noema_pretrain_destroy(state)
    @free(bytes)
    printInt(passed) print("/") printInt(checks) println("")
    return if passed == checks { 0 } else { 1 }
}

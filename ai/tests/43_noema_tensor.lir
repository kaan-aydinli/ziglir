// LIR-native bounded numerical foundation for the internal generative model.
import "../src/noema_tensor.lir"
fn near(a: f64, b: f64, eps: f64) -> i64 { return if @fabs(a - b) <= eps { 1 } else { 0 } }
fn main() -> i64 {
    var checks: i64 = 0
    var passed: i64 = 0
    var a = noema_tensor_new(2, 2)
    var b = noema_tensor_new(2, 2)
    var c = noema_tensor_new(2, 2)
    a.data[0] = 1.0 a.data[1] = 2.0 a.data[2] = 3.0 a.data[3] = 4.0
    b.data[0] = 2.0 b.data[1] = 0.0 b.data[2] = 1.0 b.data[3] = 2.0
    checks += 1
    if noema_tensor_matmul(c, a, b) == 1 and c.data[0] == 4.0 and c.data[1] == 4.0 and c.data[2] == 10.0 and c.data[3] == 8.0 { passed += 1 }
    checks += 1
    if near(noema_exp(0.0), 1.0, 1.0e-12) == 1 and near(noema_exp(1.0), 2.718281828459045, 1.0e-11) == 1 { passed += 1 }
    checks += 1
    if near(noema_log(1.0), 0.0, 1.0e-12) == 1 and near(noema_log(2.0), NOEMA_LN2, 1.0e-12) == 1 { passed += 1 }
    var probabilities = noema_tensor_new(1, 3)
    probabilities.data[0] = 1.0 probabilities.data[1] = 2.0 probabilities.data[2] = 3.0
    checks += 1
    if noema_tensor_softmax_rows(probabilities) == 1 and near(probabilities.data[0] + probabilities.data[1] + probabilities.data[2], 1.0, 1.0e-12) == 1 { passed += 1 }
    var q = noema_tensor_new(2, 2)
    var k = noema_tensor_new(2, 2)
    var v = noema_tensor_new(2, 2)
    var out = noema_tensor_new(2, 2)
    q.data[0] = 1.0 q.data[1] = 0.0 q.data[2] = 0.0 q.data[3] = 1.0
    k.data[0] = 1.0 k.data[1] = 0.0 k.data[2] = 0.0 k.data[3] = 1.0
    v.data[0] = 2.0 v.data[1] = 3.0 v.data[2] = 99.0 v.data[3] = 101.0
    let workspace = @malloc(16) as *f64
    checks += 1
    if noema_causal_attention(q, k, v, out, workspace) == 1 and out.data[0] == 2.0 and out.data[1] == 3.0 { passed += 1 }
    let ce = @malloc(16) as *f64
    ce[0] = 0.0 ce[1] = 0.0
    checks += 1
    if near(noema_cross_entropy(ce, 2, 1), NOEMA_LN2, 1.0e-12) == 1 { passed += 1 }
    noema_tensor_free(a) noema_tensor_free(b) noema_tensor_free(c) noema_tensor_free(probabilities)
    noema_tensor_free(q) noema_tensor_free(k) noema_tensor_free(v) noema_tensor_free(out)
    @free(workspace as *u8) @free(ce as *u8)
    printInt(passed) print("/") printInt(checks) println("")
    return if passed == checks { 0 } else { 1 }
}

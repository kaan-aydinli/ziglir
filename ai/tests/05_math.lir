// SEL test 05 — matematik araçları, bilinen değerlerle.
// Beklenen: 6 12 445 4 1 0 120 27
import "../src/math.lir"

fn main() -> i64 {
    printInt(gcd(24, 18))            // 6
    printInt(lcm(3, 4))              // 12
    printInt(mod_pow(2, 10, 1000))   // 24 -> degil: 1024 mod 1000 = 24
    printInt(mod_inv(3, 11))         // 4   (3*4=12=1 mod 11)
    printInt(is_prime(97))           // 1
    printInt(is_prime(91))           // 0   (7*13)
    printInt(to_int(fpow(from_int(2), 3)))  // 8 -> degil 2^3=8
    printInt(to_int(fpow(from_int(3), 3)))  // 27
    println("")
    return 0
}

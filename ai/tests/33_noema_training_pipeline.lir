// NOEMA Stage 19 typed integer-CSV to fit/evaluate LIR pipeline.
import "../src/noema_csv.lir"
import "../src/noema_fit.lir"
fn main() -> i64 {
    var checks: i64 = 0
    var passed: i64 = 0
    let features = @malloc(4 * 8)
    let targets = @malloc(4 * 8)
    let splits = @malloc(4 * 8)
    let history = @malloc(6 * 8)
    let metric = @malloc(8)
    let csv = "0,1,1\n0,2,2\n1,3,3\n2,4,4\n"
    let rows = noema_csv_decode(csv.len as i64, csv.ptr as *u8, 1, 1, 4, features, targets, splits)
    checks = checks + 1
    if rows == 4 { passed = passed + 1 }
    let model = block_new(1, 1, 1, 0)
    checks = checks + 1
    if noema_fit(model, rows, features, targets, splits, ONE / 8, 6, history) == 6 { passed = passed + 1 }
    checks = checks + 1
    if noema_evaluate_split(model, rows, features, targets, splits, FIT_DEV, metric) == 1 { passed = passed + 1 }
    let saved_weight = e_w(model, 0, 0)
    checks = checks + 1
    if noema_evaluate_split(model, rows, features, targets, splits, FIT_TEST, metric) == 1 { passed = passed + 1 }
    checks = checks + 1
    if e_w(model, 0, 0) == saved_weight { passed = passed + 1 }
    checks = checks + 1
    if (@read_u64(@ptr_add(history, 40)) as i64) <= (@read_u64(history) as i64) { passed = passed + 1 }
    printInt(passed)
    print("/")
    printInt(checks)
    println("")
    return 0
}

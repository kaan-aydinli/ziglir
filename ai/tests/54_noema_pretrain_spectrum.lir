// Harmonic-recurrence signature remains equivalent to direct Fourier sums.
import "../src/noema_pretrain.lir"
fn main() -> i64 {
    let bytes=@malloc(13) as *u8
    var i:i64=0
    while i<13 { @write_u8(@ptr_add(bytes,i),(i*19+7) as u8) i=i+1 }
    let out=@malloc(NP_SIG*8) as *f64
    np_signature(bytes,13,out)
    var ok:i64=1
    var k:i64=0
    while k<4 {
        let w=NP_PI2*(k+1) as f64/14.0
        var re:f64=0.0
        var im:f64=0.0
        i=0
        while i<13 {
            let x=(@read_u8(@ptr_add(bytes,i)) as i64) as f64/255.0
            re=re+x*@cos(w*i as f64)
            im=im+x*@sin(w*i as f64)
            i=i+1
        }
        let norm=@sqrt(13.0)
        if @fabs(out[k*2]-re/norm)>0.000000001 { ok=0 }
        if @fabs(out[k*2+1]-im/norm)>0.000000001 { ok=0 }
        k=k+1
    }
    printInt(ok)
    println("")
    @free(bytes) @free(out)
    return 0
}

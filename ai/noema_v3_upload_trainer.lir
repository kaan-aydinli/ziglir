// NOEMA v3 Pure-LIR Generative Corpus Trainer (`ai/noema_v3_upload_trainer.lir`)
// Trains `NPG-v3` continuous `EK-HNB + HAİB` weights + `NV3G1` Kneser-Ney Anti-Verbatim Graph.
// Stdin protocol (5 lines):
//   1: input UTF-8 `.txt` path (`<veriayrimi>` delimited)
//   2: optional bridge scaffold `.txt` path (or `-`)
//   3: output `.npg3` checkpoint path (or `-`)
//   4: output `.nv3g` generative graph path
//   5: optional 24-byte progress file path (or `-`)
//   6: optional SoA shard output directory (or `-`); when set, the `<veriayrimi>` payload is also
//      packed into a `stream.bin/prov.bin/reset.bit/weight.bin/docs.idx` shard with a
//      `shard_meta.json` manifest so the upload is immediately `manifest_guard.py` compliant.

import "src/noema_v3/noema_v3_synth.lir"
import "src/noema_v3/noema_v3_stream_ingest.lir"

// Streaming ingest window for the SoA shard fan-out. Peak runtime memory is
// O(chunk) (measured ~30 MB at 1 MiB, ~22 MB at 256 KiB) and is INDEPENDENT of
// corpus size, so the trainer no longer caps how much data it can ingest. 1 MiB
// balances memory against shard count for the server's 64 MiB upload path while
// streaming arbitrarily large direct-invocation corpora into out_soa/shard_N.
const NV3_UT_STREAM_CHUNK: i64 = 1048576

fn nv3_ut_write_progress(path: string, cur: i64, tot: i64, bytes_done: i64) {
    if @string_len(path) == 0 or @string_eq(path, "-") { return }
    let fd = @open(path, 577, 420)
    if fd < 0 { return }
    let fr = @malloc(24) as *i64
    fr[0] = cur
    fr[1] = if tot > 0 { tot } else { 1 }
    fr[2] = bytes_done
    let _w = @write(fd, fr as *u8, 24)
    @free(fr as *u8)
    @close(fd)
}

fn nv3_ut_read_file_cap(path: string, max_bytes: i64, out_len: *i64) -> *u8 {
    out_len[0] = 0
    if @string_len(path) == 0 or @string_eq(path, "-") { return 0 as *u8 }
    let fd = @open(path, 0, 0)
    if fd < 0 { return 0 as *u8 }
    let buf = @malloc(max_bytes)
    var used: i64 = 0
    while used < max_bytes {
        let chunk = if (max_bytes - used) > 65536 { 65536 } else { max_bytes - used }
        let got = @read(fd, @ptr_add(buf, used), chunk)
        if got <= 0 { break }
        used = used + got
    }
    @close(fd)
    if used <= 0 { @free(buf) return 0 as *u8 }
    out_len[0] = used
    return buf
}

fn nv3_ut_next_line(buf: *u8, pos_box: *i64, total: i64) -> string {
    let start = pos_box[0]
    if start >= total { return "" }
    var p = start
    while p < total and (((@read_u8(@ptr_add(buf, p)) as i64) & 255) != 10) { p = p + 1 }
    var end = p
    if end > start and (((@read_u8(@ptr_add(buf, end - 1)) as i64) & 255) == 13) { end = end - 1 }
    pos_box[0] = if p < total { p + 1 } else { total }
    return nv3_syn_slice_str(buf, start, end - start)
}

// ---- Pure-LIR SHA-256 (FIPS 180-4) ------------------------------------------------------------
// `manifest_guard.py` verifies `sha256` for every SoA file, so the manifest must carry real digests.
// The implementation below is dependency-free and 32-bit-lane based, which keeps every temporary
// inside the i64 register file without relying on unsigned 64-bit wraparound.


fn nv3_sha256(buf: *u8, len: i64, out_be: *u8) {
    // Native SHA-256 builtin (hardware-portable software implementation in the
    // freestanding backend's runtime). Replaces the previous pure-LIR digest
    // loop, which dominated ingest wall-time; produces byte-identical digests.
    @sha256(buf, len, out_be)
}

fn nv3_ut_put(buf: *u8, pos: *i64, s: string) {
    let n = @string_len(s)
    let sp = s.ptr as *u8
    var i: i64 = 0
    while i < n {
        @write_u8(@ptr_add(buf, pos[0] + i), @read_u8(@ptr_add(sp, i)))
        i = i + 1
    }
    pos[0] = pos[0] + n
}

fn nv3_ut_put_int(buf: *u8, pos: *i64, v: i64) {
    nv3_ut_put(buf, pos, @int_to_string(v))
}

fn nv3_ut_put_hex2(buf: *u8, pos: *i64, b: i64) {
    let digits = "0123456789abcdef"
    let dp = digits.ptr as *u8
    @write_u8(@ptr_add(buf, pos[0]), @read_u8(@ptr_add(dp, (b >> 4) & 15)))
    @write_u8(@ptr_add(buf, pos[0] + 1), @read_u8(@ptr_add(dp, b & 15)))
    pos[0] = pos[0] + 2
}

fn nv3_ut_put_hex(buf: *u8, pos: *i64, p: *u8, n: i64) {
    var i: i64 = 0
    while i < n {
        nv3_ut_put_hex2(buf, pos, (@read_u8(@ptr_add(p, i)) as i64) & 255)
        i = i + 1
    }
}

// Writes a `manifest_guard.py`-compatible `shard_meta.json` (`version`, `shard_id`, `files` with
// `byte_length` + `sha256` for every required SoA file), computed in pure LIR.
fn nv3_ut_write_shard_meta(dir: string, num_docs: i64) {
    let n_stream = "stream.bin"
    let n_prov = "prov.bin"
    let n_reset = "reset.bit"
    let n_weight = "weight.bin"
    let n_docs = "docs.idx"
    let nb = @malloc(8) as *i64
    let buf = @malloc(4096)
    let pos = @malloc(8) as *i64
    pos[0] = 0
    nv3_ut_put(buf, pos, "{\n  \"version\": 3,\n  \"shard_id\": \"user_upload\",\n  \"delimiter\": \"<veriayrimi>\",\n  \"num_docs\": ")
    nv3_ut_put_int(buf, pos, num_docs)
    nv3_ut_put(buf, pos, ",\n  \"files\": {")
    var k: i64 = 0
    while k < 5 {
        let name = if k == 0 { n_stream } else if k == 1 { n_prov } else if k == 2 { n_reset } else if k == 3 { n_weight } else { n_docs }
        let path = dir + "/" + name
        // SoA files are bounded by this trainer's own 4 MiB corpus cap:
        // stream.bin/prov.bin <= ~4 MiB, reset.bit <= stream/8,
        // weight.bin = 4 x stream <= 16 MiB, docs.idx is small. A 32 MiB read
        // cap therefore covers every file the trainer can emit. The old
        // 8 MiB cap silently truncated weight.bin for corpora above ~2 MiB
        // and published a wrong byte_length plus a prefix-only sha256 in
        // shard_meta.json (found by the 3.95 MB E2E corpus: declared
        // 8388608 vs actual 15569536).
        let fb = nv3_ut_read_file_cap(path, 33554432, nb)
        if (fb as i64) != 0 {
            if nb[0] >= 33554432 {
                // Fail closed: never publish a digest computed over a prefix.
                // A file at the cap means the bound above was violated; the
                // entry is omitted instead of being wrong.
                println("shard_meta_omitted=" )
                println(name)
                @free(fb)
            } else {
                nv3_ut_put(buf, pos, if k == 0 { "\n    \"" } else { ",\n    \"" })
                nv3_ut_put(buf, pos, name)
                nv3_ut_put(buf, pos, "\": {\"byte_length\": ")
                nv3_ut_put_int(buf, pos, nb[0])
                nv3_ut_put(buf, pos, ", \"sha256\": \"")
                let dig = @malloc(32)
                nv3_sha256(fb, nb[0], dig)
                nv3_ut_put_hex(buf, pos, dig, 32)
                @free(dig)
                nv3_ut_put(buf, pos, "\"}")
                @free(fb)
            }
        }
        k = k + 1
    }
    nv3_ut_put(buf, pos, "\n  }\n}\n")
    let meta_path = dir + "/shard_meta.json"
    let fd = @open(meta_path, 577, 420)
    if fd >= 0 {
        let _w = @write(fd, buf, pos[0])
        @close(fd)
    }
    @free(pos as *u8)
    @free(buf)
    @free(nb as *u8)
}

fn main() -> i64 {
    let in_cfg = @malloc(4096)
    var cn: i64 = 0
    while cn < 4096 {
        let g = @read(0, @ptr_add(in_cfg, cn), 4096 - cn)
        if g <= 0 { break }
        cn = cn + g
    }
    if cn <= 0 {
        @free(in_cfg)
        println("NOEMA_TRAIN_V3") println("ok=0") println("error=empty_trainer_config")
        return 1
    }

    let pbox = @malloc(8) as *i64
    pbox[0] = 0
    let in_txt = nv3_ut_next_line(in_cfg, pbox, cn)
    let bridge_txt = nv3_ut_next_line(in_cfg, pbox, cn)
    let out_npg = nv3_ut_next_line(in_cfg, pbox, cn)
    let out_nv3g = nv3_ut_next_line(in_cfg, pbox, cn)
    let prog_path = nv3_ut_next_line(in_cfg, pbox, cn)
    let out_soa = nv3_ut_next_line(in_cfg, pbox, cn)
    @free(pbox as *u8)

    if @string_len(in_txt) == 0 or @string_len(out_nv3g) == 0 {
        @free(in_cfg)
        println("NOEMA_TRAIN_V3") println("ok=0") println("error=missing_paths")
        return 1
    }

    let len_box = @malloc(16) as *i64
    let main_buf = nv3_ut_read_file_cap(in_txt, 4194304, len_box)
    let main_len = len_box[0]
    if main_len <= 0 or (main_buf as i64) == 0 {
        @free(len_box as *u8) @free(in_cfg)
        println("NOEMA_TRAIN_V3") println("ok=0") println("error=failed_to_read_input_txt")
        return 1
    }

    if nv3_syn_utf8_valid(main_buf, main_len) != 1 {
        @free(main_buf) @free(len_box as *u8) @free(in_cfg)
        println("NOEMA_TRAIN_V3") println("ok=0") println("error=invalid_utf8_corpus")
        return 1
    }

    let total_stages: i64 = 100
    nv3_ut_write_progress(prog_path, 15, total_stages, main_len / 4)

    let br_buf = nv3_ut_read_file_cap(bridge_txt, 262144, @ptr_add(len_box as *u8, 8) as *i64)
    let br_len = len_box[1]
    var comb_len = main_len
    var comb_buf = main_buf
    if br_len > 0 and (br_buf as i64) != 0 {
        let sep = "\n<veriayrimi>\n"
        let sep_len = @string_len(sep)
        comb_len = main_len + sep_len + br_len
        comb_buf = @malloc(comb_len)
        var i: i64 = 0
        while i < main_len { @write_u8(@ptr_add(comb_buf, i), @read_u8(@ptr_add(main_buf, i))) i = i + 1 }
        i = 0
        while i < sep_len { @write_u8(@ptr_add(comb_buf, main_len + i), @read_u8(@ptr_add(sep.ptr as *u8, i))) i = i + 1 }
        i = 0
        while i < br_len { @write_u8(@ptr_add(comb_buf, main_len + sep_len + i), @read_u8(@ptr_add(br_buf, i))) i = i + 1 }
        @free(br_buf)
    }

    let gh = nv3_syn_build_from_utf8(comb_buf, comb_len)
    if comb_buf != main_buf { @free(comb_buf) }
    if gh[0] != 1 {
        nv3_syn_graph_free(gh) @free(main_buf) @free(len_box as *u8) @free(in_cfg)
        println("NOEMA_TRAIN_V3") println("ok=0") println("error=nv3g_graph_build_failed")
        return 1
    }

    nv3_ut_write_progress(prog_path, 55, total_stages, main_len / 2)

    if nv3_syn_save_nv3g(gh, out_nv3g) != 1 {
        nv3_syn_graph_free(gh) @free(main_buf) @free(len_box as *u8) @free(in_cfg)
        println("NOEMA_TRAIN_V3") println("ok=0") println("error=nv3g_save_failed")
        return 1
    }

    // Manifest-guarded SoA shards for the uploaded corpus, written by BOUNDED-MEMORY
    // STREAMING ingest instead of packing the in-RAM sample. The old path packed only
    // main_buf, which nv3_ut_read_file_cap SILENTLY truncated to the first 4 MiB -- so
    // any corpus between 4 MiB and the server's 64 MiB upload cap lost data without an
    // error. nv3_stream_pack_shards reads the ENTIRE file through a fixed NV3_UT_STREAM_CHUNK
    // window (O(chunk) memory, independent of corpus size) and fans out to out_soa/shard_N,
    // the format nv3_mt_train_multishard_npg / nv3_soa_stream_window already consume.
    // The graph/NPG model still trains on the bounded main_buf sample because the model
    // itself is fixed-capacity (NV3_SYN_MAX_ATOMS/TOPICS); only the DATA store scales here.
    var soa_docs: i64 = 0
    if @string_len(out_soa) > 0 and @string_eq(out_soa, "-") == false {
        let _mk = @mkdir(out_soa, 493)
        let shards_box = @malloc(8) as *i64
        let bytes_box = @malloc(8) as *i64
        let streamed = nv3_stream_pack_shards(in_txt, out_soa, NV3_UT_STREAM_CHUNK, NOEMA_V3_PROV_VERIFIED_KHG, shards_box, bytes_box)
        if streamed < 0 {
            // Fail closed: a partial/failed ingest is never reported as success.
            @free(shards_box as *u8) @free(bytes_box as *u8)
            nv3_syn_graph_free(gh) @free(main_buf) @free(len_box as *u8) @free(in_cfg)
            println("NOEMA_TRAIN_V3") println("ok=0") println("error=soa_stream_ingest_failed")
            println("stream_err=" + @int_to_string(0 - streamed))
            return 1
        }
        soa_docs = streamed
        // Per-shard manifest_guard-compatible shard_meta.json (sha256 + byte_length).
        var si: i64 = 0
        while si < shards_box[0] {
            let sdir = out_soa + "/shard_" + @int_to_string(si)
            let nd = nv3_stream_shard_num_docs(sdir)
            if nd > 0 { nv3_ut_write_shard_meta(sdir, nd) }
            si = si + 1
        }
        @free(shards_box as *u8) @free(bytes_box as *u8)
    }
    nv3_ut_write_progress(prog_path, 92, total_stages, main_len)

    var npg_steps: i64 = 0
    if @string_len(out_npg) > 0 and @string_eq(out_npg, "-") == false {
        let tr = nv3_trainer_create(Nv3TrainerCfg {
            d_model: NV3_P6_D_MODEL, d_k: NV3_P6_D_K, d_h: NV3_P6_D_H, conv_k: NV3_P6_CONV_K,
            coarse_ckpt: NV3_P6_COARSE_CKPT, fine_ckpt: NV3_P6_FINE_CKPT, use_fp32_ckpt: 1, seed: 42
        })
        let _warm = nv3_trainer_load_npg(tr, "ai/noema_v3/checkpoints/noema_v3_promoted.npg3")

        let win_len: i64 = 48
        let in_b = @malloc(win_len * 8) as *i64
        let tgt_b = @malloc(win_len * 8) as *i64
        let prov_w = @malloc(win_len * 8) as *i64
        let rst_w = @malloc(win_len * 8) as *i64
        let lw_w = @malloc(win_len * 8) as *f64
        let logits_w = @malloc(win_len * NV3_VOCAB_UTF8 * 8) as *f64

        let target_steps: i64 = 16
        var st: i64 = 0
        while st < target_steps {
            var w_off: i64 = 0
            if main_len > (win_len + 4) { w_off = (st * 97) % (main_len - win_len - 1) }
            let cur_w = if main_len > (w_off + 2) {
                if (main_len - w_off - 1) < win_len { main_len - w_off - 1 } else { win_len }
            } else { 0 }
            if cur_w >= 4 {
                var wi: i64 = 0
                while wi < cur_w {
                    in_b[wi] = (@read_u8(@ptr_add(main_buf, w_off + wi)) as i64) & 255
                    tgt_b[wi] = (@read_u8(@ptr_add(main_buf, w_off + wi + 1)) as i64) & 255
                    prov_w[wi] = NOEMA_V3_PROV_VERIFIED_KHG
                    rst_w[wi] = if wi == 0 { 1 } else { 0 }
                    lw_w[wi] = 1.0
                    wi = wi + 1
                }
                let mcfg = Nv3EkHnbConfig {
                    d_model: tr.d_model, d_k: tr.d_k, d_h: tr.d_h, conv_k: tr.conv_k,
                    coarse_ckpt: tr.coarse_ckpt, fine_ckpt: tr.fine_ckpt, use_fp32_ckpt: tr.use_fp32_ckpt
                }
                let m = Nv3EkHnbModel {
                    cfg: mcfg, total_params: tr.total_params, step_count: tr.step_box[0],
                    params: tr.params, grads: tr.grads, offs: tr.offs
                }
                let batch = Nv3EkHnbBatch {
                    t_len: cur_w, prompt_len: 0,
                    in_bytes: in_b, prov_seq: prov_w, reset_seq: rst_w,
                    tgt_bytes: tgt_b, loss_weights: lw_w, logits_out: logits_w
                }
                let fb = nv3_ek_hnb_fwd_bwd(m, batch, 1)
                if fb.ok == 1 {
                    let _ap = nv3_trainer_apply_grads(tr, 0.015, 2.0)
                    npg_steps = npg_steps + 1
                }
            }
            nv3_ut_write_progress(prog_path, 55 + ((st + 1) * 35) / target_steps, total_stages, main_len)
            st = st + 1
        }
        @free(logits_w as *u8) @free(lw_w as *u8) @free(rst_w as *u8)
        @free(prov_w as *u8) @free(tgt_b as *u8) @free(in_b as *u8)

        if nv3_trainer_save_npg(tr, out_npg, 1) != 1 {
            nv3_trainer_free(tr) nv3_syn_graph_free(gh) @free(main_buf) @free(len_box as *u8) @free(in_cfg)
            println("NOEMA_TRAIN_V3") println("ok=0") println("error=npg_save_failed")
            return 1
        }
        nv3_trainer_free(tr)
    }

    let verify_ckpt = if @string_len(out_npg) > 0 and @string_eq(out_npg, "-") == false {
        out_npg
    } else {
        "ai/noema_v3/checkpoints/noema_v3_promoted.npg3"
    }
    var clean_plen = if main_len < 96 { main_len } else { 96 }
    while clean_plen > 16 {
        let tb = (@read_u8(@ptr_add(main_buf, clean_plen - 1)) as i64) & 255
        if tb < 128 { break }
        clean_plen = clean_plen - 1
    }
    let vres = @malloc(256) as *i64
    let probe_out = @malloc(384)
    let probe_tel = @malloc(64) as *f64
    vres[16] = probe_tel as i64
    vres[17] = 384
    vres[18] = 0
    vres[19] = probe_out as i64
    vres[20] = 0
    vres[21] = main_buf as i64
    vres[22] = clean_plen
    let _vok = nv3_syn_infer_production(verify_ckpt, out_nv3g, vres)
    let av_ok = vres[5]
    let p_emit = vres[2]

    @free(probe_tel as *u8) @free(probe_out) @free(vres as *u8)
    nv3_ut_write_progress(prog_path, total_stages, total_stages, main_len)

    println("NOEMA_TRAIN_V3")
    println("ok=1")
    print("topics=") printInt(gh[5])
    print("atoms=") printInt(gh[1])
    print("bigrams=") printInt(gh[3])
    print("trigrams=") printInt(gh[4])
    print("forbidden_4grams=") printInt(gh[6])
    print("forbidden_sentences=") printInt(gh[7])
    print("npg_steps=") printInt(npg_steps)
    print("anti_verbatim_audit_ok=") printInt(av_ok)
    print("probe_emitted_bytes=") printInt(p_emit)
    print("soa_docs=") printInt(soa_docs)

    nv3_syn_graph_free(gh)
    @free(main_buf) @free(len_box as *u8) @free(in_cfg)
    return if av_ok == 1 { 0 } else { 1 }
}

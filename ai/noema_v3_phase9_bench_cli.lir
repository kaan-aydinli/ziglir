// NOEMA v3 Phase 9:
//   - Subcommand `pack <raw_veriayrimi.txt> <out_soa_dir>`: Pure-LIR `<veriayrimi>` SoA shard packer.
//   - Subcommand `bench [steps]`: Multi-shard data-parallel (`W=2` OS threads) scaled NPG-v3 trainer
//     (`d_model=20, d_k=10, d_h=36` -> `ai/noema_v3/checkpoints/noema_v3_scaled.npg3`), side-by-side
//     locked evaluation vs unscaled single-shard baseline (`d_model=12, d_k=8, d_h=20`), 4-domain
//     proof-guided search benchmark, and hex generation dump for SHA-256 blinded human evaluation.

import "src/noema_v3/noema_v3_scale_mt.lir"
import "src/noema_v3/noema_v3_proof_search.lir"
import "src/noema_v3/noema_v3_selfplay_gate.lir"

fn p9_read_whole_file(path: string, out_len: *i64) -> *u8 {
    out_len[0] = 0
    let fd = @open(path, 0, 0)
    if fd < 0 { return 0 as *u8 }
    var cap: i64 = 65536
    var buf = @malloc(cap)
    var n: i64 = 0
    while 1 == 1 {
        if (cap - n) < 4096 {
            let next_cap = cap * 2
            let next_buf = @malloc(next_cap)
            var i: i64 = 0
            while i < n {
                @write_u8(@ptr_add(next_buf, i), @read_u8(@ptr_add(buf, i)))
                i = i + 1
            }
            @free(buf)
            buf = next_buf
            cap = next_cap
        }
        let got = @read(fd, @ptr_add(buf, n), cap - n)
        if got < 0 {
            @close(fd)
            @free(buf)
            return 0 as *u8
        }
        if got == 0 { break }
        n = n + got
    }
    @close(fd)
    out_len[0] = n
    return buf
}

fn p9_parse_pos_int(s: string, fallback: i64) -> i64 {
    let n = @string_len(s)
    if n <= 0 { return fallback }
    var v: i64 = 0
    var i: i64 = 0
    while i < n {
        let c = @string_char_at(s, i)
        if c < 48 or c > 57 { return fallback }
        v = v * 10 + (c - 48)
        i = i + 1
    }
    return if v > 0 { v } else { fallback }
}

fn p9_print_hex(buf: *u8, len: i64) {
    let digits = "0123456789abcdef"
    let dptr = digits.ptr as *u8
    var i: i64 = 0
    while i < len {
        let b = (@read_u8(@ptr_add(buf, i)) as i64) & 255
        @write(1, @ptr_add(dptr, (b >> 4) & 15), 1)
        @write(1, @ptr_add(dptr, b & 15), 1)
        i = i + 1
    }
}

fn p9_run_pack(src_txt: string, out_dir: string) -> i64 {
    let _mk = @mkdir(out_dir, 493)
    let len_box = @malloc(8) as *i64
    let raw = p9_read_whole_file(src_txt, len_box)
    let raw_len = len_box[0]
    @free(len_box as *u8)
    if (raw as i64) == 0 or raw_len <= 0 {
        if (raw as i64) != 0 { @free(raw) }
        println("PACK_OK=0")
        return 1
    }
    let pay_box = @malloc(8) as *i64
    let docs = nv3_soa_pack_veriayrimi(out_dir, raw, raw_len, NOEMA_V3_PROV_VERIFIED_KHG, pay_box)
    let pay = pay_box[0]
    @free(pay_box as *u8)
    @free(raw)
    if docs <= 0 {
        println("PACK_OK=0")
        return 1
    }
    println("PACK_OK=1")
    print("DOCS=") printInt(docs)
    print("PAYLOAD_BYTES=") printInt(pay)
    return 0
}

// Runs a 12-case neuro-symbolic formal proof-search suite across Rational, SI, DPLL Logic, Temporal,
// lower-NLL trap pruning, and all-refuted abstention. Returns passed count out of 12.
fn p9_eval_proof_suite(out_steps: *i64) -> i64 {
    out_steps[0] = 0
    var passed: i64 = 0
    let ev = @malloc(48) as *i64

    // 8 single-claim formal verification & refutation checks (2 per kernel)
    let c0 = "3/8 + 5/8 = 1"
    nv3_ps_verify_segment(c0 as *u8, 0, @string_len(c0), 500, ev)
    out_steps[0] = out_steps[0] + ev[2]
    if ev[0] == 1 and ev[1] == NV3_VERDICT_VERIFIED { passed = passed + 1 }

    let c1 = "7/12 + 1/12 = 3/4"
    nv3_ps_verify_segment(c1 as *u8, 0, @string_len(c1), 500, ev)
    out_steps[0] = out_steps[0] + ev[2]
    if ev[0] == 1 and ev[1] == NV3_VERDICT_CONTRADICTION { passed = passed + 1 }

    let c2 = "3 km + 250 m = 3250 m"
    nv3_ps_verify_segment(c2 as *u8, 0, @string_len(c2), 500, ev)
    out_steps[0] = out_steps[0] + ev[2]
    if ev[0] == 1 and ev[1] == NV3_VERDICT_VERIFIED { passed = passed + 1 }

    let c3 = "10 kg = 10 s"
    nv3_ps_verify_segment(c3 as *u8, 0, @string_len(c3), 500, ev)
    out_steps[0] = out_steps[0] + ev[2]
    if ev[0] == 1 and ev[1] == NV3_VERDICT_CONTRADICTION { passed = passed + 1 }

    let c4 = "A=>B, B=>C, C=>D, A |- D"
    nv3_ps_verify_segment(c4 as *u8, 0, @string_len(c4), 500, ev)
    out_steps[0] = out_steps[0] + ev[2]
    if ev[0] == 1 and ev[1] == NV3_VERDICT_VERIFIED { passed = passed + 1 }

    let c5 = "A=>B, C=>B, B |- A"
    nv3_ps_verify_segment(c5 as *u8, 0, @string_len(c5), 500, ev)
    out_steps[0] = out_steps[0] + ev[2]
    if ev[0] == 1 and ev[1] == NV3_VERDICT_CONTRADICTION { passed = passed + 1 }

    let c6 = "2026-01-15 < 2026-11-25"
    nv3_ps_verify_segment(c6 as *u8, 0, @string_len(c6), 500, ev)
    out_steps[0] = out_steps[0] + ev[2]
    if ev[0] == 1 and ev[1] == NV3_VERDICT_VERIFIED { passed = passed + 1 }

    let c7 = "2026-02-29 < 2026-03-01"
    nv3_ps_verify_segment(c7 as *u8, 0, @string_len(c7), 500, ev)
    out_steps[0] = out_steps[0] + ev[2]
    if ev[0] == 1 and ev[1] == NV3_VERDICT_CONTRADICTION { passed = passed + 1 }

    @free(ev as *u8)

    // 4 multi-candidate search & abstention checks
    let cptrs = @malloc(24) as *i64
    let clens = @malloc(24) as *i64
    let cnlls = @malloc(24) as *f64
    let bcfg = @malloc(16) as *i64
    let tel = @malloc(64) as *i64
    bcfg[0] = 2000 bcfg[1] = 1

    // Case 9: Prune fluent arithmetic hallucination (NLL 0.02) in favor of verified branch (NLL 0.90)
    let m0 = "14 * 15 = 200; 1 h = 3600 s"
    let m1 = "14 * 15 = 210; 1 h = 3600 s"
    cptrs[0] = m0 as *u8 as i64 clens[0] = @string_len(m0) cnlls[0] = 0.02
    cptrs[1] = m1 as *u8 as i64 clens[1] = @string_len(m1) cnlls[1] = 0.90
    if nv3_proof_guided_search_candidates(cptrs, clens, cnlls, 2, bcfg, tel) == 1 and tel[2] == 1 {
        passed = passed + 1
    }
    out_steps[0] = out_steps[0] + tel[6]

    // Case 10: Prune dimensional + temporal errors across 3 branches
    let d0 = "4 kg = 4 m"
    let d1 = "2026-12-01 < 2026-01-01"
    let d2 = "2 km = 2000 m; 2026-01-01 < 2026-12-01"
    cptrs[0] = d0 as *u8 as i64 clens[0] = @string_len(d0) cnlls[0] = 0.04
    cptrs[1] = d1 as *u8 as i64 clens[1] = @string_len(d1) cnlls[1] = 0.08
    cptrs[2] = d2 as *u8 as i64 clens[2] = @string_len(d2) cnlls[2] = 0.75
    if nv3_proof_guided_search_candidates(cptrs, clens, cnlls, 3, bcfg, tel) == 2 and tel[2] == 2 {
        passed = passed + 1
    }
    out_steps[0] = out_steps[0] + tel[6]

    // Case 11: Honest abstention when all candidates contain refuted claims
    if nv3_proof_guided_search_candidates(cptrs, clens, cnlls, 2, bcfg, tel) == -1 and tel[1] == NOEMA_V3_OUTPUT_WEIGHT_GENERATION_ABSTAIN {
        passed = passed + 1
    }
    out_steps[0] = out_steps[0] + tel[6]

    // Case 12: Step-budget exhaustion abstains deterministically
    bcfg[0] = 1 bcfg[1] = 1
    cptrs[0] = c4 as *u8 as i64 clens[0] = @string_len(c4) cnlls[0] = 0.10
    if nv3_proof_guided_search_candidates(cptrs, clens, cnlls, 1, bcfg, tel) == -1 and tel[1] == NOEMA_V3_OUTPUT_WEIGHT_GENERATION_ABSTAIN {
        passed = passed + 1
    }

    @free(cptrs as *u8) @free(clens as *u8) @free(cnlls as *u8)
    @free(bcfg as *u8) @free(tel as *u8)
    return passed
}

fn main() -> i64 {
    let argc = @argc()
    if argc >= 4 and @string_eq(@argv(1), "pack") {
        return p9_run_pack(@argv(2), @argv(3))
    }

    let steps = if argc >= 3 and @string_eq(@argv(1), "bench") {
        p9_parse_pos_int(@argv(2), 16)
    } else {
        16
    }

    let shard0 = "ai/noema_v3/corpus_v3_multishard/train_shard_0"
    let shard1 = "ai/noema_v3/corpus_v3_multishard/train_shard_1"
    let val_sh = "ai/noema_v3/corpus_v3_multishard/val_soa"
    let test_sh = "ai/noema_v3/corpus_v3_multishard/test_soa"
    let scaled_ckpt = "ai/noema_v3/checkpoints/noema_v3_scaled.npg3"
    let base_tmp_ckpt = "/tmp/nv3_p9_unscaled_base.npg3"

    // 1) Multi-worker determinism check on shard0 (W=1 vs W=2 OS threads)
    let diff_buf = @malloc(32) as *f64
    let det_ok = nv3_mt_verify_worker_determinism(shard0, 12, 8, 20, 2, 20261125, diff_buf)

    // 2) Train unscaled single-shard baseline (d_model=12, d_k=8, d_h=20, W=1, shard0 only)
    let t0_base = @time_ns()
    let b_dims = @malloc(32) as *i64
    b_dims[0] = 12 b_dims[1] = 8 b_dims[2] = 20 b_dims[3] = 20261125
    let b_sched = @malloc(24) as *i64
    b_sched[0] = steps / 2
    if b_sched[0] < 4 { b_sched[0] = 4 }
    b_sched[1] = 1 b_sched[2] = 2
    let b_sum = @malloc(48) as *f64
    let base_ok = nv3_mt_train_multishard_npg(shard0, "", test_sh, base_tmp_ckpt, b_dims, b_sched, 0.014, b_sum)
    let base_ms = ((@time_ns() - t0_base) as f64) / 1000000.0

    // 3) Train scaled multi-shard data-parallel NOEMA v3 (d_model=16, d_k=8, d_h=28, W=2, shard0 + shard1)
    let t0_sc = @time_ns()
    let s_dims = @malloc(32) as *i64
    s_dims[0] = 16 s_dims[1] = 8 s_dims[2] = 28 s_dims[3] = 20261125
    let s_sched = @malloc(24) as *i64
    s_sched[0] = steps s_sched[1] = 2 s_sched[2] = 2
    let s_sum = @malloc(48) as *f64
    let sc_ok = nv3_mt_train_multishard_npg(shard0, shard1, test_sh, scaled_ckpt, s_dims, s_sched, 0.028, s_sum)
    let sc_ms = ((@time_ns() - t0_sc) as f64) / 1000000.0

    if det_ok != 1 or base_ok != 1 or sc_ok != 1 {
        println("NOEMA_V3_PHASE9_REPORT_V1")
        println("ok=0")
        return 1
    }

    // 4) Reload checkpoints fail-closed to measure val_bpb + generate side-by-side blind eval samples
    let tr_base = nv3_trainer_create(Nv3TrainerCfg {
        d_model: 12, d_k: 8, d_h: 20, conv_k: 4, coarse_ckpt: 8, fine_ckpt: 4, use_fp32_ckpt: 1, seed: 1
    })
    let tr_sc = nv3_trainer_create(Nv3TrainerCfg {
        d_model: 16, d_k: 8, d_h: 28, conv_k: 4, coarse_ckpt: 8, fine_ckpt: 4, use_fp32_ckpt: 1, seed: 1
    })
    let lb_ok = nv3_trainer_load_npg(tr_base, base_tmp_ckpt)
    let ls_ok = nv3_trainer_load_npg(tr_sc, scaled_ckpt)
    let bpb_box = @malloc(8) as *f64
    let base_val_ece = nv3_trainer_eval_soa_ece(tr_base, val_sh, 10, bpb_box)
    let base_val_bpb = bpb_box[0]
    let sc_val_ece = nv3_trainer_eval_soa_ece(tr_sc, val_sh, 10, bpb_box)
    let sc_val_bpb = bpb_box[0]
    @free(bpb_box as *u8)

    // 5) 12-case formal proof-search benchmark + compositional suite + Q-vector comparison
    let psteps_box = @malloc(8) as *i64
    let proof_pass = p9_eval_proof_suite(psteps_box)
    let proof_rate = (proof_pass as f64) / 12.0
    let comp_rate = nv3_eval_compositional_suite(4000)

    let q_base = @malloc(56) as *f64
    let q_sc = @malloc(56) as *f64
    let q_th = @malloc(56) as *f64
    let fgate = @malloc(8) as *i64

    q_base[0] = 1.0 q_base[1] = proof_rate q_base[2] = 0.0 q_base[3] = comp_rate
    q_base[4] = b_sum[3] q_base[5] = b_sum[2] q_base[6] = base_ms

    q_sc[0] = 1.0 q_sc[1] = proof_rate q_sc[2] = 0.0 q_sc[3] = comp_rate
    q_sc[4] = s_sum[3] q_sc[5] = s_sum[2] q_sc[6] = sc_ms

    q_th[0] = 1.0 q_th[1] = 1.0 q_th[2] = 0.0 q_th[3] = 1.0
    q_th[4] = 0.35 q_th[5] = 8.00 q_th[6] = 180000.0

    let q_sc_pass = nv3_eval_lexicographic_q(q_sc, q_th, fgate)
    let lex_cmp = nv3_compare_lexicographic_q(q_sc, q_base, 0.000001)

    // Generate 4 blind-eval raw UTF-8 continuations from both checkpoints
    let p0 = "Karadeniz kiyi ikliminde yagis "
    let p1 = "Bilimsel olcum ve kanit denetimi "
    let p2 = "Moduler yazilim mimarisinde veri "
    let p3 = "Mantiksal cikarim ve belirsizlik "
    let gen_b = @malloc(24)
    let gen_s = @malloc(24)
    let gmet = @malloc(24) as *f64
    let provs = @malloc(64 * 8) as *i64
    var pi: i64 = 0
    while pi < 64 { provs[pi] = NOEMA_V3_PROV_USER_INPUT pi = pi + 1 }

    println("NOEMA_V3_PHASE9_REPORT_V1")
    print("ok=") printInt(if lb_ok == 1 and ls_ok == 1 { 1 } else { 0 })
    println("scaled_checkpoint=" + scaled_ckpt)
    print("worker_grad_max_diff=") printFloat(diff_buf[1]) println("")
    print("worker_loss_diff=") printFloat(diff_buf[0]) println("")
    print("base_params=") printInt(b_sum[4] as i64)
    print("scaled_params=") printInt(s_sum[4] as i64)
    print("base_docs_per_step=") printInt(b_sum[5] as i64)
    print("scaled_docs_per_step=") printInt(s_sum[5] as i64)
    print("base_train_bpb_init=") printFloat(b_sum[0]) println("")
    print("base_train_bpb_final=") printFloat(b_sum[1]) println("")
    print("base_val_bpb=") printFloat(base_val_bpb) println("")
    print("base_val_ece=") printFloat(base_val_ece) println("")
    print("base_test_bpb=") printFloat(b_sum[2]) println("")
    print("base_test_ece=") printFloat(b_sum[3]) println("")
    print("base_compute_ms=") printFloat(base_ms) println("")
    print("scaled_train_bpb_init=") printFloat(s_sum[0]) println("")
    print("scaled_train_bpb_final=") printFloat(s_sum[1]) println("")
    print("scaled_val_bpb=") printFloat(sc_val_bpb) println("")
    print("scaled_val_ece=") printFloat(sc_val_ece) println("")
    print("scaled_test_bpb=") printFloat(s_sum[2]) println("")
    print("scaled_test_ece=") printFloat(s_sum[3]) println("")
    print("scaled_compute_ms=") printFloat(sc_ms) println("")
    print("proof_suite_passed=") printInt(proof_pass)
    print("proof_suite_total=") printInt(12)
    print("proof_suite_steps=") printInt(psteps_box[0])
    print("compositional_score=") printFloat(comp_rate) println("")
    print("q_scaled_pass=") printInt(q_sc_pass)
    print("q_lex_scaled_vs_base=") printInt(lex_cmp)

    let nb0 = nv3_trainer_generate_utf8_valid(tr_base, p0 as *u8, provs, @string_len(p0), 24, gen_b, gmet)
    let ns0 = nv3_trainer_generate_utf8_valid(tr_sc, p0 as *u8, provs, @string_len(p0), 24, gen_s, gmet)
    print("sample0_base_hex=") p9_print_hex(gen_b, nb0) println("")
    print("sample0_scaled_hex=") p9_print_hex(gen_s, ns0) println("")

    let nb1 = nv3_trainer_generate_utf8_valid(tr_base, p1 as *u8, provs, @string_len(p1), 24, gen_b, gmet)
    let ns1 = nv3_trainer_generate_utf8_valid(tr_sc, p1 as *u8, provs, @string_len(p1), 24, gen_s, gmet)
    print("sample1_base_hex=") p9_print_hex(gen_b, nb1) println("")
    print("sample1_scaled_hex=") p9_print_hex(gen_s, ns1) println("")

    let nb2 = nv3_trainer_generate_utf8_valid(tr_base, p2 as *u8, provs, @string_len(p2), 24, gen_b, gmet)
    let ns2 = nv3_trainer_generate_utf8_valid(tr_sc, p2 as *u8, provs, @string_len(p2), 24, gen_s, gmet)
    print("sample2_base_hex=") p9_print_hex(gen_b, nb2) println("")
    print("sample2_scaled_hex=") p9_print_hex(gen_s, ns2) println("")

    let nb3 = nv3_trainer_generate_utf8_valid(tr_base, p3 as *u8, provs, @string_len(p3), 24, gen_b, gmet)
    let ns3 = nv3_trainer_generate_utf8_valid(tr_sc, p3 as *u8, provs, @string_len(p3), 24, gen_s, gmet)
    print("sample3_base_hex=") p9_print_hex(gen_b, nb3) println("")
    print("sample3_scaled_hex=") p9_print_hex(gen_s, ns3) println("")

    @free(gen_b) @free(gen_s) @free(gmet as *u8) @free(provs as *u8)
    @free(q_base as *u8) @free(q_sc as *u8) @free(q_th as *u8) @free(fgate as *u8)
    @free(psteps_box as *u8) @free(diff_buf as *u8)
    @free(b_dims as *u8) @free(b_sched as *u8) @free(b_sum as *u8)
    @free(s_dims as *u8) @free(s_sched as *u8) @free(s_sum as *u8)
    nv3_trainer_free(tr_base)
    nv3_trainer_free(tr_sc)
    return 0
}

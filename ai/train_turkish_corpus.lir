// Generate canonical Turkish v2 data, train SEL classifier + conditional byte
// response head on TRAIN only, persist both, and evaluate on held-out rows.
// Run from repository root: ./zig-out/bin/lir run ai/train_turkish_corpus.lir --backend=native
import "src/noema_corpus.lir"
import "src/noema_text.lir"
import "src/noema_fit.lir"
import "src/ledger.lir"
import "src/noema_decoder.lir"
fn print_inline(value: i64) {
    let buf = @malloc(32)
    var n = value
    var len: i64 = 0
    if n == 0 { @write_u8(buf, 48 as u8) len = 1 }
    else {
        if n < 0 { @write_u8(buf, 45 as u8) len = 1 n = 0 - n }
        let start = len
        while n > 0 { @write_u8(@ptr_add(buf, len), (48 + n % 10) as u8) len = len + 1 n = n / 10 }
        var lo = start
        var hi = len - 1
        while lo < hi { let a = @read_u8(@ptr_add(buf, lo)) let b = @read_u8(@ptr_add(buf, hi)) @write_u8(@ptr_add(buf, lo), b) @write_u8(@ptr_add(buf, hi), a) lo = lo + 1 hi = hi - 1 }
    }
    @write(1, buf, len)
}
fn print_matrix(name: string, matrix: *u8) {
    print(name)
    var r: i64 = 0
    while r < 4 { var c: i64 = 0 while c < 4 { print_inline(@read_u64(@ptr_add(matrix, (r * 4 + c) * 8)) as i64) if c < 3 { print(",") } c = c + 1 } println("") r = r + 1 }
}
fn main() -> i64 {
    let per_template: i64 = 2475
    let expected_rows = per_template * 40
    if generate_turkish_corpus(per_template) != expected_rows { println("CORPUS_GENERATION_FAILED") return 1 }
    let fd = @open("ai/noema-training/turkish_synthetic.tsv", 0, 0)
    if fd < 0 { println("TRAINING_TSV_MISSING") return 1 }
    let bytes = @malloc(134217728)
    let nbytes = @read(fd, bytes, 134217728)
    @close(fd)
    if nbytes <= 0 or nbytes >= 134217728 { println("TRAINING_TSV_READ_FAILED") return 1 }
    let dim: i64 = 128
    let features = @malloc(expected_rows * dim * 8)
    let targets = @malloc(expected_rows * 4 * 8)
    let splits = @malloc(expected_rows * 8)
    let metadata = @malloc(expected_rows * 2 * 8)
    let rows = noema_text_decode(nbytes, bytes, expected_rows, dim, features, targets, splits, metadata)
    if rows != expected_rows { println("TRAINING_TSV_SCHEMA_INVALID") return 1 }

    let reply_spans = @malloc(rows * 16)
    var scan_pos: i64 = 0
    var row: i64 = 0
    while row < rows {
        let line_start = scan_pos
        var line_end = line_start
        while line_end < nbytes and (@read_u8(@ptr_add(bytes, line_end)) as i64) != 10 { line_end = line_end + 1 }
        var cursor = line_start
        var field_start = line_start
        var field: i64 = 0
        while cursor <= line_end {
            if cursor == line_end or (@read_u8(@ptr_add(bytes, cursor)) as i64) == 9 {
                if field == 18 { @write_u64(@ptr_add(reply_spans, row * 16), field_start as u64) @write_u64(@ptr_add(reply_spans, row * 16 + 8), cursor as u64) }
                field = field + 1
                field_start = cursor + 1
            }
            cursor = cursor + 1
        }
        if field != 19 { println("TRAINING_ROW_SCHEMA_INVALID") return 1 }
        scan_pos = if line_end < nbytes { line_end + 1 } else { nbytes }
        row = row + 1
    }

    // Train conditional response byte weights strictly on TRAIN records.
    println("TRAINING_PROMPT_CONDITIONED_RESPONSE_WEIGHTS")
    let decoder = @malloc(DECODER_CELLS * 8)
    noema_decoder_zero(decoder)
    var decoder_rows: i64 = 0
    row = 0
    while row < rows {
        if (@read_u64(@ptr_add(splits, row * 8)) as i64) == FIT_TRAIN and row % 20 == 0 {
            var label: i64 = -1
            var c: i64 = 0
            while c < 4 { if (@read_u64(@ptr_add(targets, (row * 4 + c) * 8)) as i64) == 4294967296 { label = c } c = c + 1 }
            let start = @read_u64(@ptr_add(reply_spans, row * 16)) as i64
            let end = @read_u64(@ptr_add(reply_spans, row * 16 + 8)) as i64
            let x = @ptr_add(features, row * dim * 8)
            if label < 0 or end <= start or noema_decoder_train(decoder, label, @ptr_add(bytes, start), end - start, x, dim) != end - start { println("RESPONSE_TRAINING_RECORD_INVALID") return 1 }
            decoder_rows = decoder_rows + 1
        }
        row = row + 1
    }
    if decoder_rows != 3960 or noema_decoder_save(decoder, "ai/noema-training/turkish_decoder.seltok", decoder_rows, 100, 1729) != 1 { println("RESPONSE_WEIGHT_SAVE_FAILED") return 1 }
    println("RESPONSE_WEIGHT_ARTIFACT_SAVED")

    // Fit classifier and persist/reload before any evaluation.
    let history = @malloc(10 * 8)
    let model = block_new(dim, 4, dim, 1729)
    let epochs = noema_fit(model, rows, features, targets, splits, ONE / 64, 10, history)
    if epochs != 10 { println("CLASSIFIER_TRAINING_FAILED") return 1 }
    if sel_checkpoint_save(model, "ai/noema-training/turkish_model.selcp", 79200, epochs, 1729) != 1 { println("CLASSIFIER_WEIGHT_SAVE_FAILED") return 1 }
    @write_u64(model.bias, 0 as u64)
    if sel_checkpoint_load(model, "ai/noema-training/turkish_model.selcp") != 1 { println("CLASSIFIER_WEIGHT_RELOAD_FAILED") return 1 }
    let decoder_runtime = @malloc(DECODER_CELLS * 8)
    if noema_decoder_load(decoder_runtime, "ai/noema-training/turkish_decoder.seltok") != 1 { println("RESPONSE_WEIGHT_RELOAD_FAILED") return 1 }

    let train_matrix = @malloc(128)
    let dev_matrix = @malloc(128)
    let test_matrix = @malloc(128)
    let train_n = noema_confusion_split(model, rows, features, targets, splits, FIT_TRAIN, train_matrix)
    let dev_n = noema_confusion_split(model, rows, features, targets, splits, FIT_DEV, dev_matrix)
    let test_n = noema_confusion_split(model, rows, features, targets, splits, FIT_TEST, test_matrix)
    let prediction_fd = @open("ai/noema-training/turkish_test_predictions.tsv", 577, 420)
    let decoder_fd = @open("ai/noema-training/turkish_decoder_predictions.tsv", 577, 420)
    if prediction_fd < 0 or decoder_fd < 0 { println("EVALUATION_OUTPUT_OPEN_FAILED") return 1 }
    corpus_write(prediction_fd, "row_index\tactual_class\tpredicted_class\n")
    corpus_write(decoder_fd, "row_index\tactual_class\tpredicted_class\tgenerated_text\n")
    let sample_counts = @malloc(32)
    var c: i64 = 0
    while c < 4 { @write_u64(@ptr_add(sample_counts, c * 8), 0 as u64) c = c + 1 }
    let generated = @malloc(DECODER_MAX_OUTPUT)
    var prediction_rows: i64 = 0
    var decoder_rows_test: i64 = 0
    row = 0
    while row < rows {
        if (@read_u64(@ptr_add(splits, row * 8)) as i64) == FIT_TEST {
            let x = @ptr_add(features, row * dim * 8)
            let target = @ptr_add(targets, row * 4 * 8)
            forward(model, x)
            var actual: i64 = 0
            var predicted: i64 = 0
            var best_a = 0 - 9223372036854775807
            var best_p = 0 - 9223372036854775807
            c = 0
            while c < 4 {
                let a = @read_u64(@ptr_add(target, c * 8)) as i64
                let p = @read_u64(@ptr_add(model.out, c * 8)) as i64
                if a > best_a { best_a = a actual = c }
                if p > best_p { best_p = p predicted = c }
                c = c + 1
            }
            corpus_write_i64(prediction_fd, row) corpus_write(prediction_fd, "\t") corpus_write_i64(prediction_fd, actual) corpus_write(prediction_fd, "\t") corpus_write_i64(prediction_fd, predicted) corpus_write(prediction_fd, "\n")
            prediction_rows = prediction_rows + 1
            let used = @read_u64(@ptr_add(sample_counts, actual * 8)) as i64
            if used < 10 {
                let generated_len = noema_decoder_generate(decoder_runtime, predicted, x, dim, generated, DECODER_MAX_OUTPUT)
                if generated_len <= 0 { @close(prediction_fd) @close(decoder_fd) println("HELDOUT_DECODER_EMPTY") return 1 }
                corpus_write_i64(decoder_fd, row) corpus_write(decoder_fd, "\t") corpus_write_i64(decoder_fd, actual) corpus_write(decoder_fd, "\t") corpus_write_i64(decoder_fd, predicted) corpus_write(decoder_fd, "\t")
                var outpos: i64 = 0
                while outpos < generated_len { let written = @write(decoder_fd, @ptr_add(generated, outpos), generated_len - outpos) if written <= 0 { @close(decoder_fd) println("HELDOUT_DECODER_WRITE_FAILED") return 1 } outpos = outpos + written }
                corpus_write(decoder_fd, "\n")
                @write_u64(@ptr_add(sample_counts, actual * 8), (used + 1) as u64)
                decoder_rows_test = decoder_rows_test + 1
            }
        }
        row = row + 1
    }
    if @close(prediction_fd) != 0 or @close(decoder_fd) != 0 or prediction_rows != test_n or decoder_rows_test != 40 { println("HELDOUT_EXPORT_INCOMPLETE") return 1 }

    let metric = @malloc(8)
    noema_evaluate_split(model, rows, features, targets, splits, FIT_DEV, metric)
    let dev_loss = @read_u64(metric) as i64
    noema_evaluate_split(model, rows, features, targets, splits, FIT_TEST, metric)
    let test_loss = @read_u64(metric) as i64
    let train_correct = (@read_u64(train_matrix) as i64) + (@read_u64(@ptr_add(train_matrix, 40)) as i64) + (@read_u64(@ptr_add(train_matrix, 80)) as i64) + (@read_u64(@ptr_add(train_matrix, 120)) as i64)
    let dev_correct = (@read_u64(dev_matrix) as i64) + (@read_u64(@ptr_add(dev_matrix, 40)) as i64) + (@read_u64(@ptr_add(dev_matrix, 80)) as i64) + (@read_u64(@ptr_add(dev_matrix, 120)) as i64)
    let test_correct = (@read_u64(test_matrix) as i64) + (@read_u64(@ptr_add(test_matrix, 40)) as i64) + (@read_u64(@ptr_add(test_matrix, 80)) as i64) + (@read_u64(@ptr_add(test_matrix, 120)) as i64)
    println("LIR classifier + prompt-conditioned response-byte weights; synthetic-only evaluation")
    print("rows train/dev/test: ") print_inline(train_n) print("/") print_inline(dev_n) print("/") print_inline(test_n) println("")
    print("decoder train rows: ") print_inline(decoder_rows) print("; heldout generated outputs: ") print_inline(decoder_rows_test) println("")
    print("accuracy train/dev/test: ") print_inline(train_correct) print("/") print_inline(train_n) print("; ") print_inline(dev_correct) print("/") print_inline(dev_n) print("; ") print_inline(test_correct) print("/") print_inline(test_n) println("")
    print("dev/test MSE Q32.32 raw: ") print_inline(dev_loss) print("/") print_inline(test_loss) println("")
    print_matrix("test confusion matrix:\n", test_matrix)
    println("Synthetic template benchmark only; not a general language-quality claim.")
    return 0
}

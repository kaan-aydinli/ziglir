// Read a plain-text corpus and split topics only on standalone '---' lines.
// Every topic is passed unchanged as raw UTF-8 to a distinct pretraining record.
// Run from repository root: ./zig-out/bin/lir run ai/train_turkish_corpus.lir --backend=native
import "src/noema_pretrain.lir"
const PRETRAIN_SOURCE_CAP: i64 = 2097152
const PRETRAIN_TOPIC_CAP: i64 = 16384
fn main() -> i64 {
    let source_path = "ai/noema-training/pretrain_corpus_large.tr.txt"
    let source_fd = @open(source_path,0,0)
    if source_fd < 0 { println("PLAIN_TEXT_CORPUS_MISSING") return 1 }
    let source = @malloc(PRETRAIN_SOURCE_CAP) as *u8
    let source_len = @read(source_fd,source,PRETRAIN_SOURCE_CAP)
    @close(source_fd)
    if source_len <= 0 or source_len >= PRETRAIN_SOURCE_CAP {
        @free(source)
        println("PLAIN_TEXT_CORPUS_SIZE_INVALID")
        return 1
    }
    let nbin_path = "/tmp/noema_phi_turkish_pretrain_v3.nbin"
    let out = @open(nbin_path,577,420)
    if out < 0 { @free(source) println("NBIN_OUTPUT_OPEN_FAILED") return 1 }
    let payload_bytes = @malloc(8) as *i64
    let topics = noema_pretrain_pack_topics(out,source,source_len,payload_bytes)
    @close(out)
    @free(source)
    if topics <= 0 { println("NO_PLAIN_TEXT_TOPICS_FOUND") return 1 }
    let fd = @open(nbin_path,0,0)
    if fd < 0 { println("NBIN_INPUT_OPEN_FAILED") return 1 }
    let state = noema_pretrain_create_with_memory(64,8,128,20261124,topics)
    let records = noema_pretrain_nbin_train_auto(state,fd,topics,PRETRAIN_TOPIC_CAP,4)
    @close(fd)
    if records != topics {
        noema_pretrain_destroy(state)
        println("NBIN_TRAIN_FAILED")
        return 1
    }
    if noema_pretrain_save(state,"/tmp/noema-pretrain-large.nps") != 1 {
        noema_pretrain_destroy(state)
        @free(payload_bytes as *u8)
        println("MODEL_STATE_SAVE_FAILED")
        return 1
    }
    print("plain-text topics: ") printInt(topics)
    print(" pretraining records: ") printInt(records)
    print(" raw payload bytes: ") printInt(payload_bytes[0])
    print(" state-accounted train bytes: ") printInt(noema_pretrain_training_bytes(state))
    print(" source bytes incl. separators: ") printInt(source_len)
    print(" spectral curriculum stage: ") printInt(noema_pretrain_stage(state))
    print(" do-perturbations: ") printInt(noema_pretrain_do_count(state))
    print(" adaptive macro mean: ") printFloat(noema_pretrain_auto_macros_mean(state))
    print(" learned text exemplars: ") printInt(noema_pretrain_memory_count(state)) println("")
    noema_pretrain_destroy(state)
    @free(payload_bytes as *u8)
    return 0
}

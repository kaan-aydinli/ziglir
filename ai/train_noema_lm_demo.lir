// NOEMA-Phi v3 raw-byte pretraining smoke demo. Kept at the historical
// filename for compatibility; this entrypoint does not import the LM/Transformer.
import "src/noema_pretrain.lir"
fn main() -> i64 {
    let state = noema_pretrain_create(64, 8, 32, 20261124)
    let docs = ["Merhaba dünya. NOEMA ham bayt akışlarını işler.", "Trabzon Karadeniz kıyısındadır.", "Aynı dizide kısmi reset ve kalıcı bağlam kullanılır."]
    var epoch: i64 = 0
    while epoch < 24 {
        var j: i64 = 0
        while j < 3 {
            let text = docs[j]
            let ptr = text as *u8
            let reset = if j == 0 { 0 } else { 1 }
            noema_pretrain_document(state,ptr,text.len as i64,reset,2)
            j = j + 1
        }
        epoch = epoch + 1
    }
    print("documents: ") printInt(noema_pretrain_documents(state))
    print(" stage: ") printInt(noema_pretrain_stage(state))
    print(" do-perturbations: ") printInt(noema_pretrain_do_count(state))
    print(" mean surprise gate: ") printFloat(noema_pretrain_gate_mean(state)) println("")
    println("NOEMA-Phi zero-parse pretraining demo; toy byte corpus only")
    noema_pretrain_destroy(state)
    return 0
}

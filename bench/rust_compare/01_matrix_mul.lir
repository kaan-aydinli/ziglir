// 60x60 integer matrix multiply, accumulated three times.
//
// LIR has raw pointers instead of arrays, so the two matrices and the result
// live in one malloc'd block and are addressed with @ptr_add. The loop nest is
// written in the order a cache-conscious implementation wants (i, k, j) so the
// comparison with Rust measures arithmetic, not memory layout.
import "common.lir"

fn at(base: *u8, row: i64, col: i64, n: i64) -> i64 {
    return @read_u64(@ptr_add(base, (row * n + col) * 8)) as i64
}

fn put(base: *u8, row: i64, col: i64, n: i64, v: i64) -> void {
    @write_u64(@ptr_add(base, (row * n + col) * 8), v)
}

fn main() -> i64 {
    const n: i64 = 60
    const cells: i64 = n * n
    let a = @malloc(cells * 8)
    let b = @malloc(cells * 8)
    let c = @malloc(cells * 8)

    var i: i64 = 0
    while i < n {
        var j: i64 = 0
        while j < n {
            let ia = (i * 37 + j * 11) % 97
            let ib = (i * 13 + j * 29) % 89
            put(a, i, j, n, ia)
            put(b, i, j, n, ib)
            put(c, i, j, n, 0)
            j = j + 1
        }
        i = i + 1
    }

    var rep: i64 = 0
    while rep < 3 {
        var r: i64 = 0
        while r < n {
            var k: i64 = 0
            while k < n {
                let av = at(a, r, k, n)
                var col: i64 = 0
                while col < n {
                    let bv = at(b, k, col, n)
                    let cv = at(c, r, col, n)
                    put(c, r, col, n, (cv + av * bv) % 1000003)
                    col = col + 1
                }
                k = k + 1
            }
            r = r + 1
        }
        rep = rep + 1
    }

    var sum: i64 = 0
    var p: i64 = 0
    while p < cells {
        sum = (sum + (at(c, p / n, p % n, n))) % 1000003
        p = p + 1
    }
    printInt(sum)
    println("")
    @free(a)
    @free(b)
    @free(c)
    return 0
}

// Total stopping time of every starting value below 1,000,000, summed.
//
// The inner loop is data dependent and unpredictable - each step is either
// n/2 or 3n+1 - so it stresses branch handling and the divide-by-two fast
// path. Steps are capped so a pathological value cannot spin forever.
import "common.lir"

fn steps(n0: i64) -> i64 {
    var n = n0
    var c: i64 = 0
    while n != 1 and c < 10000 {
        if n % 2 == 0 {
            n = n / 2
        } else {
            n = 3 * n + 1
        }
        c = c + 1
    }
    return c
}

fn main() -> i64 {
    const limit: i64 = 1000000
    var total: i64 = 0
    var best: i64 = 0
    var best_n: i64 = 0
    var i: i64 = 1
    while i < limit {
        let s = steps(i)
        total = total + s
        if s > best {
            best = s
            best_n = i
        }
        i = i + 1
    }
    printInt(total)
    printInt(best_n)
    printInt(best)
    println("")
    return 0
}
